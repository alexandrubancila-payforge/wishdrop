---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import GoogleButton from "@/components/auth/GoogleButton.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import auth from "@/i18n/auth";
import api from "@/i18n/api";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, auth, api);

// ?next=/path (without language prefix): where to go after signing up, e.g. a Secret Santa invite.
const rawNext = Astro.url.searchParams.get("next") ?? "";
const next = rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : "";
if (user) return Astro.redirect(localePath(lang, next || "/dashboard"));

const M = {
  invalidEmail: t("invalidEmail"),
  passwordShort: t("passwordShort"),
  failed: t("register.failed"),
  err: t("auth.error"),
};
---

<Layout title={t("register.title")} description={t("auth.description")} noindex mainClass="mx-auto flex max-w-md flex-col px-4 py-10 sm:py-16">
  <div class="card rise-in p-6 sm:p-8">
    <span class="grid h-12 w-12 place-items-center rounded-2xl bg-accent-100 text-accent-600" aria-hidden="true">
      <Icon name="gift" class="h-6 w-6" />
    </span>
    <h1 class="mt-5 text-3xl font-extrabold tracking-tight">{t("register.heading")}</h1>
    <p class="mt-2 text-sm text-ink-soft">
      {t("register.haveAccount")}{" "}
      <a href={localePath(lang, "/login")} class="font-semibold text-accent-700 hover:underline">{t("register.login")}</a>
    </p>
    <GoogleButton href={next ? `/api/auth/google?next=${encodeURIComponent(next)}` : "/api/auth/google"} label={t("auth.continueGoogle")} divider={t("auth.orEmail")} />
    <form id="auth-form" class="space-y-4" data-verify-url={localePath(lang, next || "/verify-email")}>
      <div>
        <label for="email" class="block text-sm font-semibold text-ink">{t("auth.email")}</label>
        <input id="email" name="email" type="email" placeholder={t("ph.email")} autocomplete="email" required class="field mt-1.5" />
      </div>
      <div>
        <label for="password" class="block text-sm font-semibold text-ink">
          {t("auth.password")} <span class="font-normal text-ink-soft">{t("auth.minChars")}</span>
        </label>
        <input id="password" name="password" type="password" placeholder={t("ph.newPassword")} autocomplete="new-password" minlength="8" required class="field mt-1.5" />
      </div>
      <p id="auth-error" class="hidden text-sm font-medium text-rose-600"></p>
      <button type="submit" id="auth-submit" class="btn btn-primary w-full py-3.5">
        <span data-submit-label>{t("register.submit")}</span>
      </button>
    </form>
  </div>
</Layout>

<script is:inline define:vars={{ M }}>
  const form = document.getElementById("auth-form");
  const submit = document.getElementById("auth-submit");
  const label = form.querySelector("[data-submit-label]");
  const labelText = label.textContent || "";
  const verifyUrl = form.dataset.verifyUrl || "/verify-email";
  const errorEl = document.getElementById("auth-error");
  const EMAIL_RE = /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}$/;

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value;
    if (!(email.length <= 254 && EMAIL_RE.test(email))) return showError(M.invalidEmail);
    if (password.length < 8) return showError(M.passwordShort);
    submit.disabled = true;
    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || M.failed);
      // Reservations made as a guest on this device become the account's.
      try {
        const tokens = JSON.parse(localStorage.getItem("wd_resv") || "{}");
        const joins = JSON.parse(localStorage.getItem("wd_join") || "{}");
        if (Object.keys(tokens).length + Object.keys(joins).length > 0) {
          await fetch("/api/account/link-reservations", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ tokens, joins }),
          });
        }
      } catch {}
      window.location.href = verifyUrl;
    } catch (err) {
      showError(err instanceof Error ? err.message : M.err);
      submit.disabled = false;
      label.textContent = labelText;
    }
  });
</script>
