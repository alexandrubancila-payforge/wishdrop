---
/** Settings → Profile: photo, name, birthday, account stats and seasonal themes. */
import Layout from "@/layouts/Layout.astro";
import SettingsTabs from "@/components/dashboard/SettingsTabs.astro";
import { makeT, localePath } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/settings";
import social from "@/i18n/social";
import { db } from "@/lib/db";
import { plural } from "@/components/dashboard/plural";
import Icon from "@/components/Icon.astro";
import CoverPhoto from "@/components/social/CoverPhoto.astro";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings, social);

const stats = (await db()
  .prepare(
    `SELECT (SELECT COUNT(*) FROM wishlists WHERE user_id = ?1) AS lists,
            (SELECT COUNT(*) FROM items i JOIN wishlists w ON w.id = i.wishlist_id WHERE w.user_id = ?1) AS gifts,
            (SELECT COUNT(*) FROM items i JOIN wishlists w ON w.id = i.wishlist_id
              WHERE w.user_id = ?1 AND i.reserved_at IS NOT NULL) AS reserved`,
  )
  .bind(user.id)
  .first<{ lists: number; gifts: number; reserved: number }>()) ?? { lists: 0, gifts: 0, reserved: 0 };

const displayName = user.name || user.email.split("@")[0];
const initial = displayName.trim().charAt(0).toUpperCase() || "?";
const memberSince = new Date(user.created_at).getFullYear();
const seasonsEnabled = !user.disable_seasons;

const M = {
  saved: t("js.saved"),
  saveFail: t("js.saveFail"),
  tooBig: t("js.tooBig"),
  save: t("js.save"),
  seasonsOn: t("js.seasonsOn"),
  seasonsOff: t("js.seasonsOff"),
};
const initialAvatar = user.avatar_url ?? "";
const origin = Astro.url.origin;
const P = {
  ok: t("set.usernameOk"),
  hint: t("set.usernameHint", { url: "{url}" }),
  empty: t("set.usernameEmpty"),
};
---

<Layout title={t("titleProfile")} noindex mainClass="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-xl">
    <SettingsTabs active="profile" />
  </div>

  <!-- Profile hero -->
  <section class="card mt-8 overflow-hidden">
    <div class="relative h-28 sm:h-36">
      <CoverPhoto url={user.cover_url} editable />
      {
        !user.cover_url && (
          <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
            <Icon name="gift" class="absolute -right-3 -top-4 h-24 w-24 rotate-12 text-accent-200" />
            <Icon name="sparkle" class="absolute right-28 top-4 h-7 w-7 text-accent-300" />
            <Icon name="heart" class="absolute bottom-3 right-20 h-5 w-5 text-accent-300" />
          </div>
        )
      }
    </div>
    <div class="px-5 pb-5 sm:px-6 sm:pb-6">
      <div class="-mt-10 flex items-end gap-4">
        <div class="relative shrink-0">
          <img
            id="avatar-preview"
            src={user.avatar_url || undefined}
            alt=""
            referrerpolicy="no-referrer"
            class:list={["h-24 w-24 rounded-full object-cover ring-4 ring-white", !user.avatar_url && "hidden"]}
          />
          <span
            id="avatar-initial"
            class:list={[
              "grid h-24 w-24 place-items-center rounded-full gift-gradient text-3xl font-extrabold text-white ring-4 ring-white",
              user.avatar_url && "hidden",
            ]}
          >
            {initial}
          </span>
          <label
            for="avatar-input"
            aria-label={t("changePhoto")}
            title={t("changePhoto")}
            class="absolute -bottom-0.5 -right-0.5 grid h-9 w-9 cursor-pointer place-items-center rounded-full border border-line bg-white text-accent-600 shadow-soft transition hover:bg-accent-50 hover:text-accent-700"
          >
            <Icon name="camera" class="h-[18px] w-[18px]" />
          </label>
          <input id="avatar-input" type="file" accept="image/*" class="hidden" />
        </div>
        <div class="min-w-0 pb-1">
          <p class="truncate text-xl font-extrabold tracking-tight">{displayName}</p>
          <p class="truncate text-sm text-ink-soft">{user.email}</p>
        </div>
      </div>
      <p class="chip mt-4 bg-sun text-sun-ink">
        <Icon name="calendar-blank" class="h-3.5 w-3.5" />
        {t("memberSince", { year: memberSince })}
      </p>
    </div>
  </section>

  <!-- Dashboard grid: form (main) + sidebar (stats + seasonal) -->
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <!-- Main column: edit fields -->
    <form id="settings-form" class="lg:col-span-2">
      <section class="card space-y-5 p-5 sm:p-6">
        <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
          <Icon name="user" class="h-5 w-5 text-accent-500" />
          {t("profile")}
        </h2>
        <div>
          <label for="set-name" class="block text-sm font-semibold text-ink">{t("name")}</label>
          <input
            id="set-name"
            name="name"
            type="text"
            maxlength="100"
            value={user.name ?? ""}
            placeholder={t("namePlaceholder")}
            class="field mt-1"
          />
        </div>
        <div>
          <label for="set-birthday" class="block text-sm font-semibold text-ink">
            {t("birthday")} <span class="font-normal text-ink-soft">{t("optional")}</span>
          </label>
          <input id="set-birthday" name="birthday" type="date" value={user.birthday ?? ""} class="field mt-1" />
        </div>
      </section>

      <!-- Public profile: username, bio, private -->
      <section id="public-profile" class="card mt-6 scroll-mt-24 space-y-5 p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
              <Icon name="users" class="h-5 w-5 text-accent-500" />
              {t("set.publicProfile")}
            </h2>
            <p class="mt-0.5 text-sm text-ink-soft">{t("set.publicProfileText")}</p>
          </div>
          {
            user.username && (
              <a href={localePath(lang, `/@${user.username}`)} class="btn btn-ghost shrink-0 !px-3.5 !py-2 text-xs">
                {t("set.viewProfile")}
              </a>
            )
          }
        </div>
        <div>
          <label for="set-username" class="block text-sm font-semibold text-ink">{t("set.username")}</label>
          <div class="relative mt-1">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center font-bold text-accent-500">@</span>
            <input
              id="set-username"
              name="username" placeholder={t("ph.username")}
              type="text"
              maxlength="24"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              value={user.username ?? ""}
              class="field !pl-9"
            />
          </div>
          <p id="username-help" class="mt-1 text-xs text-ink-soft" data-origin={origin}>
            {user.username ? t("set.usernameHint", { url: `${origin.replace(/^https?:\/\//, "")}/@${user.username}` }) : t("set.usernameEmpty")}
          </p>
        </div>
        <div>
          <label for="set-bio" class="block text-sm font-semibold text-ink">
            {t("set.bio")} <span class="font-normal text-ink-soft">{t("optional")}</span>
          </label>
          <textarea id="set-bio" name="bio" rows="2" maxlength="160" placeholder={t("set.bioPlaceholder")} class="field mt-1 resize-none">{user.bio ?? ""}</textarea>
        </div>
        <label class="flex cursor-pointer items-center justify-between gap-4 rounded-2xl bg-lav p-4">
          <span class="flex min-w-0 items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-white text-lav-ink shadow-soft">
              <Icon name="lock" class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block font-bold text-lav-ink">{t("set.private")}</span>
              <span class="mt-0.5 block text-sm text-lav-ink/80">{t("set.privateText")}</span>
            </span>
          </span>
          <input id="set-private" type="checkbox" checked={!!user.is_private} class="peer sr-only" />
          <span
            class="relative h-6 w-11 shrink-0 rounded-full bg-ink-soft/30 transition after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow-soft after:transition peer-checked:bg-accent-600 peer-checked:after:translate-x-5 peer-focus-visible:ring-4 peer-focus-visible:ring-accent-500/20"
            aria-hidden="true"
          ></span>
        </label>
        <div class="flex items-center justify-end gap-3 border-t border-line pt-5">
          <p id="settings-status" class="hidden text-sm font-medium"></p>
          <button type="submit" id="settings-save" class="btn btn-primary !py-3">
            <span data-save-label>{t("save")}</span>
          </button>
        </div>
      </section>
    </form>

    <!-- Sidebar: stats + seasonal toggle -->
    <div class="space-y-6 lg:col-span-1">
      <div class="grid grid-cols-3 gap-3 lg:grid-cols-1">
        <div class="flex flex-col gap-1 rounded-[1.375rem] bg-accent-100 p-4 text-accent-700 lg:flex-row lg:items-center lg:gap-3">
          <Icon name="list-heart" class="h-5 w-5 lg:h-6 lg:w-6" />
          <p class="text-2xl font-extrabold tracking-tight text-ink lg:text-3xl">{stats.lists}</p>
          <p class="text-xs font-semibold">{plural(t, lang, "stat.lists", stats.lists)}</p>
        </div>
        <div class="flex flex-col gap-1 rounded-[1.375rem] bg-sun p-4 text-sun-ink lg:flex-row lg:items-center lg:gap-3">
          <Icon name="gift" class="h-5 w-5 lg:h-6 lg:w-6" />
          <p class="text-2xl font-extrabold tracking-tight text-ink lg:text-3xl">{stats.gifts}</p>
          <p class="text-xs font-semibold">{plural(t, lang, "stat.gifts", stats.gifts)}</p>
        </div>
        <div class="flex flex-col gap-1 rounded-[1.375rem] bg-mint p-4 text-mint-ink lg:flex-row lg:items-center lg:gap-3">
          <Icon name="check-circle" class="h-5 w-5 lg:h-6 lg:w-6" />
          <p class="text-2xl font-extrabold tracking-tight text-ink lg:text-3xl">{stats.reserved}</p>
          <p class="text-xs font-semibold">{plural(t, lang, "stat.reserved", stats.reserved)}</p>
        </div>
      </div>

      <!-- Seasonal themes toggle -->
      <section class="card p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-lav text-lav-ink">
              <Icon name="snowflake" class="h-5 w-5" />
            </span>
            <div class="min-w-0">
              <p class="font-bold text-ink">{t("seasons")}</p>
              <p class="mt-0.5 text-sm text-ink-soft">{t("seasonsText")}</p>
            </div>
          </div>
          <button
            id="seasons-toggle"
            type="button"
            data-enabled={seasonsEnabled ? "true" : "false"}
            class:list={[
              "relative mt-1 inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200",
              seasonsEnabled ? "bg-accent-500" : "bg-ink-soft/30",
            ]}
            aria-checked={seasonsEnabled ? "true" : "false"}
            aria-label={t("seasons")}
            role="switch"
          >
            <span
              class:list={[
                "pointer-events-none inline-block h-5 w-5 rounded-full bg-white shadow-soft ring-0 transition-transform duration-200",
                seasonsEnabled ? "translate-x-5" : "translate-x-0",
              ]}
            ></span>
          </button>
        </div>
      </section>
    </div>
  </div>

  <script is:inline define:vars={{ M, initialAvatar, P }}>
    const form = document.getElementById("settings-form");
    const fileInput = document.getElementById("avatar-input");
    const preview = document.getElementById("avatar-preview");
    const initialEl = document.getElementById("avatar-initial");
    const saveBtn = document.getElementById("settings-save");
    const saveLabel = form.querySelector("[data-save-label]");
    const status = document.getElementById("settings-status");
    const MAX_BYTES = 5 * 1024 * 1024;

    let avatarUrl = initialAvatar || "";
    let avatarChanged = false;

    function showAvatar(url) {
      if (url) {
        preview.src = url;
        preview.classList.remove("hidden");
        initialEl.classList.add("hidden");
      } else {
        preview.classList.add("hidden");
        initialEl.classList.remove("hidden");
      }
    }

    function setStatus(msg, ok) {
      status.textContent = msg;
      status.className = "text-sm font-medium " + (ok ? "text-mint-ink" : "text-rose-600");
      status.classList.remove("hidden");
    }

    async function downscale(file) {
      if (!file.type.startsWith("image/")) return file;
      let bmp;
      try {
        bmp = await createImageBitmap(file);
      } catch {
        return file;
      }
      const max = 512;
      const scale = Math.min(1, max / Math.max(bmp.width, bmp.height));
      const w = Math.round(bmp.width * scale);
      const h = Math.round(bmp.height * scale);
      const canvas = document.createElement("canvas");
      canvas.width = w;
      canvas.height = h;
      canvas.getContext("2d").drawImage(bmp, 0, 0, w, h);
      bmp.close?.();
      const blob = await new Promise((r) => canvas.toBlob(r, "image/webp", 0.85));
      if (!blob || blob.size >= file.size) return file;
      return new File([blob], "avatar.webp", { type: "image/webp" });
    }

    fileInput.addEventListener("change", async () => {
      const raw = fileInput.files && fileInput.files[0];
      if (!raw) return;
      if (raw.size > MAX_BYTES) return setStatus(M.tooBig, false);
      status.classList.add("hidden");
      saveBtn.disabled = true;
      try {
        const file = await downscale(raw);
        const fd = new FormData();
        fd.append("file", file);
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data.url) throw new Error();
        avatarUrl = data.url;
        avatarChanged = true;
        showAvatar(avatarUrl);
      } catch {
        setStatus(M.saveFail, false);
      } finally {
        saveBtn.disabled = false;
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.classList.add("hidden");
      saveBtn.disabled = true;
      const body = {
        name: document.getElementById("set-name").value.trim(),
        birthday: document.getElementById("set-birthday").value,
        username: document.getElementById("set-username").value.trim().replace(/^@+/, "").toLowerCase(),
        bio: document.getElementById("set-bio").value.trim(),
        is_private: document.getElementById("set-private").checked,
      };
      if (avatarChanged) body.avatar_url = avatarUrl ? avatarUrl.split("?")[0] : null;
      try {
        const res = await fetch("/api/account/profile", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || "");
        avatarChanged = false;
        setStatus(M.saved, true);
        showUsernameHint(body.username);
      } catch (err) {
        setStatus((err instanceof Error && err.message) || M.saveFail, false);
      } finally {
        saveBtn.disabled = false;
        saveLabel.textContent = M.save;
      }
    });

    // Username: lowercase as you type, check availability after a pause.
    const unameInput = document.getElementById("set-username");
    const unameHelp = document.getElementById("username-help");
    const host = unameHelp.dataset.origin.replace(/^https?:\/\//, "");
    let unameTimer;
    function showUsernameHint(u) {
      unameHelp.className = "mt-1 text-xs text-ink-soft";
      unameHelp.textContent = u ? P.hint.replace("{url}", `${host}/@${u}`) : P.empty;
    }
    unameInput.addEventListener("input", () => {
      const clean = unameInput.value.replace(/^@+/, "").toLowerCase().replace(/[^a-z0-9._]/g, "");
      if (clean !== unameInput.value) unameInput.value = clean;
      clearTimeout(unameTimer);
      if (!clean) return showUsernameHint("");
      unameTimer = setTimeout(async () => {
        try {
          const res = await fetch("/api/users/username?u=" + encodeURIComponent(clean));
          const data = await res.json();
          if (unameInput.value !== clean) return;
          if (data.ok) {
            unameHelp.className = "mt-1 text-xs font-medium text-mint-ink";
            unameHelp.textContent = P.ok + " · " + P.hint.replace("{url}", `${host}/@${clean}`);
          } else {
            unameHelp.className = "mt-1 text-xs font-medium text-rose-600";
            unameHelp.textContent = data.error;
          }
        } catch {}
      }, 350);
    });

    // Seasonal themes toggle
    const seasonsToggle = document.getElementById("seasons-toggle");
    seasonsToggle?.addEventListener("click", async () => {
      const wasEnabled = seasonsToggle.dataset.enabled === "true";
      const nowEnabled = !wasEnabled;
      seasonsToggle.dataset.enabled = String(nowEnabled);
      seasonsToggle.setAttribute("aria-checked", String(nowEnabled));
      seasonsToggle.classList.toggle("bg-accent-500", nowEnabled);
      seasonsToggle.classList.toggle("bg-ink-soft/30", !nowEnabled);
      const thumb = seasonsToggle.querySelector("span");
      thumb?.classList.toggle("translate-x-5", nowEnabled);
      thumb?.classList.toggle("translate-x-0", !nowEnabled);
      try {
        await fetch("/api/account/seasons", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ disable: !nowEnabled }),
        });
      } catch {
        // revert on error
        seasonsToggle.dataset.enabled = String(wasEnabled);
        seasonsToggle.setAttribute("aria-checked", String(wasEnabled));
        seasonsToggle.classList.toggle("bg-accent-500", wasEnabled);
        seasonsToggle.classList.toggle("bg-ink-soft/30", !wasEnabled);
        thumb?.classList.toggle("translate-x-5", wasEnabled);
        thumb?.classList.toggle("translate-x-0", !wasEnabled);
      }
    });
  </script>
</Layout>
