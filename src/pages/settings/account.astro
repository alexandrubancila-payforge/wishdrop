---
/** Settings → Account: email + verification state, log out, delete the account. */
import Layout from "@/layouts/Layout.astro";
import SettingsTabs from "@/components/dashboard/SettingsTabs.astro";
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/settings";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);

const M = { deleteConfirm: t("js.deleteConfirm"), deleteFail: t("js.deleteFail") };
const R = { resend: t("js.resend"), sending: t("js.sending"), sent: t("js.sent"), error: t("js.error") };
---

<Layout title={t("titleAccount")} noindex mainClass="mx-auto max-w-xl px-4 py-8 sm:px-6 sm:py-10">
  <SettingsTabs active="account" />

  <!-- Account info -->
  <section class="card mt-6 p-6">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="truncate font-medium text-ink">{user.email}</p>
        {
          user.email_verified ? (
            <p class="text-xs font-semibold text-emerald-600">{t("verified")}</p>
          ) : (
            <p class="flex flex-wrap items-center gap-x-2 text-xs font-semibold text-amber-700">
              {t("unverified")}
              <button id="resend-verify" type="button" class="font-semibold text-accent-600 underline-offset-2 hover:underline">
                {R.resend}
              </button>
            </p>
          )
        }
      </div>
      <button
        type="button"
        id="settings-logout"
        class="flex shrink-0 items-center gap-2 rounded-xl bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-600 hover:bg-rose-100"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        {t("logout")}
      </button>
    </div>
  </section>

  <!-- Danger zone -->
  <section class="mt-6 rounded-3xl border border-rose-200 bg-rose-50/50 p-6">
    <h2 class="text-sm font-semibold text-rose-700">{t("danger")}</h2>
    <p class="mt-1 text-sm text-ink-soft">{t("dangerText")}</p>
    <button
      type="button"
      id="delete-account"
      class="mt-4 inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-rose-700"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6" />
        <line x1="10" y1="11" x2="10" y2="17" />
        <line x1="14" y1="11" x2="14" y2="17" />
      </svg>
      {t("deleteAccount")}
    </button>
  </section>

  <script is:inline define:vars={{ M }}>
    document.getElementById("settings-logout").addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/";
    });

    document.getElementById("delete-account").addEventListener("click", async () => {
      const ok = window.wdConfirm ? await window.wdConfirm(M.deleteConfirm) : confirm(M.deleteConfirm);
      if (!ok) return;
      try {
        const res = await fetch("/api/account/delete", { method: "POST" });
        if (!res.ok) throw new Error();
        window.location.href = "/";
      } catch {
        alert(M.deleteFail);
      }
    });
  </script>

  <script is:inline define:vars={{ M: R }}>
    const btn = document.getElementById("resend-verify");
    btn?.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = M.sending;
      try {
        const res = await fetch("/api/auth/resend-verification", { method: "POST" });
        btn.textContent = res.ok ? M.sent : M.error;
      } catch {
        btn.textContent = M.error;
      }
      setTimeout(() => {
        btn.textContent = M.resend;
        btn.disabled = false;
      }, 4000);
    });
  </script>
</Layout>
