---
/** Settings → Account: email + verification state, log out, blocked accounts, data download, delete the account. */
import Layout from "@/layouts/Layout.astro";
import SettingsTabs from "@/components/dashboard/SettingsTabs.astro";
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/settings";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import { blockedBy, verifiedOnly } from "@/lib/blocks";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);
const blocked = await blockedBy(user.id);

const M = { deleteConfirm: t("js.deleteConfirm"), deleteFail: t("js.deleteFail") };
const R = { resend: t("js.resend"), sending: t("js.sending"), sent: t("js.sent"), error: t("js.error") };
---

<Layout title={t("titleAccount")} noindex mainClass="mx-auto max-w-xl px-4 py-8 sm:px-6 sm:py-10">
  <SettingsTabs active="account" />

  <!-- Account info -->
  <section class="card mt-6 p-5 sm:p-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex min-w-0 items-center gap-3">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-accent-100 text-accent-600">
          <Icon name="envelope-simple" class="h-5 w-5" />
        </span>
        <div class="min-w-0">
          <p class="truncate font-bold text-ink">{user.email}</p>
          {
            user.email_verified ? (
              <p class="chip mt-1 bg-mint text-mint-ink">{t("verified")}</p>
            ) : (
              <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold">
                <span class="chip bg-sun text-sun-ink">
                  <Icon name="warning" class="h-3.5 w-3.5" />
                  {t("unverified")}
                </span>
                <button id="resend-verify" type="button" class="font-bold text-accent-700 underline-offset-2 hover:underline">
                  {R.resend}
                </button>
                {verifiedOnly() && <span class="basis-full font-medium text-ink-soft">{t("verifyToBeFound")}</span>}
              </p>
            )
          }
        </div>
      </div>
      <button type="button" id="settings-logout" class="btn btn-ghost shrink-0 !py-2.5 text-sm">
        <Icon name="sign-out" class="h-4 w-4" />
        {t("logout")}
      </button>
    </div>
  </section>

  <!-- Reminder emails (lib/reminders.ts) -->
  <section class="card mt-6 flex items-center justify-between gap-3 p-5 sm:p-6">
    <div class="flex min-w-0 items-center gap-3">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-sun text-sun-ink">
        <Icon name="cake" class="h-5 w-5" />
      </span>
      <div class="min-w-0">
        <p class="font-bold leading-tight">{t("remindersTitle")}</p>
        <p class="mt-1 text-xs leading-snug text-ink-soft">{t("remindersText")}</p>
      </div>
    </div>
    <label class="inline-flex shrink-0 cursor-pointer items-center">
      <input type="checkbox" id="reminders-toggle" class="peer sr-only" checked={!!user.reminder_emails} />
      <span class="relative h-6 w-11 rounded-full bg-ink-soft/30 transition after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow-soft after:transition peer-checked:bg-accent-600 peer-checked:after:translate-x-5 peer-focus-visible:ring-4 peer-focus-visible:ring-accent-500/20"></span>
    </label>
  </section>

  <!-- Blocked accounts -->
  <section class="card mt-6 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
      <Icon name="prohibit" class="h-5 w-5 text-accent-500" />
      {t("blockedTitle")}
    </h2>
    <p class="mt-1 text-sm text-ink-soft">{blocked.length ? t("blockedText") : t("blockedEmpty")}</p>
    {
      blocked.length > 0 && (
        <ul class="mt-3 divide-y divide-line">
          {blocked.map((b) => (
            <li class="flex items-center gap-3 py-3">
              <Avatar user={b} size={40} class="h-10 w-10" />
              <span class="min-w-0 flex-1 truncate text-sm font-bold">{b.name || (b.username ? `@${b.username}` : b.email.split("@")[0])}</span>
              <button type="button" class="btn btn-ghost shrink-0 !px-4 !py-2 text-xs" data-unblock={b.id}>{t("unblock")}</button>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- Data download (GDPR) -->
  <section class="card mt-6 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
      <Icon name="download-simple" class="h-5 w-5 text-accent-500" />
      {t("exportTitle")}
    </h2>
    <p class="mt-1 text-sm text-ink-soft">{t("exportText")}</p>
    <a href="/api/account/export" download class="btn btn-ghost mt-4 !py-2.5 text-sm">
      <Icon name="download-simple" class="h-4 w-4" />
      {t("exportBtn")}
    </a>
  </section>

  <!-- Danger zone -->
  <section class="card mt-6 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-rose-600">
      <Icon name="warning" class="h-5 w-5" />
      {t("danger")}
    </h2>
    <p class="mt-1 text-sm text-ink-soft">{t("dangerText")}</p>
    <button type="button" id="delete-account" class="btn btn-ghost mt-4 !py-2.5 text-sm !text-rose-600 hover:!border-rose-300">
      <Icon name="trash" class="h-4 w-4" />
      {t("deleteAccount")}
    </button>
  </section>

  <script>
    const reminders = document.getElementById("reminders-toggle") as HTMLInputElement;
    reminders.addEventListener("change", async () => {
      reminders.disabled = true;
      const res = await fetch("/api/account/profile", {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ reminder_emails: reminders.checked }),
      }).catch(() => null);
      if (!res?.ok) reminders.checked = !reminders.checked;
      reminders.disabled = false;
    });

    document.querySelectorAll<HTMLButtonElement>("[data-unblock]").forEach((b) => {
      b.addEventListener("click", async () => {
        b.disabled = true;
        const res = await fetch("/api/blocks", {
          method: "DELETE",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ user_id: b.dataset.unblock }),
        });
        if (res.ok) b.closest("li")?.remove();
        else b.disabled = false;
      });
    });
  </script>

  <script is:inline define:vars={{ M }}>
    document.getElementById("settings-logout").addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/";
    });

    document.getElementById("delete-account").addEventListener("click", async () => {
      const ok = window.wdConfirm ? await window.wdConfirm(M.deleteConfirm) : confirm(M.deleteConfirm);
      if (!ok) return;
      try {
        const res = await fetch("/api/account/delete", { method: "POST" });
        if (!res.ok) throw new Error();
        window.location.href = "/";
      } catch {
        alert(M.deleteFail);
      }
    });
  </script>

  <script is:inline define:vars={{ M: R }}>
    const btn = document.getElementById("resend-verify");
    btn?.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = M.sending;
      try {
        const res = await fetch("/api/auth/resend-verification", { method: "POST" });
        btn.textContent = res.ok ? M.sent : M.error;
      } catch {
        btn.textContent = M.error;
      }
      setTimeout(() => {
        btn.textContent = M.resend;
        btn.disabled = false;
      }, 4000);
    });
  </script>
</Layout>
