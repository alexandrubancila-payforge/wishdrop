---
/** Settings → Password. Google-only accounts have no current password, so that field is left out. */
import Layout from "@/layouts/Layout.astro";
import SettingsTabs from "@/components/dashboard/SettingsTabs.astro";
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/settings";
import Icon from "@/components/Icon.astro";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);
const hasPassword = !!user.password_hash;

const M = { pwSave: t("js.pwSave"), pwSaved: t("js.pwSaved"), pwFail: t("js.pwFail") };
---

<Layout title={t("titlePassword")} noindex mainClass="mx-auto max-w-xl px-4 py-8 sm:px-6 sm:py-10">
  <SettingsTabs active="password" />

  <form id="password-form" class="card mt-6 space-y-4 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
      <Icon name="password" class="h-5 w-5 text-accent-500" />
      {t("changePassword")}
    </h2>
    {
      hasPassword ? (
        <div>
          <label for="pw-current" class="block text-sm font-semibold text-ink">{t("currentPassword")}</label>
          <input id="pw-current" type="password" class="field mt-1" autocomplete="current-password" />
        </div>
      ) : (
        <p class="flex items-start gap-2.5 rounded-2xl bg-lav px-4 py-3 text-sm text-lav-ink">
          <Icon name="google-logo" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>{t("googleNoPassword")}</span>
        </p>
      )
    }
    <div>
      <label for="pw-new" class="block text-sm font-semibold text-ink">
        {t("newPassword")} <span class="font-normal text-ink-soft">{t("minChars")}</span>
      </label>
      <input id="pw-new" type="password" minlength="8" class="field mt-1" autocomplete="new-password" />
    </div>
    <div class="flex items-center justify-end gap-3 border-t border-line pt-4">
      <p id="pw-status" class="hidden text-sm font-medium"></p>
      <button type="submit" id="pw-save" class="btn btn-primary !py-3">{t("changePassword")}</button>
    </div>
  </form>

  <script is:inline define:vars={{ M }}>
    const pwForm = document.getElementById("password-form");
    const pwBtn = document.getElementById("pw-save");
    const pwStatus = document.getElementById("pw-status");
    function setPwStatus(msg, ok) {
      pwStatus.textContent = msg;
      pwStatus.className = "text-sm font-medium " + (ok ? "text-mint-ink" : "text-rose-600");
      pwStatus.classList.remove("hidden");
    }
    pwForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      pwStatus.classList.add("hidden");
      const current = document.getElementById("pw-current")?.value || "";
      const newPw = document.getElementById("pw-new").value;
      if (!newPw) return;
      pwBtn.disabled = true;
      try {
        const res = await fetch("/api/account/password", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ current, new: newPw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || M.pwFail);
        pwForm.reset();
        setPwStatus(M.pwSaved, true);
      } catch (err) {
        setPwStatus(err instanceof Error ? err.message : M.pwFail, false);
      } finally {
        pwBtn.disabled = false;
      }
    });
  </script>
</Layout>
