---
/**
 * The link from the reset email: /reset-password?token=…
 * A missing, unknown or expired token shows "Invalid link" (as on the live site).
 */
import Layout from "@/layouts/Layout.astro";
import { localePath, makeT } from "@/lib/i18n";
import { db } from "@/lib/db";
import common from "@/i18n/common";
import auth from "@/i18n/auth";

const { lang } = Astro.locals;
const t = makeT(lang, common, auth);

const token = Astro.url.searchParams.get("token") ?? "";
const valid = token
  ? !!(await db()
      .prepare("SELECT id FROM users WHERE reset_token = ? AND reset_expires > ?")
      .bind(token, Date.now())
      .first())
  : false;
const M = { failed: t("reset.failed"), err: t("auth.error") };
---

<Layout title={t("reset.title")} description={t("auth.description")} noindex mainClass="mx-auto flex max-w-md flex-col px-4 py-14 sm:py-20">
  <div class="card rise-in p-8">
    <h1 class="font-display text-3xl font-extrabold tracking-tight">{t("reset.heading")}</h1>
    {
      valid ? (
        <form
          id="reset-form"
          class="mt-7 space-y-4"
          data-token={token}
          data-dashboard={localePath(lang, "/dashboard")}
          data-err-min={t("reset.errMin")}
          data-err-match={t("reset.errMatch")}
        >
          <div>
            <label for="password" class="block text-sm font-semibold text-ink">
              {t("reset.password")} <span class="font-normal text-ink-soft/70">{t("auth.minChars")}</span>
            </label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required class="field mt-1" />
          </div>
          <div>
            <label for="password2" class="block text-sm font-semibold text-ink">{t("reset.password2")}</label>
            <input id="password2" name="password2" type="password" autocomplete="new-password" minlength="8" required class="field mt-1" />
          </div>
          <p id="reset-error" class="hidden text-sm font-medium text-rose-600"></p>
          <button type="submit" id="reset-submit" class="btn btn-primary w-full py-3">
            <span data-submit-label>{t("reset.submit")}</span>
          </button>
        </form>
      ) : (
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">{t("reset.invalid")}</div>
      )
    }
    <p class="mt-6 text-center text-sm text-ink-soft">
      <a href={localePath(lang, "/login")} class="font-semibold text-accent-600 hover:underline">{t("auth.backToLogin")}</a>
    </p>
  </div>
</Layout>

<script is:inline define:vars={{ M }}>
  const form = document.getElementById("reset-form");
  if (form) {
    const submit = document.getElementById("reset-submit");
    const label = form.querySelector("[data-submit-label]");
    const labelText = label.textContent || "";
    const errorEl = document.getElementById("reset-error");
    const token = form.dataset.token;
    const dashboard = form.dataset.dashboard || "/dashboard";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");
      const password = document.getElementById("password").value;
      const password2 = document.getElementById("password2").value;
      if (password.length < 8) {
        errorEl.textContent = form.dataset.errMin || "Min. 8 characters.";
        errorEl.classList.remove("hidden");
        return;
      }
      if (password !== password2) {
        errorEl.textContent = form.dataset.errMatch || "Passwords don't match.";
        errorEl.classList.remove("hidden");
        return;
      }
      submit.disabled = true;
      try {
        const res = await fetch("/api/auth/reset-password", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ token, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || M.failed);
        window.location.href = dashboard;
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : M.err;
        errorEl.classList.remove("hidden");
        submit.disabled = false;
        label.textContent = labelText;
      }
    });
  }
</script>
