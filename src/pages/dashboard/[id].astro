  <div id="share-info" data-info={JSON.stringify(shareInfo)} hidden></div>

  <script>
    import { download, qrCard, shareOrDownload, storyImage, type ShareInfo } from "@/scripts/share-image";

    const modal = document.getElementById("share-modal")!;
    const info = JSON.parse(document.getElementById("share-info")!.dataset.info!) as ShareInfo & { slug: string };
    let story: Blob | null = null;
    let qr: Blob | null = null;

    async function render() {
      if (story && qr) return;
      [story, qr] = await Promise.all([storyImage(info), qrCard(info)]);
      for (const [id, blob] of [["story-preview", story], ["qr-preview", qr]] as const) {
        const img = document.getElementById(id) as HTMLImageElement;
        img.src = URL.createObjectURL(blob);
        img.classList.remove("hidden");
        img.parentElement!.classList.remove("skeleton");
      }
      modal.querySelectorAll<HTMLButtonElement>("button[disabled]").forEach((b) => (b.disabled = false));
    }
    const close = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    };
    document.getElementById("open-share")!.addEventListener("click", () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      render().catch(() => {});
    });
    modal.querySelector("[data-share-close]")!.addEventListener("click", close);
    modal.addEventListener("click", (e) => e.target === modal && close());
    document.addEventListener("keydown", (e) => e.key === "Escape" && close());
    document.getElementById("story-share")!.addEventListener("click", () => story && shareOrDownload(story, `wishdrop-${info.slug}-story.png`, info.title));
    document.getElementById("story-download")!.addEventListener("click", () => story && download(story, `wishdrop-${info.slug}-story.png`));
    document.getElementById("qr-download")!.addEventListener("click", () => qr && download(qr, `wishdrop-${info.slug}-qr.png`));
  </script>

  <!-- Edit item modal -->
