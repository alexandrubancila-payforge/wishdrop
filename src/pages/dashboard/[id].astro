        <button type="button" id="event-clear" class:list={["text-xs font-semibold text-ink-soft hover:text-rose-600", !list.event_date && "hidden"]}>{t("event.clear")}</button>
        <span id="event-status" class="hidden text-xs font-medium"></span>
      </div>
    </div>

    <script>
      // Save the event date when it changes (empty = no date).
      const eventBox = document.getElementById("event-box")!;
      const eventInput = document.getElementById("event-date") as HTMLInputElement;
      const eventClear = document.getElementById("event-clear")!;
      const eventStatus = document.getElementById("event-status")!;
      async function saveEvent(value: string) {
        try {
          const res = await fetch(`/api/wishlists/${eventBox.dataset.wishlistId}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ event_date: value || null }),
          });
          if (!res.ok) throw new Error();
          eventStatus.textContent = eventBox.dataset.saved!;
          eventStatus.className = "text-xs font-medium text-mint-ink";
          eventClear.classList.toggle("hidden", !value);
        } catch {
          eventStatus.textContent = eventBox.dataset.fail!;
          eventStatus.className = "text-xs font-medium text-rose-600";
        }
        setTimeout(() => eventStatus.classList.add("hidden"), 2000);
      }
      eventInput.addEventListener("change", () => saveEvent(eventInput.value));
      eventClear.addEventListener("click", () => {
        eventInput.value = "";
        saveEvent("");
      });
    </script>

    <script>
      // Save the visibility as soon as an option is picked.
      const box = document.getElementById("visibility");
      const status = document.getElementById("visibility-status");
      box?.querySelectorAll<HTMLInputElement>('input[name="visibility"]').forEach((radio) => {
        radio.addEventListener("change", async () => {
          const previous = box.dataset.current;
          try {
            const res = await fetch(`/api/wishlists/${box.dataset.wishlistId}`, {
              method: "PATCH",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ visibility: radio.value }),
            });
            if (!res.ok) throw new Error();
            box.dataset.current = radio.value;
            status!.textContent = box.dataset.saved!;
            status!.className = "text-xs font-medium text-mint-ink";
          } catch {
            if (previous) box.querySelector<HTMLInputElement>(`input[value="${previous}"]`)!.checked = true;
            status!.textContent = box.dataset.fail!;
            status!.className = "text-xs font-medium text-rose-600";
          }
          setTimeout(() => status!.classList.add("hidden"), 2000);
        });
      });
      if (box) box.dataset.current = box.querySelector<HTMLInputElement>('input[name="visibility"]:checked')?.value;
    </script>
