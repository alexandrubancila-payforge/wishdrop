---
/**
 * The list editor (owner only): rename, share link, surprise mode, add a gift
 * (auto-fill from a product link or photo upload) with priority and group
 * gift, the gift grid with "most wanted" star, reactions, received, edit and
 * delete, and the received gifts underneath.
 */
import Layout from "@/layouts/Layout.astro";
import { makeT, localePath } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/editor";
import social from "@/i18n/social";
import gifts from "@/i18n/gifts";
import { getItems, getWishlist } from "@/lib/db";
import { contributorsFor, reactionsFor } from "@/lib/gifts";
import { imageUrl } from "@/lib/storage";
import Icon from "@/components/Icon.astro";
import PriorityPicker from "@/components/gifts/PriorityPicker.astro";
import GroupFields from "@/components/gifts/GroupFields.astro";
import Reactions from "@/components/gifts/Reactions.astro";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings, social, gifts);

const list = Astro.params.id ? await getWishlist(Astro.params.id) : null;
if (!list || list.user_id !== user.id) return Astro.redirect(localePath(lang, "/dashboard"));

const all = await getItems(list.id);
const items = all.filter((i) => !i.received_at);
const received = all.filter((i) => i.received_at).sort((a, b) => b.received_at! - a.received_at!);
const [contributors, reactions] = await Promise.all([contributorsFor(list.id), reactionsFor(items.map((i) => i.id), null)]);
const surprise = !!list.hide_reservations;
const shareUrl = `${Astro.url.origin}/w/${list.slug}`;
const domain = (url: string | null) => {
  if (!url) return "";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};

/** Strings that start with an emoji ("📷 Tap to…") get an icon instead. */
const noEmoji = (s: string) => s.replace(/^\p{Extended_Pictographic}\uFE0F?\s*/u, "");

const addStrings = {
  submit: t("js.submit"),
  blocked: t("js.blocked"),
  gotBoth: t("js.gotBoth"),
  gotImg: t("js.gotImg"),
  gotPrice: t("js.gotPrice"),
  none: t("js.none"),
  amazon: t("js.amazon"),
  needImg: t("js.needImg"),
  tooBig: t("js.tooBig"),
  err: t("js.err"),
};
const pageStrings = {
  copyLink: t("copyLink"),
  copied: t("js.copied"),
  on: t("on"),
  off: t("off"),
  reveal: t("js.reveal"),
  hide: t("js.hide"),
  save: t("save"),
  renameFail: t("js.renameFail"),
  saveFail: t("js.saveFail"),
  delConfirm: t("js.delConfirm"),
  delFail: t("js.delFail"),
  tooBig: t("js.tooBig"),
  err: t("js.err"),
};
const wishlistId = list.id;
// For the story image and QR card (src/scripts/share-image.ts).
const shareInfo = {
  url: shareUrl,
  title: list.name,
  owner: user.name || (user.username ? `@${user.username}` : ""),
  event: list.event_date
    ? `🎉 ${new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(list.event_date + "T00:00:00Z"))}`
    : "",
  photos: items.filter((i) => i.image_key).slice(0, 4).map((i) => imageUrl(i.image_key)),
  labels: { myList: t("share.myList"), scan: t("share.scan"), by: t("share.by") },
  slug: list.slug,
};
---

<Layout title={`${list.name} — WishDrop`} noindex mainClass="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-10">
  <a href={localePath(lang, "/dashboard")} class="inline-flex items-center text-sm font-semibold text-ink-soft transition hover:text-accent-700">{t("back")}</a>

  <div class="mt-3">
    <div id="title-view" class="flex items-center gap-2">
      <h1 id="wl-title" title={list.name} class="min-w-0 truncate text-3xl font-extrabold tracking-tight sm:text-4xl">
        {list.name}
      </h1>
      <button
        id="rename-btn"
        aria-label={t("rename")}
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white text-ink-soft shadow-soft transition hover:text-accent-700"
      >
        <Icon name="pencil-simple" class="h-[18px] w-[18px]" />
      </button>
      <a
        href="#list-settings"
        aria-label={t("listSettings")}
        title={t("listSettings")}
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white text-ink-soft shadow-soft transition hover:text-accent-700"
      >
        <Icon name="gear" class="h-[18px] w-[18px]" />
      </a>
    </div>
    <form id="rename-form" class="hidden items-center gap-2" data-wishlist-id={list.id}>
      <input id="rename-input" type="text" placeholder={t("ph.listName")} maxlength="60" required value={list.name} class="field !py-2 text-xl font-extrabold tracking-tight" />
      <button type="submit" class="btn btn-primary shrink-0 !px-4 !py-2.5 text-sm">{t("save")}</button>
      <button type="button" id="rename-cancel" class="btn btn-ghost shrink-0 !px-4 !py-2.5 text-sm">{t("cancel")}</button>
    </form>

    <!-- Compact share row: link · copy · open -->
    <div class="mt-4 flex items-center gap-2">
      <div class="relative min-w-0 flex-1 sm:max-w-md">
        <Icon name="link" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-accent-500" />
        <input
          readonly
          value={shareUrl}
          id="share-url"
          class="field truncate !rounded-full !bg-white !py-2.5 !pl-10 text-sm text-ink-soft shadow-soft"
        />
      </div>
      <button id="copy-share" class="btn btn-soft shrink-0 !px-4 !py-3 text-sm">
        {t("copyLink")}
      </button>
      <button type="button" id="open-share" class="btn btn-ghost shrink-0 !px-4 !py-3 text-sm" aria-label={t("share.title")}>
        <Icon name="qr-code" class="h-4 w-4" />
        <span class="hidden sm:inline">{t("share.btn")}</span>
      </button>
      <a
        href={`/w/${list.slug}`}
        target="_blank"
        rel="noopener"
        aria-label={t("viewPublic")}
        title={t("viewPublic")}
        class="btn btn-ghost h-10 w-10 shrink-0 !p-0"
      >
        <Icon name="arrow-square-out" class="h-[18px] w-[18px]" />
      </a>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[360px_1fr] lg:gap-8">
    <div class="lg:sticky lg:top-20 lg:self-start">
      <form id="add-item-form" data-wishlist-id={list.id} class="card p-5 sm:p-6">
        <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
          <Icon name="gift" class="h-5 w-5 text-accent-500" />
          {t("addTitle")}
        </h2>

        <!-- Auto-fill from link -->
        <div class="mt-4">
          <label for="item-url" class="block text-sm font-semibold text-ink">{t("productLink")}</label>
          <div class="relative mt-1">
            <Icon name="link" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft" />
            <input id="item-url" name="product_url" type="url" placeholder="https://..." class="field !pl-10 !pr-11" />
            <span id="autofill-spinner" class="absolute right-3 top-1/2 hidden -translate-y-1/2 text-accent-500">
              <span class="btn-spinner"></span>
            </span>
          </div>
          <p class="mt-1.5 flex items-start gap-1.5 text-xs text-ink-soft">
            <Icon name="sparkle" class="mt-px h-3.5 w-3.5 shrink-0 text-accent-500" />
            <span>{noEmoji(t("autofillHint"))}</span>
          </p>
        </div>

        <!-- Name: typed, or filled from the product page -->
        <div class="mt-4">
          <label for="item-title" class="block text-sm font-semibold text-ink">
            {t("itemName")} <span class="font-normal text-ink-soft">{t("optional")}</span>
          </label>
          <input id="item-title" name="title" type="text" maxlength="120" placeholder={t("itemNamePlaceholder")} class="field mt-1" />
        </div>

        <!-- Image picker with preview -->
        <div class="mt-4">
          <label class="block text-sm font-semibold text-ink">
            {t("image")} <span class="font-normal text-ink-soft">{t("optional")}</span>
          </label>
          <label
            for="item-image"
            class="relative mt-1 flex aspect-video cursor-pointer items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-line bg-sand text-center text-sm text-ink-soft transition hover:border-accent-300 hover:bg-accent-50"
          >
            <img data-preview class="hidden h-full w-full object-contain" alt="" />
            <!-- Pulses over the box while the link auto-fill looks for a photo. -->
            <span data-preview-skeleton class="skeleton absolute inset-0 hidden place-items-center !rounded-none text-ink-soft/50" aria-hidden="true">
              <Icon name="image" class="h-10 w-10" />
            </span>
            <span data-preview-placeholder class="px-4">
              <span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-white text-accent-500 shadow-soft">
                <Icon name="camera" class="h-6 w-6" />
              </span>
              <span class="mt-2 block font-semibold text-ink">{noEmoji(t("choose"))}</span>
              <span class="mt-0.5 block text-xs text-ink-soft">{t("chooseHint")}</span>
            </span>
          </label>
          <input id="item-image" name="image" type="file" accept="image/*" class="hidden" />
        </div>

        <!-- Price -->
        <div class="mt-4">
          <label for="item-price" class="block text-sm font-semibold text-ink">
            {t("price")} <span class="font-normal text-ink-soft">{t("optional")}</span>
          </label>
          <div class="relative mt-1">
            <Icon name="tag" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft" />
            <input id="item-price" name="price" type="text" maxlength="40" placeholder={t("pricePlaceholder")} class="field !pl-10" />
          </div>
        </div>

        <PriorityPicker lang={lang} name="priority" />
        <GroupFields lang={lang} id="add-group" />

        <p id="add-item-error" class="mt-3 hidden text-sm font-medium text-rose-600"></p>
        <div class="mt-5">
          <button type="submit" id="add-item-submit" class="btn btn-primary w-full !py-3.5">
            <Icon name="plus" weight="bold" class="h-4 w-4" />
            <span data-submit-label>{t("addGift")}</span>
          </button>
        </div>
      </form>

      <script is:inline define:vars={{ M: addStrings, wishlistId }}>
        const form = document.getElementById("add-item-form");
        const urlInput = document.getElementById("item-url");
        const autofillSpinner = document.getElementById("autofill-spinner");
        const fileInput = document.getElementById("item-image");
        const preview = form.querySelector("[data-preview]");
        const placeholder = form.querySelector("[data-preview-placeholder]");
        const previewSkeleton = form.querySelector("[data-preview-skeleton]");
        const priceInput = document.getElementById("item-price");
        const titleInput = document.getElementById("item-title");
        const submitBtn = document.getElementById("add-item-submit");
        const submitLabel = form.querySelector("[data-submit-label]");
        const errorEl = document.getElementById("add-item-error");
        const groupToggle = document.querySelector("#add-group [data-group-toggle]");
        const groupSize = document.querySelector("#add-group [data-group-size]");
        const MAX_BYTES = 15 * 1024 * 1024;

        let scrapedImageKey = null;
        // The last name filled in from a product page: replaced by the next link, never what the user typed.
        let autoTitle = "";

        // Downscale + recompress in the browser before upload so we never store a
        // multi-MB phone photo. Long edge capped, exported as WebP.
        async function downscaleImage(file, maxDim = 1280, quality = 0.82) {
          if (!file || !file.type.startsWith("image/")) return file;
          let bitmap;
          try {
            bitmap = await createImageBitmap(file);
          } catch {
            return file; // can't decode (e.g. HEIC) — let the server take the original
          }
          const { width, height } = bitmap;
          const longest = Math.max(width, height);
          // Already small enough? keep it.
          if (longest <= maxDim && file.size < 350 * 1024) {
            bitmap.close?.();
            return file;
          }
          const scale = Math.min(1, maxDim / longest);
          const w = Math.round(width * scale);
          const h = Math.round(height * scale);
          const canvas = document.createElement("canvas");
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(bitmap, 0, 0, w, h);
          bitmap.close?.();
          const blob = await new Promise((res) => canvas.toBlob(res, "image/webp", quality));
          if (!blob || blob.size >= file.size) return file; // no gain — keep original
          return new File([blob], file.name.replace(/\.[^.]+$/, "") + ".webp", {
            type: "image/webp",
          });
        }

        function showError(msg) {
          errorEl.textContent = msg;
          errorEl.className = "mt-3 text-sm font-medium text-rose-600";
        }
        function showHint(msg) {
          errorEl.textContent = msg;
          errorEl.className = "mt-3 text-sm font-medium text-sun-ink";
        }
        function clearError() {
          errorEl.className = "mt-3 hidden text-sm font-medium text-rose-600";
          errorEl.textContent = "";
        }
        function setPreview(src) {
          preview.src = src;
          preview.classList.remove("hidden");
          placeholder.classList.add("hidden");
        }

        let lastFetched = "";
        let fetching = false;
        const looksLikeUrl = (v) => /^https?:\/\/\S+\.\S+/i.test(v);
        const isAmazon = (v) => /^https?:\/\/(www\.)?amazon\.(com|de|co\.uk|fr|it|es|ca|co\.jp)/i.test(v);

        async function runAutofill() {
          const url = urlInput.value.trim();
          if (fetching || !looksLikeUrl(url) || url === lastFetched) return;
          if (isAmazon(url)) {
            lastFetched = url;
            showHint(M.amazon);
            return;
          }
          lastFetched = url;
          fetching = true;
          clearError();
          autofillSpinner.classList.remove("hidden");
          previewSkeleton.classList.replace("hidden", "grid");
          try {
            const res = await fetch("/api/scrape", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ url }),
            });
            const data = await res.json();
            if (!res.ok) {
              showHint(data.error === "amazon_blocked" ? M.amazon : M.blocked);
              return;
            }
            if (data.title && (!titleInput.value.trim() || titleInput.value === autoTitle)) {
              titleInput.value = autoTitle = data.title;
            }
            if (data.image_key && data.image_url) {
              scrapedImageKey = data.image_key;
              fileInput.value = "";
              setPreview(data.image_url);
              showHint(M.gotImg);
            } else {
              showHint(M.none);
            }
          } catch {
            showHint(M.blocked);
          } finally {
            fetching = false;
            autofillSpinner.classList.add("hidden");
            previewSkeleton.classList.replace("grid", "hidden");
          }
        }

        urlInput.addEventListener("blur", runAutofill);
        urlInput.addEventListener("paste", () => setTimeout(runAutofill, 50));
        urlInput.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            runAutofill();
          }
        });

        fileInput.addEventListener("change", () => {
          const file = fileInput.files && fileInput.files[0];
          if (!file) return;
          scrapedImageKey = null;
          setPreview(URL.createObjectURL(file));
        });

        function setSubmitLoading(loading) {
          // Keep the label (no content swap) so the button doesn't resize; the
          // disabled state alone signals progress.
          submitBtn.disabled = loading;
        }

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          clearError();
          const rawFile = fileInput.files && fileInput.files[0];
          const productUrl = urlInput.value.trim();
          if (!rawFile && !scrapedImageKey && !productUrl) return showError(M.needImg);
          if (rawFile && rawFile.size > MAX_BYTES) return showError(M.tooBig);

          setSubmitLoading(true);
          try {
            let imageKey = scrapedImageKey;
            if (rawFile) {
              const file = await downscaleImage(rawFile);
              const fd = new FormData();
              fd.append("file", file);
              const upRes = await fetch("/api/upload", { method: "POST", body: fd });
              const upData = await upRes.json();
              if (!upRes.ok || !upData.image_key) throw new Error(upData.error || M.err);
              imageKey = upData.image_key;
            }
            const res = await fetch(`/api/wishlists/${wishlistId}/items`, {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                image_key: imageKey || "",
                title: titleInput.value.trim() || null,
                price: priceInput.value.trim() || null,
                product_url: productUrl || null,
                priority: Number(form.querySelector('input[name="priority"]:checked')?.value || 0),
                group_size: groupToggle.checked ? Number(groupSize.value) : null,
              }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || M.err);
            window.location.reload();
          } catch (err) {
            showError(err instanceof Error ? err.message : M.err);
            setSubmitLoading(false);
          }
        });
      </script>
    </div>

    <div>
      <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
        <Icon name="list-heart" class="h-5 w-5 text-accent-500" />
        {t("gifts", { n: items.length })}
      </h2>
      {
        items.length === 0 ? (
          <div class="card mt-3 flex flex-col items-center px-6 py-10 text-center">
            <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
              <Icon name="gift" class="h-8 w-8" />
            </span>
            <p class="mt-4 text-lg font-extrabold tracking-tight">{t("emptyTitle")}</p>
            <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">{t("emptyText")}</p>
            <label for="item-url" class="btn btn-primary mt-5 !py-3 text-sm">
              <Icon name="plus" weight="bold" class="h-4 w-4" />{t("addTitle")}
            </label>
          </div>
        ) : (
          <div id="items-grid" data-surprise={surprise ? "on" : "off"} class="mt-3 grid grid-cols-2 gap-3 sm:gap-5 xl:grid-cols-3">
            {items.map((item) => {
              const reserved = item.reserved_at != null;
              const img = imageUrl(item.image_key);
              const host = domain(item.product_url);
              const href = item.product_url || undefined;
              return (
                <article
                  class="card group relative flex flex-col p-2 transition duration-200 hover:-translate-y-0.5 hover:shadow-lift sm:p-2.5"
                  data-item-id={item.id}
                  data-reserved={reserved ? "true" : "false"}
                  data-my-reservation="false"
                  data-price={item.price ?? ""}
                  data-title={item.title ?? ""}
                  data-product-url={item.product_url ?? ""}
                  data-image-url={img}
                  data-priority={item.priority}
                  data-group-size={item.group_size ?? ""}
                >
                  <a
                    class="relative block aspect-square overflow-hidden rounded-2xl bg-accent-50"
                    href={href}
                    target={href ? "_blank" : undefined}
                    rel={href ? "noopener noreferrer" : undefined}
                    title={href ? t("openProduct") : undefined}
                  >
                    {img ? (
                      <img
                        src={img}
                        alt={item.title || (item.price ? t("giftAltPrice", { price: item.price }) : t("giftAlt"))}
                        loading="lazy"
                        class:list={[
                          "h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]",
                          reserved && "opacity-50 grayscale",
                        ]}
                        data-card-img
                      />
                    ) : (
                      <div
                        class:list={[
                          "flex h-full w-full flex-col items-center justify-center gap-2 p-4 text-center",
                          reserved && "opacity-50 grayscale",
                        ]}
                        data-card-img
                      >
                        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-accent-100 text-accent-600">
                          <Icon name="gift" class="h-7 w-7" />
                        </span>
                        {host && <span class="max-w-full truncate text-sm font-semibold text-accent-700">{host}</span>}
                      </div>
                    )}
                    <div class:list={["absolute inset-0 grid place-items-center bg-mint/40", !reserved && "hidden"]} data-reserved-overlay>
                      <div class="flex flex-col items-center gap-1.5">
                        <span class="gift-tag -rotate-6 shadow-soft">{t("reserved")}</span>
                        <p
                          class:list={[
                            "max-w-[80%] truncate rounded-full bg-white/90 px-2.5 py-0.5 text-center text-xs font-semibold text-mint-ink",
                            !(reserved && item.reserved_by) && "hidden",
                          ]}
                          data-reserved-name
                        >
                          {reserved ? item.reserved_by : ""}
                        </p>
                      </div>
                    </div>
                    {(item.priority < 0 || item.group_size) && (
                      <span class="absolute left-2 top-2 flex flex-col items-start gap-1">
                        {item.group_size && (
                          <span class="chip bg-white/95 text-mint-ink shadow-soft">
                            <Icon name="users-three" weight="bold" class="h-3.5 w-3.5" />
                            <span data-reserved-overlay>{contributors.get(item.id)?.length ?? 0}/</span>
                            {t("group.size", { size: item.group_size })}
                          </span>
                        )}
                        {item.priority < 0 && (
                          <span class="chip bg-white/95 text-sun-ink shadow-soft">
                            <Icon name="lightbulb" weight="bold" class="h-3.5 w-3.5" />
                            {t("prio.short.-1")}
                          </span>
                        )}
                      </span>
                    )}
                  </a>
                  {/* "Most wanted" star — kept OUTSIDE the image link so tapping it never
                      navigates. Toggle for the owner, indicator for visitors. */}
                  <button
                    data-priority-btn
                    aria-label={t("favourite")}
                    title={t("favourite")}
                    class:list={[
                      "priority-star absolute right-4 top-4 z-10 grid h-8 w-8 place-items-center rounded-full transition sm:right-5 sm:top-5",
                      item.priority > 0 && "is-priority",
                    ]}
                  >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]">
                      <path d="M12 17.75l-6.172 3.245 1.179-6.873-4.993-4.867 6.9-1.002L12 2l3.086 6.253 6.9 1.002-4.993 4.867 1.179 6.873z" />
                    </svg>
                  </button>
                  <div class="flex flex-1 flex-col gap-2 px-1.5 pb-1 pt-3">
                    <div class="min-w-0">
                      {item.title && <p class="line-clamp-2 text-sm font-bold leading-snug text-ink">{item.title}</p>}
                      {item.price ? (
                        <>
                          <p class="truncate text-lg font-extrabold tracking-tight">{item.price}</p>
                          {host && <p class="mt-0.5 truncate text-xs font-medium text-ink-soft">{host}</p>}
                        </>
                      ) : (
                        host && <p class="truncate text-sm font-semibold text-ink-soft">{host}</p>
                      )}
                    </div>
                    <Reactions lang={lang} itemId={item.id} summary={reactions.get(item.id)} mode="readonly" />
                    <div class="mt-auto flex items-center justify-end gap-1.5 pt-1">
                      {href && (
                        <a
                          href={href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={t("viewProduct")}
                          title={t("viewProduct")}
