  <script is:inline define:vars={{ M: pageStrings }}>
    // Copy share link
    const copyBtn = document.getElementById("copy-share");
    copyBtn?.addEventListener("click", async () => {
      const input = document.getElementById("share-url");
      try {
        await navigator.clipboard.writeText(input.value);
      } catch {
        input.select();
        document.execCommand("copy");
      }
      copyBtn.textContent = M.copied;
      setTimeout(() => (copyBtn.textContent = M.copyLink), 1500);
    });

    // --- Rename list ---
    const titleView = document.getElementById("title-view");
    const renameForm = document.getElementById("rename-form");
    const renameInput = document.getElementById("rename-input");
    const renameBtn = document.getElementById("rename-btn");
    const renameCancel = document.getElementById("rename-cancel");
    const wlTitle = document.getElementById("wl-title");
    const wlId = renameForm.dataset.wishlistId;

    function closeRename() {
      renameForm.classList.add("hidden");
      renameForm.classList.remove("flex");
      titleView.classList.remove("hidden");
    }
    renameBtn?.addEventListener("click", () => {
      titleView.classList.add("hidden");
      renameForm.classList.remove("hidden");
      renameForm.classList.add("flex");
      renameInput.value = wlTitle.textContent.trim();
      renameInput.focus();
      renameInput.select();
    });
    renameCancel?.addEventListener("click", closeRename);
    renameInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeRename();
    });
    renameForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = renameInput.value.trim();
      if (!name) return;
      const sb = renameForm.querySelector('button[type="submit"]');
      sb.disabled = true;
      try {
        const res = await fetch(`/api/wishlists/${wlId}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name }),
        });
        if (!res.ok) throw new Error();
        wlTitle.textContent = name;
        document.title = `${name} — WishDrop`;
        closeRename();
      } catch {
        alert(M.renameFail);
      } finally {
        sb.disabled = false;
      }
    });

    // Surprise mode toggle (persisted)
    const surpriseToggle = document.getElementById("surprise-toggle");
    const surpriseLabel = document.querySelector("[data-surprise-label]");
    surpriseToggle?.addEventListener("change", async () => {
      const hide = surpriseToggle.checked;
      surpriseToggle.disabled = true;
      if (surpriseLabel) surpriseLabel.textContent = hide ? M.on : M.off;
      try {
        const res = await fetch(`/api/wishlists/${surpriseToggle.dataset.wishlistId}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ hide_reservations: hide }),
        });
        if (!res.ok) throw new Error();
        window.location.reload();
      } catch {
        surpriseToggle.checked = !hide;
        if (surpriseLabel) surpriseLabel.textContent = surpriseToggle.checked ? M.on : M.off;
        surpriseToggle.disabled = false;
        alert(M.saveFail);
      }
    });

    // Delete item
    document.querySelectorAll("[data-delete-btn]").forEach((b) => {
      b.addEventListener("click", async () => {
        const card = b.closest("[data-item-id]");
        const ok = window.wdConfirm ? await window.wdConfirm(M.delConfirm) : confirm(M.delConfirm);
        if (!ok) return;
        b.disabled = true;
        const res = await fetch(`/api/items/${card.dataset.itemId}`, { method: "DELETE" });
        if (res.ok) card.remove();
        else {
          alert(M.delFail);
          b.disabled = false;
        }
      });
    });

    // Toggle "most wanted" priority (star)
    document.querySelectorAll("[data-priority-btn]").forEach((b) => {
      b.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = b.closest("[data-item-id]");
        const on = !b.classList.contains("is-priority");
        b.disabled = true;
        try {
          const res = await fetch(`/api/items/${card.dataset.itemId}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ priority: on }),
          });
          if (!res.ok) throw new Error();
          b.classList.toggle("is-priority", on);
          card.dataset.priority = on ? "1" : "0";
        } catch {
          alert(M.saveFail);
        } finally {
          b.disabled = false;
        }
      });
    });

    // Received: the gift leaves the public list (and comes back with "Put back").
    document.querySelectorAll("[data-received-btn], [data-unreceive-btn]").forEach((b) => {
      b.addEventListener("click", async () => {
        const card = b.closest("[data-item-id]");
        b.disabled = true;
        try {
          const res = await fetch(`/api/items/${card.dataset.itemId}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ received: b.hasAttribute("data-received-btn") }),
          });
          if (!res.ok) throw new Error();
          window.location.reload();
        } catch {
          alert(M.saveFail);
          b.disabled = false;
        }
      });
    });

    // --- Edit item ---
    const editModal = document.getElementById("edit-modal");
    const editImage = document.getElementById("edit-image");
    const editPreview = document.getElementById("edit-preview");
    const editPreviewPh = document.getElementById("edit-preview-ph");
    const editRemoveBtn = document.getElementById("edit-remove-image");
    const editPrice = document.getElementById("edit-price");
    const editTitle = document.getElementById("edit-title");
    const editUrl = document.getElementById("edit-url");
    const editError = document.getElementById("edit-error");
    const editSave = document.getElementById("edit-save");
    const editSaveLabel = editModal.querySelector("[data-save-label]");
    const editCancel = document.getElementById("edit-cancel");
    const editGroupToggle = document.querySelector("#edit-group [data-group-toggle]");
    const editGroupSize = document.querySelector("#edit-group [data-group-size]");

    let editItemId = null;
    let editNewFile = null;
    let editImageRemoved = false;

    function showEditPreview(src) {
      editPreview.src = src;
      editPreview.classList.remove("hidden");
      editPreviewPh.classList.add("hidden");
      editRemoveBtn.classList.remove("hidden");
    }
    function hideEditPreview() {
      editPreview.classList.add("hidden");
      editPreviewPh.classList.remove("hidden");
      editRemoveBtn.classList.add("hidden");
    }
    function closeEdit() {
      editModal.classList.add("hidden");
      editModal.classList.remove("flex");
      editItemId = null;
    }

    document.querySelectorAll("[data-edit-btn]").forEach((b) => {
      b.addEventListener("click", () => {
        const card = b.closest("[data-item-id]");
        editItemId = card.dataset.itemId;
        editPrice.value = card.dataset.price || "";
        editTitle.value = card.dataset.title || "";
        editUrl.value = card.dataset.productUrl || "";
        editNewFile = null;
        editImageRemoved = false;
        editImage.value = "";
        editError.classList.add("hidden");
        const prio = card.dataset.priority || "0";
        editModal.querySelectorAll('input[name="edit-priority"]').forEach((r) => (r.checked = r.value === prio));
        const size = card.dataset.groupSize || "";
        editGroupToggle.checked = !!size;
        editGroupSize.value = size || "4";
        document.querySelector("#edit-group [data-group-row]").classList.toggle("hidden", !size);
        const imgUrl = card.dataset.imageUrl || "";
        if (imgUrl) showEditPreview(imgUrl);
        else hideEditPreview();
        editModal.classList.remove("hidden");
        editModal.classList.add("flex");
      });
    });

    editImage.addEventListener("change", () => {
      const file = editImage.files && editImage.files[0];
      if (!file) return;
      editNewFile = file;
      editImageRemoved = false;
      showEditPreview(URL.createObjectURL(file));
    });
    editRemoveBtn.addEventListener("click", () => {
      editNewFile = null;
      editImageRemoved = true;
      editImage.value = "";
      hideEditPreview();
    });
    editCancel.addEventListener("click", closeEdit);
    editModal.addEventListener("click", (e) => {
      if (e.target === editModal) closeEdit();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !editModal.classList.contains("hidden")) closeEdit();
    });

    editSave.addEventListener("click", async () => {
      if (!editItemId) return;
      editError.classList.add("hidden");
      if (editNewFile && editNewFile.size > 5 * 1024 * 1024) {
        editError.textContent = M.tooBig;
        editError.classList.remove("hidden");
        return;
      }
      editSave.disabled = true;
      try {
        const body = {
          title: editTitle.value.trim() || null,
          price: editPrice.value.trim() || null,
          product_url: editUrl.value.trim() || null,
          priority: Number(editModal.querySelector('input[name="edit-priority"]:checked')?.value || 0),
          group_size: editGroupToggle.checked ? Number(editGroupSize.value) : null,
        };
        if (editNewFile) {
          const fd = new FormData();
          fd.append("file", editNewFile);
          const up = await fetch("/api/upload", { method: "POST", body: fd });
          const upData = await up.json();
          if (!up.ok || !upData.image_key) throw new Error(upData.error || M.err);
          body.image_key = upData.image_key;
        } else if (editImageRemoved) {
          body.image_key = "";
        }
        const res = await fetch(`/api/items/${editItemId}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || M.err);
        window.location.reload();
      } catch (err) {
        editError.textContent = err instanceof Error ? err.message : M.err;
        editError.classList.remove("hidden");
        editSave.disabled = false;
        editSaveLabel.textContent = M.save;
      }
    });
  </script>
</Layout>
