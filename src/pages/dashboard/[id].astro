          <div class="skeleton mx-auto mt-3 aspect-[4/5] w-full max-w-[240px] overflow-hidden !rounded-2xl">
            <img id="qr-preview" alt="" class="hidden h-full w-full object-cover" />
          </div>
          <button type="button" id="qr-download" class="btn btn-ghost mt-3 !py-2.5 text-sm" disabled>
            <Icon name="download-simple" class="h-4 w-4" /> {t("share.download")}
          </button>
        </section>
