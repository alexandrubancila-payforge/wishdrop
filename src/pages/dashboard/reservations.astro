---
/** "My reservations": gifts the signed-in user reserved on other people's lists. */
import Layout from "@/layouts/Layout.astro";
import { makeT, localePath } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/reservations";
import { getReservationsOf } from "@/lib/db";
import { imageUrl } from "@/lib/storage";
import GiftArt from "@/components/gifts/GiftArt.astro";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);

const items = await getReservationsOf(user.id);
const domain = (url: string | null) => {
  if (!url) return "";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};
---

<Layout title={t("title")} noindex mainClass="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-10">
  <header class="flex items-center gap-3">
    <a
      href={localePath(lang, "/dashboard")}
      aria-label={t("back")}
      title={t("back")}
      class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-ink-soft shadow-soft transition hover:text-accent-700"
    >
      <Icon name="caret-left" weight="bold" class="h-5 w-5" />
    </a>
    <h1 class="min-w-0 text-3xl font-extrabold tracking-tight sm:text-4xl">{t("heading")}</h1>
  </header>

  {
    items.length === 0 ? (
      <div class="card mt-8 flex flex-col items-center px-6 py-10 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
          <Icon name="hand-heart" class="h-8 w-8" />
        </span>
        <h2 class="mt-4 text-lg font-extrabold tracking-tight">{t("emptyTitle")}</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">{t("emptyText")}</p>
        <a href={localePath(lang, "/search")} class="btn btn-primary mt-5 !py-3 text-sm">
          <Icon name="magnifying-glass" weight="bold" class="h-4 w-4" />
          {t("emptyCta")}
        </a>
      </div>
    ) : (
      <ul class="mt-8 grid gap-4">
        {items.map((item) => {
          const img = imageUrl(item.image_key);
          const host = domain(item.product_url);
          const owner = { name: item.owner_name, email: item.owner_email, avatar_url: item.owner_avatar };
          return (
            <li class="card flex gap-4 p-2.5 sm:p-3">
              <div class="relative h-28 w-28 shrink-0 overflow-hidden rounded-2xl bg-accent-50 sm:h-32 sm:w-32">
                {img ? (
                  <img src={img} alt={item.title ?? ""} loading="lazy" class="h-full w-full object-cover" />
                ) : (
                  <GiftArt id={item.id} title={item.title} host={host} />
                )}
              </div>
              <div class="flex min-w-0 flex-1 flex-col py-1 pr-1">
                <p class="truncate font-bold leading-tight">{item.wishlist_name}</p>
                <p class="mt-1 flex min-w-0 items-center gap-1.5 text-xs text-ink-soft">
                  <Avatar user={owner} size={20} class="h-5 w-5" />
                  <span class="truncate">{owner.name || owner.email.split("@")[0]}</span>
                </p>
                {item.title && <p class="mt-1.5 line-clamp-2 text-sm font-semibold leading-snug">{item.title}</p>}
                {item.price && <p class="mt-1.5 truncate text-lg font-extrabold leading-tight tracking-tight">{item.price}</p>}
                <p class="mt-1.5">
                  {item.group_count != null ? (
                    <span class="chip bg-lav text-lav-ink">
                      <Icon name="users-three" weight="bold" class="h-3.5 w-3.5" />
                      {t("groupJoined", { n: item.group_count, size: item.group_size ?? item.group_count })}
                    </span>
                  ) : (
                    <span class="chip bg-mint text-mint-ink">
                      <Icon name="check" weight="bold" class="h-3.5 w-3.5" />
                      {t("reservedByYou")}
                    </span>
                  )}
                </p>
                <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 pt-3">
                  <a href={`/w/${item.wishlist_slug}`} class="btn btn-soft !px-4 !py-2 text-xs">
                    {t("goToList")}
                  </a>
                  {item.product_url && host && (
                    <a
                      href={item.product_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-w-0 items-center gap-1 text-xs font-medium text-ink-soft transition hover:text-accent-700"
                    >
                      <span class="truncate">{host}</span>
                      <Icon name="arrow-square-out" class="h-3.5 w-3.5 shrink-0" />
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</Layout>
