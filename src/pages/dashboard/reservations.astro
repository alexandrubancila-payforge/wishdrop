---
/** "My reservations": gifts the signed-in user reserved on other people's lists. */
import Layout from "@/layouts/Layout.astro";
import { makeT, localePath } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/reservations";
import { getReservationsOf } from "@/lib/db";
import { imageUrl } from "@/lib/storage";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);

const items = await getReservationsOf(user.id);
const domain = (url: string | null) => {
  if (!url) return "";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};
---

<Layout title={t("title")} noindex mainClass="mx-auto max-w-3xl px-4 py-10 sm:px-6">
  <header class="flex items-center gap-3">
    <a
      href={localePath(lang, "/dashboard")}
      aria-label={t("back")}
      class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-black/10 bg-white text-ink-soft transition hover:text-accent-600"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </a>
    <div>
      <h1 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">{t("heading")}</h1>
    </div>
  </header>

  {
    items.length === 0 ? (
      <div class="card mt-8 p-8 text-center">
        <div class="text-4xl">💝</div>
        <h2 class="mt-3 font-display text-xl font-bold">{t("emptyTitle")}</h2>
        <p class="mx-auto mt-1 max-w-md text-sm text-ink-soft">{t("emptyText")}</p>
      </div>
    ) : (
      <ul class="mt-8 flex flex-col gap-4">
        {items.map((item) => {
          const img = imageUrl(item.image_key);
          const host = domain(item.product_url);
          return (
            <li class="card flex gap-4 p-4">
              <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-violet-100 to-fuchsia-50">
                {img ? (
                  <img src={img} alt="" loading="lazy" class="h-full w-full object-cover" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-2xl">🎁</div>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-xs font-semibold uppercase tracking-wide text-ink-soft/60">{item.wishlist_name}</p>
                {item.price && <p class="mt-0.5 font-display text-xl font-bold">{item.price}</p>}
                {item.product_url && host && (
                  <a
                    href={item.product_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1 inline-flex items-center gap-1 text-xs text-ink-soft transition hover:text-accent-600"
                  >
                    {host} ↗
                  </a>
                )}
                <div class="mt-3">
                  <a href={`/w/${item.wishlist_slug}`} class="btn btn-ghost !px-3 !py-1.5 text-xs">
                    {t("goToList")}
                  </a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</Layout>
