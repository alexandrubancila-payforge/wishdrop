---
/** "My lists": create a list (opens it right away), see every list with its cover photos, copy/view/delete. */
import Layout from "@/layouts/Layout.astro";
import { makeT, localePath, pick } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/dashboard";
import social from "@/i18n/social";
import publiclist from "@/i18n/publiclist";
import { getUserWishlists } from "@/lib/db";
import { imageUrl } from "@/lib/storage";
import { plural } from "@/components/dashboard/plural";
import Icon from "@/components/Icon.astro";
import GiftArt from "@/components/gifts/GiftArt.astro";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings, social);

const lists = await getUserWishlists(user.id);
const firstName = (user.name || user.email.split("@")[0]).trim().split(/\s+/)[0];
const shareUrl = (slug: string) => `${Astro.url.origin}/w/${slug}`;
const editUrl = (id: string) => localePath(lang, `/dashboard/${id}`);
// "in 12 days" / "today!" under a list whose event is still ahead (wording shared with the public list).
const tList = makeT(lang, publiclist);
const eventLabel = (date: string | null) => {
  if (!date) return null;
  const today = new Date();
  const days = Math.round((Date.parse(date + "T00:00:00Z") - Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate())) / 86_400_000);
  if (days < 0) return null;
  return days === 0 ? tList("event.today") : days === 1 ? tList("event.tomorrow") : plural(tList, lang, "event.in", days);
};

const jsStr = {
  copy: t("js.copy"),
  copyLink: t("copyLink"),
  copied: t("js.copied"),
  create: t("create"),
  delFail: t("js.delFail"),
  err: t("js.err"),
  createErr: t("js.createErr"),
  dashboard: localePath(lang, "/dashboard"),
};
const resendStr = pick(t, { resend: "js.resend", sending: "js.sending", sent: "js.sent", error: "js.error" });
---

<Layout title={t("title")} noindex mainClass="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
  <header class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("hi", { name: firstName })}</h1>
      <p class="mt-1 text-ink-soft">{t("intro")}</p>
    </div>
    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent-100 text-accent-600">
      <Icon name="list-heart" class="h-7 w-7" />
    </span>
  </header>

  {
    // Email not confirmed yet
    !user.email_verified && (
      <div class="mt-6 flex flex-col gap-3 rounded-[1.375rem] bg-sun p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
        <div class="flex min-w-0 items-start gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-white text-sun-ink shadow-soft">
            <Icon name="envelope-simple" class="h-5 w-5" />
          </span>
          <div class="min-w-0">
            <p class="font-bold leading-tight text-sun-ink">{t("verifyTitle")}</p>
            <p class="mt-1 text-sm text-sun-ink/80">{t("verifyText", { email: user.email })}</p>
          </div>
        </div>
        <button id="resend-verify" type="button" class="btn btn-ghost shrink-0 !px-4 !py-2.5 text-sm">
          {resendStr.resend}
        </button>
      </div>
    )
  }

  {
    // No public profile yet: invite to pick a username (profiles start private).
    !user.username && (
      <div class="mt-4 flex flex-col gap-3 rounded-[1.375rem] bg-lav p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
        <div class="flex min-w-0 items-start gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-white text-lav-ink shadow-soft">
            <Icon name="user-circle" class="h-5 w-5" />
          </span>
          <div class="min-w-0">
            <p class="font-bold leading-tight text-lav-ink">{t("onboard.title")}</p>
            <p class="mt-1 text-sm text-lav-ink/80">{t("onboard.text")}</p>
          </div>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <a href={localePath(lang, "/settings") + "#public-profile"} class="btn btn-primary !px-4 !py-2.5 text-sm">{t("onboard.cta")}</a>
          <a href={localePath(lang, "/search")} class="btn btn-ghost !px-4 !py-2.5 text-sm">
            <Icon name="magnifying-glass" class="h-4 w-4" />{t("onboard.find")}
          </a>
        </div>
      </div>
    )
  }

  <!-- Create form -->
  <form id="create-form" class="card mt-6 flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:p-5">
    <div class="flex-1">
      <label for="wl-name" class="sr-only">{t("namePlaceholder")}</label>
      <div class="relative">
        <Icon name="list-heart" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-accent-500" />
        <input id="wl-name" name="name" type="text" required maxlength="60" placeholder={t("namePlaceholder")} class="field !pl-12" />
      </div>
      <p class="mt-1 hidden text-right text-xs text-ink-soft/70" data-wl-counter>
        <span id="wl-count">0</span>/60
      </p>
    </div>
    <button type="submit" id="create-submit" class="btn btn-primary !py-3.5">
      <Icon name="plus" weight="bold" class="h-4 w-4" />
      <span data-submit-label>{t("create")}</span>
    </button>
  </form>
  <p id="create-error" class="mt-2 hidden text-sm font-medium text-rose-600"></p>

  <!-- List -->
  {
    lists.length === 0 ? (
      <div class="card mt-8 flex flex-col items-center px-6 py-10 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
          <Icon name="gift" class="h-8 w-8" />
        </span>
        <h2 class="mt-4 text-lg font-extrabold tracking-tight">{t("emptyTitle")}</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">{t("emptyText")}</p>
        <label for="wl-name" class="btn btn-primary mt-5 !py-3 text-sm">
          <Icon name="plus" weight="bold" class="h-4 w-4" />{t("create")}
        </label>
      </div>
    ) : (
      <>
        <h2 class="mt-8 flex items-center gap-2 text-lg font-extrabold tracking-tight">
          <Icon name="list-heart" class="h-5 w-5 text-accent-500" />
          {plural(t, lang, "lists", lists.length)}
        </h2>
        <ul class="mt-3 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {lists.map((wl) => {
            const empty = wl.item_count === 0;
            const covers = wl.covers.slice(0, 3);
            const more = wl.item_count - covers.length;
            const event = eventLabel(wl.event_date);
            const vis = wl.visibility;
            return (
              <li class="card group flex flex-col overflow-hidden transition duration-200 hover:-translate-y-1 hover:shadow-lift" data-wishlist-id={wl.id}>
                <a href={editUrl(wl.id)} class:list={["relative block overflow-hidden bg-accent-50", empty ? "aspect-[16/7] sm:aspect-[16/11]" : "aspect-[16/11]"]} aria-label={empty ? t("firstGift") : wl.name}>
                  {covers.length > 0 ? (
                    <div
                      class:list={[
                        "grid h-full gap-0.5",
                        covers.length === 2 && "grid-cols-2",
                        covers.length === 3 && "grid-cols-[3fr_2fr] grid-rows-2",
                      ]}
                    >
                      {covers.map((c, i) => (
                        <div class:list={["relative overflow-hidden bg-sand", covers.length === 3 && i === 0 && "row-span-2"]}>
                          {c.image_key ? (
                            <img src={imageUrl(c.image_key)} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.05]" />
                          ) : (
                            <GiftArt id={c.id} title={c.title} size={covers.length === 1 || i === 0 ? "md" : "sm"} />
                          )}
                        </div>
                      ))}
                    </div>
                  ) : empty ? (
                    <div class="flex h-full flex-col items-center justify-center gap-3 p-6 text-center">
                      <span class="grid h-14 w-14 place-items-center rounded-full bg-white text-accent-600 shadow-soft transition duration-300 group-hover:scale-110">
                        <Icon name="plus" weight="bold" class="h-6 w-6" />
                      </span>
                      <span class="text-sm font-bold text-accent-700">{t("firstGift")}</span>
                    </div>
                  ) : (
                    <div class="grid h-full place-items-center">
                      <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600 transition duration-300 group-hover:scale-110">
                        <Icon name="gift" class="h-8 w-8" />
                      </span>
                    </div>
                  )}
                  <span
                    class:list={[
                      "chip absolute left-3 top-3 bg-white/90 shadow-soft backdrop-blur",
                      vis === "public" ? "text-mint-ink" : vis === "followers" ? "text-lav-ink" : "text-ink-soft",
                    ]}
                  >
                    <Icon name={vis === "public" ? "globe" : vis === "followers" ? "users" : "link"} class="h-3.5 w-3.5" />
                    {t(`badge.${vis}`)}
                  </span>
                  {covers.length > 0 && more > 0 && (
                    <span class="chip absolute bottom-3 right-3 bg-ink/70 text-white backdrop-blur">+{more}</span>
                  )}
                </a>
                <div class="flex flex-1 flex-col p-4">
                  <div class="flex items-start gap-1">
                    <div class="min-w-0 flex-1">
                      <a href={editUrl(wl.id)} title={wl.name} class="block truncate text-lg font-extrabold leading-tight tracking-tight hover:text-accent-700">
                        {wl.name}
                      </a>
                      <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
                        <span class="inline-flex items-center gap-1">
                          <Icon name="gift" class="h-4 w-4" />
                          {empty ? t("noGifts") : plural(t, lang, "gifts", wl.item_count)}
                        </span>
                        {!empty && wl.reserved_count > 0 && !wl.hide_reservations && (
                          <span class="inline-flex items-center gap-1 text-mint-ink">
                            <Icon name="check-circle" class="h-4 w-4" />
                            {t("reservedN", { n: wl.reserved_count })}
                          </span>
                        )}
                        {event && (
                          <span class="inline-flex items-center gap-1 font-semibold text-accent-700">
                            <Icon name="calendar-blank" class="h-4 w-4" />
                            {event}
                          </span>
                        )}
                      </p>
                    </div>
                    <a
                      href={`/w/${wl.slug}`}
                      target="_blank"
                      rel="noopener"
                      aria-label={t("viewPublic")}
                      title={t("viewPublic")}
                      class="-mt-1 grid h-9 w-9 shrink-0 place-items-center rounded-full text-ink-soft transition hover:bg-accent-50 hover:text-accent-700"
                    >
                      <Icon name="eye" class="h-[18px] w-[18px]" />
                    </a>
                    <button
                      data-delete-wishlist
                      data-confirm={t("deleteConfirm", { name: wl.name })}
                      aria-label={t("delete")}
                      title={t("delete")}
                      class="-mr-1 -mt-1 grid h-9 w-9 shrink-0 place-items-center rounded-full text-ink-soft transition hover:bg-accent-50 hover:text-rose-600"
                    >
                      <Icon name="trash" class="h-[18px] w-[18px]" />
                    </button>
                  </div>
                  {empty ? (
                    <div class="mt-auto pt-4">
                      <a href={editUrl(wl.id)} class="btn btn-primary w-full !px-4 !py-3 text-sm">
                        <Icon name="plus" weight="bold" class="h-4 w-4" />
                        {t("addGifts")}
                      </a>
                    </div>
                  ) : (
                    <div class="mt-auto grid grid-cols-2 gap-2 pt-4">
                      <button data-send-btn data-url={shareUrl(wl.slug)} data-title={wl.name} data-text={t("sendText", { list: wl.name })} class="btn btn-primary !px-4 !py-3 text-sm">
                        <Icon name="paper-plane-tilt" class="h-4 w-4" />
                        <span data-send-label>{t("send")}</span>
                      </button>
                      <a href={editUrl(wl.id)} class="btn btn-soft !px-4 !py-3 text-sm">
                        <Icon name="pencil-simple" class="h-4 w-4" />
                        {t("editShort")}
                      </a>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </>
    )
  }

  <script is:inline define:vars={{ M: resendStr }}>
    const btn = document.getElementById("resend-verify");
    btn?.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = M.sending;
      try {
        const res = await fetch("/api/auth/resend-verification", { method: "POST" });
        btn.textContent = res.ok ? M.sent : M.error;
      } catch {
        btn.textContent = M.error;
      }
      setTimeout(() => {
        btn.textContent = M.resend;
        btn.disabled = false;
      }, 4000);
    });
  </script>

  <script is:inline define:vars={{ jsStr }}>
    const form = document.getElementById("create-form");
    const btn = document.getElementById("create-submit");
    const label = form.querySelector("[data-submit-label]");
    const createError = document.getElementById("create-error");

    // Arriving via the mobile "+" tab focuses the new-list field.
    if (location.hash === "#new") {
      const input = document.getElementById("wl-name");
      input?.scrollIntoView({ block: "center" });
      input?.focus();
    }

    // Live character counter for the list name (visible limit).
    const nameInput = document.getElementById("wl-name");
    const counter = document.querySelector("[data-wl-counter]");
    const countEl = document.getElementById("wl-count");
    nameInput?.addEventListener("input", () => {
      countEl.textContent = nameInput.value.length;
      counter.classList.toggle("hidden", nameInput.value.length === 0);
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      createError.classList.add("hidden");
      const name = document.getElementById("wl-name").value.trim();
      if (!name) return;
      btn.disabled = true;
      try {
        const res = await fetch("/api/wishlists", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || jsStr.createErr);
        // Straight into the new list, where "Add a gift" is the first thing on the page.
        window.location.href = `${jsStr.dashboard}/${data.id}`;
      } catch (err) {
        createError.textContent = err instanceof Error ? err.message : jsStr.err;
        createError.classList.remove("hidden");
        btn.disabled = false;
        label.textContent = jsStr.create;
      }
    });

    // Send: the phone's share sheet (WhatsApp, Telegram…); without one, copy the link.
    document.querySelectorAll("[data-send-btn]").forEach((b) => {
      const label = b.querySelector("[data-send-label]");
      b.addEventListener("click", async () => {
        const data = { title: b.dataset.title, text: b.dataset.text, url: b.dataset.url };
        if (navigator.share && (!navigator.canShare || navigator.canShare(data))) {
          try {
            await navigator.share(data);
          } catch {}
          return;
        }
        try {
          await navigator.clipboard.writeText(b.dataset.url);
        } catch {}
        const text = label.textContent;
        label.textContent = jsStr.copied;
        setTimeout(() => (label.textContent = text), 1500);
      });
    });

    document.querySelectorAll("[data-delete-wishlist]").forEach((b) => {
      b.addEventListener("click", async () => {
        const li = b.closest("li");
        const id = li.dataset.wishlistId;
        const ok = window.wdConfirm ? await window.wdConfirm(b.dataset.confirm) : confirm(b.dataset.confirm);
        if (!ok) return;
        b.disabled = true;
        const res = await fetch(`/api/wishlists/${id}`, { method: "DELETE" });
        if (res.ok) li.remove();
        else {
          alert(jsStr.delFail);
          b.disabled = false;
        }
      });
    });
  </script>
</Layout>
