---
/** "My lists": create a list, see every list with its cover photos, copy/view/delete. */
import Layout from "@/layouts/Layout.astro";
import { makeT, localePath, pick } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/dashboard";
import { getUserWishlists } from "@/lib/db";
import { imageUrl } from "@/lib/storage";
import { plural } from "@/components/dashboard/plural";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);

const lists = await getUserWishlists(user.id);
const firstName = (user.name || user.email.split("@")[0]).trim().split(/\s+/)[0];
const shareUrl = (slug: string) => `${Astro.url.origin}/w/${slug}`;
const editUrl = (id: string) => localePath(lang, `/dashboard/${id}`);

const jsStr = {
  copy: t("js.copy"),
  copyLink: t("copyLink"),
  copied: t("js.copied"),
  create: t("create"),
  delFail: t("js.delFail"),
  err: t("js.err"),
  createErr: t("js.createErr"),
};
const resendStr = pick(t, { resend: "js.resend", sending: "js.sending", sent: "js.sent", error: "js.error" });
---

<Layout title={t("title")} noindex mainClass="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <header>
    <h1 class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{t("hi", { name: firstName })}</h1>
    <p class="mt-1 text-ink-soft">{t("intro")}</p>
  </header>

  {
    // Email not confirmed yet
    !user.email_verified && (
      <div class="mt-5 flex flex-col gap-3 rounded-2xl border border-amber-200 bg-amber-50/80 p-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-start gap-2.5">
          <span class="text-xl leading-none">📧</span>
          <div class="min-w-0">
            <p class="font-semibold leading-tight text-amber-900">{t("verifyTitle")}</p>
            <p class="mt-1 text-sm text-amber-800/80">{t("verifyText", { email: user.email })}</p>
          </div>
        </div>
        <button id="resend-verify" type="button" class="btn btn-ghost shrink-0 !px-4 !py-2 text-sm">
          {resendStr.resend}
        </button>
      </div>
    )
  }

  <!-- Create form -->
  <form id="create-form" class="card mt-6 flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:p-5">
    <div class="flex-1">
      <label for="wl-name" class="sr-only">{t("namePlaceholder")}</label>
      <input id="wl-name" name="name" type="text" required maxlength="60" placeholder={t("namePlaceholder")} class="field" />
      <p class="mt-1 hidden text-right text-xs text-ink-soft/60" data-wl-counter>
        <span id="wl-count">0</span>/60
      </p>
    </div>
    <button type="submit" id="create-submit" class="btn btn-primary py-2.5">
      <span data-submit-label>{t("create")}</span>
    </button>
  </form>
  <p id="create-error" class="mt-2 hidden text-sm font-medium text-rose-600"></p>

  <!-- List -->
  {
    lists.length === 0 ? (
      <div class="card mt-10 p-8 text-center">
        <div class="text-4xl">🎁</div>
        <h2 class="mt-3 font-display text-xl font-bold">{t("emptyTitle")}</h2>
        <p class="mx-auto mt-1 max-w-md text-sm text-ink-soft">{t("emptyText")}</p>
      </div>
    ) : (
      <>
        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-ink-soft/70">{plural(t, lang, "lists", lists.length)}</h2>
        <ul class="mt-4 grid gap-5 sm:grid-cols-2">
          {lists.map((wl) => (
            <li
              class="card group flex flex-col overflow-hidden transition duration-200 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(124,58,237,0.45)]"
              data-wishlist-id={wl.id}
            >
              <a href={editUrl(wl.id)} class="relative block h-36 overflow-hidden" aria-label={wl.name}>
                {wl.covers.length > 0 ? (
                  <div
                    class:list={[
                      "grid h-full gap-0.5",
                      wl.covers.length === 1 && "grid-cols-1",
                      wl.covers.length === 2 && "grid-cols-2",
                      wl.covers.length >= 3 && "grid-cols-2 grid-rows-2",
                    ]}
                  >
                    {wl.covers.map((key, i) => (
                      <div class:list={["relative overflow-hidden", wl.covers.length === 3 && i === 0 && "row-span-2"]}>
                        <img
                          src={imageUrl(key)}
                          alt=""
                          loading="lazy"
                          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.04]"
                        />
                        {i === 3 && wl.item_count > 4 && (
                          <span class="absolute inset-0 grid place-items-center bg-gray-900/55 text-lg font-bold text-white">
                            +{wl.item_count - 4}
                          </span>
                        )}
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="grid h-full place-items-center bg-gradient-to-br from-violet-100 via-fuchsia-50 to-amber-50 text-5xl">
                    <span class="transition duration-300 group-hover:scale-110">🎁</span>
                  </div>
                )}
                <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2.5 py-1 text-xs font-bold text-ink shadow-sm backdrop-blur">
                  🎁 {wl.item_count}
                </span>
              </a>
              <div class="card-divider" />
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex items-start justify-between gap-2">
                  <a
                    href={editUrl(wl.id)}
                    title={wl.name}
                    class="min-w-0 truncate font-display text-xl font-bold leading-tight hover:text-accent-600"
                  >
                    {wl.name}
                  </a>
                  <button
                    data-delete-wishlist
                    data-confirm={t("deleteConfirm", { name: wl.name })}
                    aria-label={t("delete")}
                    title={t("delete")}
                    class="-mr-1 -mt-1 shrink-0 rounded-lg p-2 text-ink-soft/60 transition hover:bg-rose-50 hover:text-rose-600"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6" />
                      <line x1="10" y1="11" x2="10" y2="17" />
                      <line x1="14" y1="11" x2="14" y2="17" />
                    </svg>
                  </button>
                </div>
                <div class="mt-auto flex flex-col gap-2 pt-1">
                  <a href={editUrl(wl.id)} class="btn btn-primary w-full !py-2.5 text-sm">{t("manage")}</a>
                  <div class="grid grid-cols-2 gap-2">
                    <button data-copy-btn data-url={shareUrl(wl.slug)} class="btn btn-ghost !py-2 text-sm">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2" />
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                      </svg>
                      <span data-copy-label>{t("copyLink")}</span>
                    </button>
                    <a href={`/w/${wl.slug}`} target="_blank" rel="noopener" class="btn btn-ghost !py-2 text-sm">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                      {t("view")}
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <script is:inline define:vars={{ M: resendStr }}>
    const btn = document.getElementById("resend-verify");
    btn?.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = M.sending;
      try {
        const res = await fetch("/api/auth/resend-verification", { method: "POST" });
        btn.textContent = res.ok ? M.sent : M.error;
      } catch {
        btn.textContent = M.error;
      }
      setTimeout(() => {
        btn.textContent = M.resend;
        btn.disabled = false;
      }, 4000);
    });
  </script>

  <script is:inline define:vars={{ jsStr }}>
    const form = document.getElementById("create-form");
    const btn = document.getElementById("create-submit");
    const label = form.querySelector("[data-submit-label]");
    const createError = document.getElementById("create-error");

    // Arriving via the mobile "+" tab focuses the new-list field.
    if (location.hash === "#new") {
      const input = document.getElementById("wl-name");
      input?.scrollIntoView({ block: "center" });
      input?.focus();
    }

    // Live character counter for the list name (visible limit).
    const nameInput = document.getElementById("wl-name");
    const counter = document.querySelector("[data-wl-counter]");
    const countEl = document.getElementById("wl-count");
    nameInput?.addEventListener("input", () => {
      countEl.textContent = nameInput.value.length;
      counter.classList.toggle("hidden", nameInput.value.length === 0);
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      createError.classList.add("hidden");
      const name = document.getElementById("wl-name").value.trim();
      if (!name) return;
      btn.disabled = true;
      try {
        const res = await fetch("/api/wishlists", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || jsStr.createErr);
        window.location.reload();
      } catch (err) {
        createError.textContent = err instanceof Error ? err.message : jsStr.err;
        createError.classList.remove("hidden");
        btn.disabled = false;
        label.textContent = jsStr.create;
      }
    });

    document.querySelectorAll("[data-copy-btn]").forEach((b) => {
      const label = b.querySelector("[data-copy-label]");
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.url);
        } catch {}
        if (label) {
          label.textContent = jsStr.copied;
          setTimeout(() => (label.textContent = jsStr.copyLink), 1500);
        }
      });
    });

    document.querySelectorAll("[data-delete-wishlist]").forEach((b) => {
      b.addEventListener("click", async () => {
        const li = b.closest("li");
        const id = li.dataset.wishlistId;
        const ok = window.wdConfirm ? await window.wdConfirm(b.dataset.confirm) : confirm(b.dataset.confirm);
        if (!ok) return;
        b.disabled = true;
        const res = await fetch(`/api/wishlists/${id}`, { method: "DELETE" });
        if (res.ok) li.remove();
        else {
          alert(jsStr.delFail);
          b.disabled = false;
        }
      });
    });
  </script>
</Layout>
