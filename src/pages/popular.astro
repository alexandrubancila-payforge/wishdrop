---
/**
 * /popular — the most loved gifts from public lists (lib/popular.ts), shown
 * without their owner. Anyone can react; signed-in people can copy a gift into
 * their own list (components/gifts/CopyGiftSheet.astro).
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import Reactions from "@/components/gifts/Reactions.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/popular";
import { popularGifts, type PopularGift } from "@/lib/popular";
import { reactionsFor } from "@/lib/gifts";
import { imageUrl } from "@/lib/storage";
import { CATEGORIES, giftCategory } from "@/lib/gift-icon";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, strings);
const href = (p: string) => localePath(lang, p);
const { popular, recent } = await popularGifts();
const reactions = await reactionsFor([...popular, ...recent].map((g) => g.id), user?.id ?? null);
const loginHref = `${href("/login")}?next=${encodeURIComponent("/popular")}`;
const domain = (url: string | null) => {
  if (!url) return "";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};
const sections = [
  { key: "popular", title: t("popular"), gifts: popular },
  { key: "recent", title: t("recent"), gifts: recent },
].filter((s) => s.gifts.length);
const own = (g: PopularGift) => !!user && g.owner_id === user.id;
// Filter chips only for categories that have gifts on the page.
const catOf = new Map([...popular, ...recent].map((g) => [g.id, giftCategory(g.title, g.product_url)]));
const cats = CATEGORIES.filter((c) => [...catOf.values()].includes(c));
// A card's name: the gift's own, else the shop's ("store.steampowered.com" → "Steampowered").
const shopName = (site: string) => {
  const parts = site.split(".");
  const main = parts.length > 2 && ["store", "shop", "m"].includes(parts[0]) ? parts[1] : parts[0];
  return main ? main.charAt(0).toUpperCase() + main.slice(1) : "";
};
---

<Layout title={t("title")} description={t("description")} mainClass="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    {/* The info popover hangs from this row, not from the ⓘ, so on a phone it spans the row and can't leave the screen. */}
    <div class="relative flex items-center gap-2">
      <h1 class="flex items-center gap-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
        <Icon name="fire" class="h-8 w-8 text-accent-500" />
        {t("h1")}
      </h1>
      <details id="popular-about">
        <summary class="grid h-8 w-8 cursor-pointer list-none place-items-center rounded-full text-ink-soft transition hover:bg-white hover:text-accent-700 [&::-webkit-details-marker]:hidden" aria-label={t("about")} title={t("about")}>
          <Icon name="info" class="h-5 w-5" />
        </summary>
        <div class="absolute inset-x-0 top-full z-20 mt-2 rounded-2xl border border-line bg-white p-4 text-sm shadow-lift sm:right-auto sm:w-96">
          <p class="text-ink">{t("intro")}</p>
          <p class="mt-2 flex items-start gap-1.5 text-xs text-ink-soft">
            <Icon name="shield-check" class="mt-px h-4 w-4 shrink-0 text-mint-ink" />
            {t("privacy")}
          </p>
        </div>
      </details>
    </div>
    {
      cats.length > 1 && (
        <div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0 lg:flex-wrap lg:justify-end" role="toolbar" id="cat-filter">
          {["all", ...cats].map((c, i) => (
            <button type="button" data-cat={c} aria-pressed={i === 0 ? "true" : "false"} class="cat-chip">
              {t(`cat.${c}`)}
            </button>
          ))}
        </div>
      )
    }
  </header>

  {
    sections.length === 0 ? (
      <div class="card mt-8 flex flex-col items-center px-6 py-12 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
          <Icon name="gift" class="h-8 w-8" />
        </span>
        <p class="mx-auto mt-4 max-w-md text-ink-soft">{t("empty")}</p>
        <a href={user ? href("/dashboard") + "#new" : href("/register")} class="btn btn-primary mt-5 !py-3 text-sm">{t("emptyCta")}</a>
      </div>
    ) : (
      sections.map((sec) => (
        <section class="mt-8" data-section>
          <h2 class="text-xl font-extrabold tracking-tight">{sec.title}</h2>
          <ul class="mt-4 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
            {sec.gifts.map((g) => {
              const img = imageUrl(g.image_key);
              const site = domain(g.product_url);
              const Wrapper = g.product_url ? "a" : "div";
              const wrapperProps = g.product_url ? { href: g.product_url, target: "_blank", rel: "nofollow noopener noreferrer", title: t("viewProduct") } : {};
              return (
                <li class="card flex flex-col !rounded-3xl p-2" data-item-id={g.id} data-image-url={img} data-cat={catOf.get(g.id)}>
                  <div class="relative">
                    <Wrapper class="relative block aspect-square overflow-hidden rounded-2xl bg-sand" {...wrapperProps}>
                      <img src={img} alt={g.title ?? ""} loading="lazy" class="h-full w-full object-cover transition duration-300 hover:scale-[1.03]" />
                      {g.people > 1 && (
                        <span class="chip absolute left-2 top-2 bg-white/95 text-xs text-ink shadow-soft">
                          <Icon name="users" weight="bold" class="h-3.5 w-3.5 text-accent-500" />
                          {t("people", { n: g.people })}
                        </span>
                      )}
                      {g.price && <span class="chip absolute bottom-2 left-2 max-w-[85%] truncate bg-white/95 text-sm text-ink shadow-soft">{g.price}</span>}
                    </Wrapper>
                    {/* The heart sits on the photo, outside the link so tapping it never opens the shop. */}
                    {own(g) ? (
                      <span class="absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full bg-mint-ink text-white shadow-soft" title={t("own")}>
                        <Icon name="check" weight="bold" class="h-4 w-4" />
                      </span>
                    ) : (
                      <Reactions lang={lang} itemId={g.id} summary={reactions.get(g.id)} mode={user ? "react" : "login"} loginHref={loginHref} heartOnly class="absolute right-2 top-2" />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col px-1.5 pb-1 pt-2.5">
                    <p class="line-clamp-2 min-h-[2.5rem] text-sm font-bold leading-snug text-ink">{g.title || shopName(site) || t("viewProduct")}</p>
                    <p class="mt-0.5 truncate text-xs font-medium text-ink-soft">{site || "\u00a0"}</p>
                    <div class="mt-auto pt-3">
                      {own(g) ? (
                        <p class="flex h-10 items-center justify-center gap-1.5 rounded-full bg-mint px-3 text-xs font-bold text-mint-ink">
                          <Icon name="check" weight="bold" class="h-3.5 w-3.5" />
                          {t("own")}
                        </p>
                      ) : user ? (
                        <button type="button" data-copy-item={g.id} class="btn btn-primary h-10 w-full !py-0 text-sm">
                          <Icon name="plus" weight="bold" class="h-4 w-4" />
                          {t("add")}
                        </button>
                      ) : (
                        <a href={loginHref} class="btn btn-primary h-10 w-full !py-0 text-sm" title={t("addGuest")}>
                          <Icon name="plus" weight="bold" class="h-4 w-4" />
                          {t("add")}
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    )
  }

  <p id="cat-empty" hidden class="card mt-8 px-6 py-10 text-center text-sm text-ink-soft">{t("cat.none")}</p>

  <script>
    // The ⓘ popover closes on a click outside it or Escape.
    const about = document.getElementById("popular-about") as HTMLDetailsElement | null;
    document.addEventListener("click", (e) => {
      if (about?.open && !about.contains(e.target as Node)) about.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && about) about.open = false;
    });

    // Category chips: show only that category's cards; a section with none left hides.
    const filter = document.getElementById("cat-filter");
    filter?.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-cat]");
      if (!chip) return;
      const cat = chip.dataset.cat!;
      filter.querySelectorAll("[data-cat]").forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      let any = false;
      document.querySelectorAll<HTMLElement>("[data-section]").forEach((sec) => {
        let shown = 0;
        sec.querySelectorAll<HTMLElement>("li[data-cat]").forEach((li) => {
          li.hidden = cat !== "all" && li.dataset.cat !== cat;
          if (!li.hidden) shown++;
        });
        sec.hidden = shown === 0;
        any ||= shown > 0;
      });
      document.getElementById("cat-empty")!.hidden = any;
    });

    // "To my list" opens the same sheet as "I want it too".
    document.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>("[data-copy-item]");
      if (!b) return;
      const card = b.closest<HTMLElement>("[data-item-id]");
      window.dispatchEvent(new CustomEvent("wd:want", { detail: { itemId: b.dataset.copyItem, image: card?.dataset.imageUrl || "" } }));
    });
  </script>
</Layout>
