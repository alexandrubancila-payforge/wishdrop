---
/** Find people by name or @username. Only people who picked a username can be found. */
import Layout from "@/layouts/Layout.astro";
import PersonRow from "@/components/social/PersonRow.astro";
import FollowButton from "@/components/social/FollowButton.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { db } from "@/lib/db";
import { searchUsers, type Relation } from "@/lib/social";
import { plural } from "@/components/dashboard/plural";
import { suggestedPeople } from "@/lib/feed";
import feedStrings from "@/i18n/feed";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, social);
const q = (Astro.url.searchParams.get("q") ?? "").trim();
const results = q.length >= 2 ? await searchUsers(q, Astro.locals.user?.id ?? null) : [];

const mine = new Map<string, Relation>();
if (user && results.length) {
  const { results: rows } = await db()
    .prepare(`SELECT followee_id, status FROM follows WHERE follower_id = ? AND followee_id IN (${results.map(() => "?").join(",")})`)
    .bind(user.id, ...results.map((r) => r.id))
    .all<{ followee_id: string; status: string }>();
  for (const r of rows) mine.set(r.followee_id, r.status === "accepted" ? "following" : "requested");
}
const relTo = (id: string): Relation => (user?.id === id ? "self" : (mine.get(id) ?? "none"));

// Before a search: an invite to send your profile link, and people you could follow.
const suggestions = user ? await suggestedPeople(user.id, 8) : [];
const tFeed = makeT(lang, feedStrings);
const profileUrl = user?.username ? `${Astro.url.origin}/@${user.username}` : null;
const firstWord = (s: string) => (s.startsWith("@") ? s : s.trim().split(/\s+/)[0]);
---

<Layout title={`${t("search.title")} — WishDrop`} noindex mainClass="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-10">
  <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("search.heading")}</h1>
  <p class="mt-1 text-ink-soft">{t("search.intro")}</p>

  <form method="get" id="search-form" class="mt-6" role="search">
    <label for="q" class="sr-only">{t("search.placeholder")}</label>
    <div class="relative">
      <Icon name="magnifying-glass" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-soft" />
      <input
        id="q"
        name="q"
        type="search"
        value={q}
        maxlength="50"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        autofocus
        placeholder={t("search.placeholder")}
        class="field !rounded-full !bg-white !py-3.5 !pl-12 !pr-12 shadow-soft"
      />
      <span id="search-spinner" class="pointer-events-none absolute right-5 top-1/2 hidden -translate-y-1/2 text-accent-500" aria-hidden="true">
        <span class="btn-spinner"></span>
      </span>
    </div>
  </form>
  <p class="mt-2.5 flex items-start gap-1.5 px-1 text-xs text-ink-soft">
    <Icon name="lock" class="mt-px h-3.5 w-3.5 shrink-0" />
    {t("search.hint")}
  </p>

  {
    user && !user.username && (
      <div class="card mt-6 flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
        <div class="flex items-center gap-3">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-lav text-lav-ink">
            <Icon name="user-circle" class="h-6 w-6" />
          </span>
          <div>
            <p class="font-bold text-ink">{t("search.claimTitle")}</p>
            <p class="text-sm text-ink-soft">{t("search.claimText")}</p>
          </div>
        </div>
        <a href={localePath(lang, "/settings") + "#public-profile"} class="btn btn-ghost shrink-0 !px-4 !py-2.5 text-sm">{t("search.claimBtn")}</a>
      </div>
    )
  }

  {/* Shown while the search box is empty; the script hides it during a search. */}
  <div id="search-idle" hidden={q.length > 0}>
    {
      profileUrl && (
        <div class="mt-6 flex items-center gap-3 rounded-3xl bg-mint p-4 text-mint-ink">
          <Icon name="whatsapp-logo" class="h-8 w-8 shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="font-bold">{t("invite.title")}</p>
            <p class="text-sm opacity-80">{t("invite.text")}</p>
          </div>
          <button type="button" id="invite-btn" data-url={profileUrl} data-text={t("invite.message")} class="btn shrink-0 !bg-mint-ink !px-4 !py-2.5 text-sm !text-white">
            {t("invite.btn")}
          </button>
        </div>
      )
    }
    {
      suggestions.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-extrabold">{t("suggest.title")}</h2>
          <ul class="card mt-3 divide-y divide-line px-5">
            {suggestions.map((p) => (
              <PersonRow person={p} meta={p.via ? t("suggest.via", { name: firstWord(p.via) }) : tFeed("lists", { n: p.lists })}>
                <FollowButton username={p.username} relation="none" isPrivate={!!p.is_private} size="sm" />
              </PersonRow>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <!-- Shown in #search-results while a search is loading. -->
  <template id="search-skeleton">
    <ul class="card mt-8 divide-y divide-line px-5" aria-hidden="true">
      {
        [62, 48, 55].map((w) => (
          <li class="flex items-center gap-3 py-3.5">
            <span class="skeleton h-12 w-12 shrink-0 !rounded-full" />
            <span class="min-w-0 flex-1 space-y-2">
              <span class="skeleton-line h-3.5" style={`width:${w}%`} />
              <span class="skeleton-line h-3" style={`width:${w - 20}%`} />
            </span>
            <span class="skeleton h-8 w-24 shrink-0 !rounded-full" />
          </li>
        ))
      }
    </ul>
  </template>

  <div id="search-results" aria-live="polite">
    {
      q && q.length < 2 ? (
        <p class="mt-8 text-center text-sm text-ink-soft">{t("search.short")}</p>
      ) : q && results.length === 0 ? (
        <div class="card mt-6 flex flex-col items-center px-6 py-10 text-center">
          <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
            <Icon name="magnifying-glass" class="h-8 w-8" />
          </span>
          <p class="mt-4 text-sm text-ink-soft">{t("search.empty", { q })}</p>
        </div>
      ) : (
        results.length > 0 && (
          <ul class="card mt-6 divide-y divide-line px-5">
            {results.map((p) => (
              <PersonRow person={p} meta={plural(t, lang, "search.followers", p.followers)}>
                <FollowButton username={p.username!} relation={relTo(p.id)} isPrivate={!!p.is_private} size="sm" />
              </PersonRow>
            ))}
          </ul>
        )
      )
    }
  </div>

  <script>
    import "@/scripts/follow";

    // Search as you type: fetch this same page with ?q= and swap in its results.
    const form = document.getElementById("search-form") as HTMLFormElement;
    const input = document.getElementById("q") as HTMLInputElement;
    const results = document.getElementById("search-results")!;
    const spinner = document.getElementById("search-spinner")!;
    let timer: number | undefined;
    let controller: AbortController | null = null;
    let last = input.value.trim();

    // Keep the caret at the end when the page opens with a query.
    input.setSelectionRange(input.value.length, input.value.length);

    async function run() {
      const q = input.value.trim();
      if (q === last) return;
      last = q;
      controller?.abort();
      controller = new AbortController();
      const url = q ? `${location.pathname}?q=${encodeURIComponent(q)}` : location.pathname;
      history.replaceState(null, "", url);
      if (q.length < 2) {
        results.innerHTML = "";
        spinner.classList.add("hidden");
        return;
      }
      spinner.classList.remove("hidden");
      const skeleton = document.getElementById("search-skeleton") as HTMLTemplateElement | null;
      if (skeleton) results.replaceChildren(skeleton.content.cloneNode(true));
      try {
        const html = await (await fetch(url, { signal: controller.signal })).text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        results.innerHTML = doc.getElementById("search-results")?.innerHTML ?? "";
        spinner.classList.add("hidden");
      } catch (e) {
        if ((e as Error).name !== "AbortError") spinner.classList.add("hidden");
      }
    }

    // Invite: the phone's share sheet; on a computer, WhatsApp Web with the message ready.
    const invite = document.getElementById("invite-btn");
    invite?.addEventListener("click", async () => {
      const url = invite.dataset.url!;
      const text = invite.dataset.text!;
      if (navigator.share) {
        try {
          await navigator.share({ text, url });
        } catch {}
      } else {
        window.open(`https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`, "_blank", "noopener");
      }
    });

    const idle = document.getElementById("search-idle");
    input.addEventListener("input", () => {
      if (idle) idle.hidden = input.value.trim().length > 0;
      clearTimeout(timer);
      timer = window.setTimeout(run, 250);
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      clearTimeout(timer);
      run();
    });
  </script>
</Layout>
