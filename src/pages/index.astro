---
/** Home: the pitch, how it works, and a closing call to action. */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT, OG_LOCALE } from "@/lib/i18n";
import common from "@/i18n/common";
import home from "@/i18n/home";

const { lang, user } = Astro.locals;
// Signed in: the home page is the feed (birthdays and friends' new gifts).
if (user) return Astro.rewrite(localePath(lang, "/feed"));
const t = makeT(lang, common, home);
const href = (p: string) => localePath(lang, p);
// Signed-in visitors go straight to their lists instead of the sign-up flow.
const startHref = user ? href("/dashboard") : href("/register");

// Tells search engines what the site is: its name (shown above results), the logo, and a free web app.
const site = "https://wishdrop.site";
const homeUrl = site + localePath(lang, "/");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site}/#website`, name: "WishDrop", url: `${site}/`, publisher: { "@id": `${site}/#org` } },
    { "@type": "Organization", "@id": `${site}/#org`, name: "WishDrop", url: `${site}/`, logo: `${site}/apple-touch-icon.png` },
    {
      "@type": "WebApplication",
      name: "WishDrop",
      url: homeUrl,
      description: t("meta.description"),
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Web, iOS, Android",
      inLanguage: OG_LOCALE[lang].replace("_", "-"),
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      publisher: { "@id": `${site}/#org` },
    },
  ],
};

const STEPS = [
  { n: 1, icon: "list-heart", tile: "bg-accent-100 text-accent-600", title: "home.step1Title", text: "home.step1Text" },
  { n: 2, icon: "paper-plane-tilt", tile: "bg-lav text-lav-ink", title: "home.step2Title", text: "home.step2Text" },
  { n: 3, icon: "hand-heart", tile: "bg-mint text-mint-ink", title: "home.step3Title", text: "home.step3Text" },
];
---

<Layout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <!-- Left: the thesis -->
      <div class="rise-in text-center lg:text-left">
        <span class="chip bg-white !px-4 !py-2 text-sm text-accent-700 shadow-soft">
          {t("home.badge")}
        </span>
        <h1 class="mt-6 text-[2.6rem] font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
          {t("home.h1a")}<br />
          <span class="text-accent-600">{t("home.h1b")}</span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-soft lg:mx-0">{t("home.lead")}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a href={startHref} class="btn btn-primary px-7 py-4 text-base">
            {user ? t("home.goToLists") : t("home.start")}
            <Icon name="arrow-right" weight="bold" class="h-5 w-5" />
          </a>
          {
            !user && (
              <a href={href("/login")} class="btn btn-ghost px-7 py-4 text-base">
                {t("home.haveAccount")}
              </a>
            )
          }
        </div>
        <div class="mt-6 flex flex-col items-center gap-3 text-sm sm:flex-row sm:justify-center lg:justify-start">
          <span class="inline-flex items-center gap-1.5 text-ink-soft">
            <Icon name="check-circle" class="h-5 w-5 text-mint-ink" />
            {t("home.free")}
          </span>
          <a href={href("/example")} class="inline-flex items-center gap-1 font-bold text-accent-700 transition hover:underline">
            {t("home.example")}
            <Icon name="caret-right" weight="bold" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Right: a phone showing a gift list made of white cards -->
      <div class="relative mx-auto w-full max-w-[22rem] py-6" aria-hidden="true">
        <div class="absolute left-1/2 top-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-100 sm:h-96 sm:w-96"></div>

        <!-- Floating pastel tiles -->
        <span
          class="float-soft absolute -left-1 top-16 z-10 grid h-14 w-14 place-items-center rounded-2xl bg-sun text-sun-ink shadow-soft sm:-left-8"
          style="--tilt:-8deg; animation-delay:-2s;"
        >
          <Icon name="cake" class="h-7 w-7" />
        </span>
        <span
          class="float-soft absolute -right-1 top-1/2 z-10 grid h-12 w-12 place-items-center rounded-2xl bg-lav text-lav-ink shadow-soft sm:-right-8"
          style="--tilt:7deg; animation-delay:-4s;"
        >
          <Icon name="heart" class="h-6 w-6" />
        </span>
        <span class="float-soft chip absolute -left-1 bottom-0 z-10 bg-mint !px-3.5 !py-2 text-mint-ink shadow-soft sm:-left-10" style="--tilt:-4deg;">
          {t("home.reserved")}
        </span>

        <!-- Phone -->
        <div class="relative mx-auto w-[17.5rem] rounded-[2.75rem] bg-white p-2.5 shadow-lift ring-1 ring-line sm:w-[18.5rem]">
          <div class="overflow-hidden rounded-[2.25rem] bg-paper px-3.5 pb-5 pt-3">
            <div class="mx-auto h-1.5 w-16 rounded-full bg-line"></div>

            <!-- List header -->
            <div class="mt-4 flex items-center gap-3 px-1">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-accent-500 text-lg font-extrabold text-white">M</span>
              <div class="min-w-0">
                <p class="truncate text-[15px] font-extrabold leading-tight tracking-tight">{t("home.previewTitle")}</p>
                <p class="mt-0.5 truncate text-xs text-ink-soft">{t("home.previewMeta")}</p>
              </div>
            </div>

            <!-- Gifts -->
            <ul class="mt-4 grid gap-2.5">
              <li class="card flex items-center gap-3 !rounded-2xl p-2">
                <span class="relative shrink-0">
                  <img src="/demo/headphones.jpg" alt="" loading="lazy" class="h-16 w-16 rounded-xl object-cover" />
                  <span class="absolute -right-1.5 -top-1.5 grid h-6 w-6 place-items-center rounded-full bg-white text-accent-500 shadow-soft">
                    <Icon name="star" weight="fill" class="h-3.5 w-3.5" />
                  </span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-extrabold">349 lei</span>
                  <span class="btn btn-soft mt-1 !px-3 !py-1.5 text-[11px]">{t("home.reserve")}</span>
                </span>
              </li>
              <li class="card flex items-center gap-3 !rounded-2xl p-2">
                <img src="/demo/watch.jpg" alt="" loading="lazy" class="h-16 w-16 shrink-0 rounded-xl object-cover opacity-50 grayscale" />
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-extrabold text-ink/50">799 lei</span>
                  <span class="chip mt-1 max-w-full bg-mint !px-2.5 text-[11px] text-mint-ink">
                    <span class="truncate">{t("home.picked")}</span>
                  </span>
                </span>
              </li>
              <li class="card flex items-center gap-3 !rounded-2xl p-2">
                <img src="/demo/books.jpg" alt="" loading="lazy" class="h-16 w-16 shrink-0 rounded-xl object-cover" />
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-extrabold">120 lei</span>
                  <span class="btn btn-soft mt-1 !px-3 !py-1.5 text-[11px]">{t("home.reserve")}</span>
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h2 class="text-center text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.stepsTitle")}</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-3 sm:gap-5">
      {
        STEPS.map((s) => (
          <div class="card relative p-6">
            <span class="absolute right-5 top-5 grid h-8 w-8 place-items-center rounded-full bg-sand text-sm font-extrabold text-ink-soft">{s.n}</span>
            <span class:list={["grid h-14 w-14 place-items-center rounded-2xl", s.tile]}>
              <Icon name={s.icon} class="h-7 w-7" />
            </span>
            <h3 class="mt-5 text-xl font-extrabold tracking-tight">{t(s.title)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{t(s.text)}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA -->
  {
    !user && (
      <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
        <div class="rounded-[2rem] bg-accent-100 px-6 py-12 text-center sm:py-16">
          <span class="mx-auto grid h-16 w-16 place-items-center rounded-3xl bg-white text-accent-600 shadow-soft">
            <Icon name="gift" class="h-8 w-8" />
          </span>
          <h2 class="mx-auto mt-5 max-w-xl text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.ctaTitle")}</h2>
          <p class="mx-auto mt-3 max-w-md text-ink-soft">{t("home.ctaText")}</p>
          <a href={startHref} class="btn btn-primary mt-8 px-7 py-4 text-base">
            {t("home.ctaBtn")}
            <Icon name="arrow-right" weight="bold" class="h-5 w-5" />
          </a>
        </div>
      </section>
    )
  }
</Layout>
