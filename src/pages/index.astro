---
/** Home: the pitch, how it works, and a closing call to action. */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT, OG_LOCALE } from "@/lib/i18n";
import common from "@/i18n/common";
import home from "@/i18n/home";
import { db } from "@/lib/db";
import { guidePath } from "@/lib/guides";

const { lang, user } = Astro.locals;
// Signed in: the home page is the feed (birthdays and friends' new gifts).
if (user) return Astro.rewrite(localePath(lang, "/feed"));
const t = makeT(lang, common, home);
const href = (p: string) => localePath(lang, p);
// Signed-in visitors go straight to their lists instead of the sign-up flow.
const startHref = user ? href("/dashboard") : href("/register");

// Tells search engines what the site is: its name (shown above results), the logo, and a free web app.
const site = "https://wishdrop.site";
const homeUrl = site + localePath(lang, "/");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site}/#website`, name: "WishDrop", url: `${site}/`, publisher: { "@id": `${site}/#org` } },
    { "@type": "Organization", "@id": `${site}/#org`, name: "WishDrop", url: `${site}/`, logo: `${site}/apple-touch-icon.png` },
    {
      "@type": "WebApplication",
      name: "WishDrop",
      url: homeUrl,
      description: t("meta.description"),
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Web, iOS, Android",
      inLanguage: OG_LOCALE[lang].replace("_", "-"),
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      publisher: { "@id": `${site}/#org` },
    },
  ],
};

// Social proof under the buttons: real totals, rounded down ("300+"), shown once there are enough.
const totals = await db()
  .prepare("SELECT (SELECT COUNT(*) FROM wishlists) AS lists, (SELECT COUNT(*) FROM items WHERE reserved_at IS NOT NULL) AS reserved")
  .first<{ lists: number; reserved: number }>();
const roundDown = (n: number) => {
  const step = n >= 1000 ? 100 : n >= 100 ? 50 : 10;
  return `${new Intl.NumberFormat(lang).format(Math.floor(n / step) * step)}+`;
};
const proof = totals && totals.lists >= 20 ? t("home.proof", { lists: roundDown(totals.lists), reserved: roundDown(totals.reserved) }) : null;

// Occasions: a photo each (public/home, from Unsplash, see CREDITS.txt), linking to that guide.
const OCCASIONS = [
  { key: "birthday", label: "home.birthday" },
  { key: "wedding", label: "home.wedding" },
  { key: "christmas", label: "home.christmas" },
  { key: "baby", label: "home.baby" },
] as const;

const FEATURES = [
  { icon: "eye-slash", tile: "bg-lav text-lav-ink", title: "home.f1t", text: "home.f1x" },
  { icon: "users-three", tile: "bg-mint text-mint-ink", title: "home.f2t", text: "home.f2x" },
  { icon: "gift", tile: "bg-accent-100 text-accent-600", title: "home.f3t", text: "home.f3x" },
  { icon: "bell-ringing", tile: "bg-sun text-sun-ink", title: "home.f4t", text: "home.f4x" },
  { icon: "link", tile: "bg-accent-100 text-accent-600", title: "home.f5t", text: "home.f5x" },
  { icon: "fire", tile: "bg-sun text-sun-ink", title: "home.f6t", text: "home.f6x" },
];
const FAQ = [1, 2, 3, 4];

const STEPS = [
  { n: 1, icon: "list-heart", tile: "bg-accent-100 text-accent-600", title: "home.step1Title", text: "home.step1Text" },
  { n: 2, icon: "paper-plane-tilt", tile: "bg-lav text-lav-ink", title: "home.step2Title", text: "home.step2Text" },
  { n: 3, icon: "hand-heart", tile: "bg-mint text-mint-ink", title: "home.step3Title", text: "home.step3Text" },
];
---

<Layout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <!-- Left: the thesis -->
      <div class="rise-in text-center lg:text-left">
        <span class="chip bg-white !px-4 !py-2 text-sm text-accent-700 shadow-soft">
          <Icon name="gift" weight="fill" class="h-4 w-4" />
          {t("home.badge")}
        </span>
        <h1 class="mt-6 text-[2.6rem] font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
          {t("home.h1a")}<br />
          <span class="text-accent-600">{t("home.h1b")}</span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-soft lg:mx-0">{t("home.lead")}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a href={startHref} class="btn btn-primary px-7 py-4 text-base">
            {user ? t("home.goToLists") : t("home.start")}
            <Icon name="arrow-right" weight="bold" class="h-5 w-5" />
          </a>
          {
            !user && (
              <a href="/api/auth/google" class="btn btn-ghost px-6 py-4 text-base">
                <Icon name="google-logo" weight="bold" class="h-5 w-5" />
                {t("home.google")}
              </a>
            )
          }
        </div>
        {
          proof && (
            <div class="mt-5 flex items-center justify-center gap-2.5 lg:justify-start">
              <span class="flex" aria-hidden="true">
                <span class="grid h-7 w-7 place-items-center rounded-full border-2 border-paper bg-accent-500 text-white"><Icon name="gift" weight="fill" class="h-3.5 w-3.5" /></span>
                <span class="-ml-2 grid h-7 w-7 place-items-center rounded-full border-2 border-paper bg-lav text-lav-ink"><Icon name="heart" weight="fill" class="h-3.5 w-3.5" /></span>
                <span class="-ml-2 grid h-7 w-7 place-items-center rounded-full border-2 border-paper bg-mint text-mint-ink"><Icon name="check" weight="bold" class="h-3.5 w-3.5" /></span>
              </span>
              <span class="text-sm font-semibold text-ink-soft">{proof}</span>
            </div>
          )
        }
        <div class="mt-6 flex flex-col items-center gap-3 text-sm sm:flex-row sm:justify-center lg:justify-start">
          <span class="inline-flex items-center gap-1.5 text-ink-soft">
            <Icon name="check-circle" class="h-5 w-5 text-mint-ink" />
            {t("home.free")}
          </span>
          <a href={href("/example")} class="inline-flex items-center gap-1 font-bold text-accent-700 transition hover:underline">
            {t("home.example")}
            <Icon name="caret-right" weight="bold" class="h-4 w-4" />
          </a>
          {!user && <a href={href("/login")} class="font-semibold text-ink-soft transition hover:text-ink">{t("home.haveAccount")}</a>}
        </div>
      </div>

      <!-- Right: a phone showing a gift list made of white cards -->
      <div class="relative mx-auto w-full max-w-[22rem] py-6" aria-hidden="true">
        <div class="absolute left-1/2 top-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-100 sm:h-96 sm:w-96"></div>

        <!-- Floating pastel tiles -->
        <span
          class="float-soft absolute -left-1 top-16 z-10 grid h-14 w-14 place-items-center rounded-2xl bg-sun text-sun-ink shadow-soft sm:-left-8"
          style="--tilt:-8deg; animation-delay:-2s;"
        >
          <Icon name="cake" class="h-7 w-7" />
        </span>
        <span
          class="float-soft absolute -right-1 top-1/2 z-10 grid h-12 w-12 place-items-center rounded-2xl bg-lav text-lav-ink shadow-soft sm:-right-8"
          style="--tilt:7deg; animation-delay:-4s;"
        >
          <Icon name="heart" class="h-6 w-6" />
        </span>
        <span class="float-soft chip absolute -left-1 bottom-0 z-10 bg-mint !px-3.5 !py-2 text-mint-ink shadow-soft sm:-left-10" style="--tilt:-4deg;">
<Icon name="check" weight="bold" class="h-3.5 w-3.5" />
          {t("home.reserved")}
        </span>

        <!-- Phone -->
        <div class="relative mx-auto w-[17.5rem] rounded-[2.75rem] bg-white p-2.5 shadow-lift ring-1 ring-line sm:w-[18.5rem]">
          <div class="overflow-hidden rounded-[2.25rem] bg-paper px-3.5 pb-5 pt-3">
            <div class="mx-auto h-1.5 w-16 rounded-full bg-line"></div>

            <!-- List header -->
            <div class="mt-4 flex items-center gap-3 px-1">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-accent-500 text-lg font-extrabold text-white">M</span>
              <div class="min-w-0">
                <p class="truncate text-[15px] font-extrabold leading-tight tracking-tight">{t("home.previewTitle")}</p>
                <p class="mt-0.5 truncate text-xs text-ink-soft">{t("home.previewMeta")}</p>
              </div>
            </div>

            <!-- Gifts -->
            <ul class="mt-4 grid gap-2.5">
              <li class="card flex items-center gap-3 !rounded-2xl p-2">
                <span class="relative shrink-0">
                  <img src="/demo/headphones.jpg" alt="" loading="lazy" class="h-16 w-16 rounded-xl object-cover" />
                  <span class="absolute -right-1.5 -top-1.5 grid h-6 w-6 place-items-center rounded-full bg-white text-accent-500 shadow-soft">
                    <Icon name="star" weight="fill" class="h-3.5 w-3.5" />
                  </span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-extrabold">349 lei</span>
                  {/* Reserve turns into Reserved and back, showing what the app does. */}
                  <span class="demo-swap relative mt-1 inline-grid">
                    <span class="demo-a btn btn-soft !px-3 !py-1.5 text-[11px]">{t("home.reserve")}</span>
                    <span class="demo-b chip bg-mint !px-2.5 !py-1.5 text-[11px] text-mint-ink"><Icon name="check" weight="bold" class="h-3 w-3" />{t("home.reserved")}</span>
                  </span>
                </span>
              </li>
              <li class="card flex items-center gap-3 !rounded-2xl p-2">
                <img src="/demo/watch.jpg" alt="" loading="lazy" class="h-16 w-16 shrink-0 rounded-xl object-cover opacity-50 grayscale" />
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-extrabold text-ink/50">799 lei</span>
                  <span class="chip mt-1 max-w-full bg-mint !px-2.5 text-[11px] text-mint-ink">
                    <span class="truncate">{t("home.picked")}</span>
                  </span>
                </span>
              </li>
              <li class="card flex items-center gap-3 !rounded-2xl p-2">
                <img src="/demo/books.jpg" alt="" loading="lazy" class="h-16 w-16 shrink-0 rounded-xl object-cover" />
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-extrabold">120 lei</span>
                  <span class="btn btn-soft mt-1 !px-3 !py-1.5 text-[11px]">{t("home.reserve")}</span>
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Occasions: photo cards that open the matching guide -->
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-24">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.occTitle")}</h2>
      <p class="mx-auto mt-2 max-w-lg text-ink-soft">{t("home.occText")}</p>
    </div>
    <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {
        OCCASIONS.map((o) => (
          <li>
            <a href={href(guidePath(lang, o.key))} class="group relative block aspect-[4/3] overflow-hidden rounded-3xl shadow-soft">
              <picture>
                <source srcset={`/home/${o.key}.webp`} type="image/webp" />
                <img src={`/home/${o.key}.jpg`} alt="" loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              </picture>
              <span class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></span>
              <span class="absolute inset-x-0 bottom-0 p-3.5 text-white sm:p-4">
                <span class="block text-lg font-extrabold leading-tight sm:text-xl">{t(o.label)}</span>
                <span class="mt-0.5 inline-flex items-center gap-1 text-xs font-bold opacity-90">
                  {t("home.occCta")} <Icon name="arrow-right" weight="bold" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h2 class="text-center text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.stepsTitle")}</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-3 sm:gap-5">
      {
        STEPS.map((s) => (
          <div class="card relative p-6">
            <span class="absolute right-5 top-5 grid h-8 w-8 place-items-center rounded-full bg-sand text-sm font-extrabold text-ink-soft">{s.n}</span>
            <span class:list={["grid h-14 w-14 place-items-center rounded-2xl", s.tile]}>
              <Icon name={s.icon} class="h-7 w-7" />
            </span>
            <h3 class="mt-5 text-xl font-extrabold tracking-tight">{t(s.title)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{t(s.text)}</p>
            {/* A tiny piece of the app for each step. */}
            <div class="mt-5 flex h-12 items-center justify-center gap-2 rounded-2xl bg-sand/70 px-3 text-xs font-bold" aria-hidden="true">
              {s.n === 1 && (
                <>
                  <Icon name="link" class="h-4 w-4 text-accent-500" />
                  <span class="truncate text-ink-soft">{t("home.demo1")}</span>
                  <img src="/demo/headphones.jpg" alt="" class="h-8 w-8 shrink-0 rounded-lg object-cover" loading="lazy" />
                </>
              )}
              {s.n === 2 && (
                <span class="chip bg-mint !py-1.5 text-mint-ink"><Icon name="whatsapp-logo" class="h-4 w-4" />wishdrop.site/w/maria</span>
              )}
              {s.n === 3 && (
                <span class="chip bg-mint-ink !py-1.5 text-white"><Icon name="check-circle" weight="fill" class="h-4 w-4" />{t("home.demo3")}</span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- What else it does -->
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.featTitle")}</h2>
      <p class="mx-auto mt-2 max-w-lg text-ink-soft">{t("home.featText")}</p>
    </div>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
      {
        FEATURES.map((f) => (
          <li class="card flex items-start gap-4 p-5">
            <span class:list={["grid h-11 w-11 shrink-0 place-items-center rounded-2xl", f.tile]}>
              <Icon name={f.icon} class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block font-extrabold tracking-tight">{t(f.title)}</span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{t(f.text)}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Questions -->
  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-24">
    <h2 class="text-center text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.faqTitle")}</h2>
    <div class="card mt-8 divide-y divide-line px-5 sm:px-6">
      {
        FAQ.map((n) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-bold [&::-webkit-details-marker]:hidden">
              {t(`home.q${n}`)}
              <Icon name="caret-down" weight="bold" class="h-4 w-4 shrink-0 text-ink-soft transition group-open:rotate-180" />
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{t(`home.a${n}`)}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA -->
  {
    !user && (
      <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
        <div class="relative overflow-hidden rounded-[2rem] bg-accent-500 px-6 py-12 text-center text-white shadow-coral sm:py-16">
          <Icon name="gift" class="pointer-events-none absolute -left-6 -top-6 h-32 w-32 -rotate-12 text-white/10" />
          <Icon name="heart" class="pointer-events-none absolute -bottom-6 -right-4 h-28 w-28 rotate-12 text-white/10" />
          <h2 class="relative mx-auto max-w-xl text-3xl font-extrabold tracking-tight sm:text-4xl">{t("home.ctaTitle")}</h2>
          <p class="relative mx-auto mt-3 max-w-md text-white/85">{t("home.ctaText")}</p>
          <a href={startHref} class="btn relative mt-8 bg-white px-7 py-4 text-base text-accent-700 hover:bg-accent-50">
            {t("home.ctaBtn")}
            <Icon name="arrow-right" weight="bold" class="h-5 w-5" />
          </a>
        </div>
      </section>
    )
  }
</Layout>
