---
/**
 * A profile: /@username. Photo, name, bio, counts, follow button, and the lists
 * this viewer may see (see lib/social.ts). Private profiles show a lock until
 * the viewer's follow request is accepted.
 */
import Layout from "@/layouts/Layout.astro";
import Avatar from "@/components/Avatar.astro";
import FollowButton from "@/components/social/FollowButton.astro";
import ProfileListCard from "@/components/social/ProfileListCard.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { canSeeProfile, displayName, followCounts, getUserByUsername, profileLists, relation } from "@/lib/social";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, social);

const owner = await getUserByUsername(Astro.params.username ?? "");
if (!owner || !owner.username) return Astro.rewrite("/404");

const rel = await relation(user, owner);
const visible = canSeeProfile(owner, rel);
const [lists, counts] = await Promise.all([profileLists(owner, rel), followCounts(owner.id)]);
const name = displayName(owner);
const href = (p: string) => localePath(lang, p);
const profileUrl = `${Astro.url.origin}/@${owner.username}`;

const birthday = owner.birthday
  ? new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", timeZone: "UTC" }).format(new Date(owner.birthday + "T00:00:00Z"))
  : null;

const stat = (n: number, label: string, link: string | null) => ({ n, label, link });
const stats = [
  stat(lists.length, t("profile.stat.lists"), null),
  stat(counts.followers, t("profile.stat.followers"), visible ? href(`/@${owner.username}/followers`) : null),
  stat(counts.following, t("profile.stat.following"), visible ? href(`/@${owner.username}/following`) : null),
];
---

<Layout
  title={t("profile.title", { name: owner.name || owner.username, username: owner.username })}
  description={t("profile.description", { name: owner.name || `@${owner.username}` })}
  noindex={!!owner.is_private}
  mainClass="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10"
>
  <!-- Profile header -->
  <section class="card overflow-hidden">
    <div class="h-24 gift-gradient sm:h-28"></div>
    <div class="px-6 pb-6 sm:px-8">
      <div class="-mt-10 flex flex-wrap items-end justify-between gap-4">
        <div class="flex min-w-0 items-end gap-4">
          <div class="rounded-full ring-4 ring-white">
            <Avatar user={owner} size={96} class="h-24 w-24" alt={name} />
          </div>
          <div class="min-w-0 pb-1">
            <h1 class="flex items-center gap-2 truncate font-display text-2xl font-extrabold tracking-tight sm:text-3xl">
              <span class="truncate">{owner.name || `@${owner.username}`}</span>
              {
                !!owner.is_private && (
                  <span class="shrink-0 text-ink-soft/60" title={t("profile.privateBadge")}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-label={t("profile.privateBadge")}><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                  </span>
                )
              }
            </h1>
            {owner.name && <p class="truncate text-sm text-ink-soft">@{owner.username}</p>}
          </div>
        </div>
        <div class="flex items-center gap-2 pb-1">
          {
            rel === "self" ? (
              <a href={href("/settings")} class="btn btn-ghost !px-5 !py-2.5 text-sm">{t("profile.edit")}</a>
            ) : (
              <FollowButton username={owner.username} relation={rel} isPrivate={!!owner.is_private} reload />
            )
          }
          <button
            type="button"
            id="share-profile"
            data-url={profileUrl}
            data-copied={t("profile.copied")}
            aria-label={t("profile.share")}
            title={t("profile.share")}
            class="btn btn-ghost !px-3 !py-2.5"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
          </button>
        </div>
      </div>

      {owner.bio && <p class="mt-4 max-w-2xl whitespace-pre-line text-ink">{owner.bio}</p>}
      {visible && birthday && <p class="mt-2 text-sm text-ink-soft">🎂 {t("profile.birthday", { date: birthday })}</p>}

      <dl class="mt-5 flex gap-8 border-t border-black/5 pt-4">
        {
          stats.map((s) => {
            const Tag = s.link ? "a" : "div";
            return (
              <Tag href={s.link} class:list={["flex flex-col", s.link && "transition hover:text-accent-600"]}>
                <dd class="font-display text-xl font-extrabold">{s.n}</dd>
                <dt class="text-xs text-ink-soft">{s.label}</dt>
              </Tag>
            );
          })
        }
      </dl>
    </div>
  </section>

  <!-- Lists -->
  {
    !visible ? (
      <div class="card mt-8 p-10 text-center">
        <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-accent-50 text-accent-600">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
        </div>
        <h2 class="mt-4 font-display text-xl font-bold">{t("profile.private")}</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">
          {rel === "requested" ? t("profile.privateRequested") : t("profile.privateText")}
        </p>
      </div>
    ) : lists.length === 0 ? (
      <div class="card mt-8 p-10 text-center">
        <div class="text-4xl">🎁</div>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-soft">{rel === "self" ? t("profile.noListsSelf") : t("profile.noLists")}</p>
        {rel === "self" && <a href={href("/dashboard")} class="btn btn-primary mt-5 !py-2.5 text-sm">{t("profile.myLists")}</a>}
      </div>
    ) : (
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {lists.map((list) => <ProfileListCard list={list} showVisibility={rel === "self"} />)}
      </ul>
    )
  }

  <script>
    const btn = document.getElementById("share-profile");
    btn?.addEventListener("click", async () => {
      const url = btn.dataset.url!;
      if (navigator.share) {
        try {
          await navigator.share({ url });
          return;
        } catch {}
      }
      try {
        await navigator.clipboard.writeText(url);
      } catch {}
      btn.setAttribute("title", btn.dataset.copied!);
      btn.classList.add("!text-emerald-600");
      setTimeout(() => btn.classList.remove("!text-emerald-600"), 1500);
    });
  </script>
</Layout>
