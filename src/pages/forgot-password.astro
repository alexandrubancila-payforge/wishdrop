---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import auth from "@/i18n/auth";

const { lang } = Astro.locals;
const t = makeT(lang, common, auth);
---

<Layout title={t("forgot.title")} description={t("auth.description")} noindex mainClass="mx-auto flex max-w-md flex-col px-4 py-10 sm:py-16">
  <div class="card rise-in p-6 sm:p-8">
    <span class="grid h-12 w-12 place-items-center rounded-2xl bg-lav text-lav-ink" aria-hidden="true">
      <Icon name="key" class="h-6 w-6" />
    </span>
    <h1 class="mt-5 text-3xl font-extrabold tracking-tight">{t("forgot.heading")}</h1>
    <p class="mt-2 text-sm text-ink-soft">{t("forgot.intro")}</p>
    <form id="forgot-form" class="mt-7 space-y-4">
      <div>
        <label for="email" class="block text-sm font-semibold text-ink">{t("auth.email")}</label>
        <input id="email" name="email" type="email" placeholder={t("ph.email")} autocomplete="email" required class="field mt-1.5" />
      </div>
      <button type="submit" id="forgot-submit" class="btn btn-primary w-full py-3.5">
        <span data-submit-label>{t("forgot.submit")}</span>
      </button>
    </form>
    <div id="forgot-done" class="mt-6 hidden rounded-2xl bg-mint px-4 py-3.5 text-sm font-semibold text-mint-ink">
      <p class="flex items-start gap-2.5">
        <Icon name="check-circle" class="mt-px h-5 w-5 shrink-0" />
        <span>{t("forgot.done")}</span>
      </p>
    </div>
    <p class="mt-6 text-center text-sm text-ink-soft">
      <a href={localePath(lang, "/login")} class="font-semibold text-accent-700 hover:underline">{t("auth.backToLogin")}</a>
    </p>
  </div>
</Layout>

<script>
  // Always shows the same confirmation, so the form never reveals which emails have an account.
  const form = document.getElementById("forgot-form") as HTMLFormElement;
  const submit = document.getElementById("forgot-submit") as HTMLButtonElement;
  const done = document.getElementById("forgot-done")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    submit.disabled = true;
    try {
      await fetch("/api/auth/forgot-password", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email }),
      });
    } catch {}
    form.classList.add("hidden");
    done.classList.remove("hidden");
  });
</script>
