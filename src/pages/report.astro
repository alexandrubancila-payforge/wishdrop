---
/**
 * /report — "Report a problem" (?type=bug&from=/page) and "Report" on a
 * profile or list (?type=user|list&id=…). Posts to /api/report.
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/report";
import { getUserById, getWishlist } from "@/lib/db";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, strings);
const q = Astro.url.searchParams;
const type = q.get("type") === "user" || q.get("type") === "list" ? q.get("type")! : "bug";
const id = q.get("id") ?? "";
const fromRaw = q.get("from") ?? "";
const from = fromRaw.startsWith("/") && !fromRaw.startsWith("//") ? fromRaw : "";

let targetName = "";
if (type === "user") {
  const u = id ? await getUserById(id) : null;
  if (!u) return Astro.rewrite(localePath(lang, "/404"));
  targetName = u.name || (u.username ? `@${u.username}` : "");
} else if (type === "list") {
  const l = id ? await getWishlist(id) : null;
  if (!l) return Astro.rewrite(localePath(lang, "/404"));
  targetName = l.name;
}
const title = t(`${type}.title`);
const reasons = ["spam", "inappropriate", "fake", "other"];
---

<Layout title={`${title} — WishDrop`} noindex mainClass="mx-auto flex w-full max-w-lg flex-col px-4 py-8 sm:py-12">
  <form id="report-form" class="card p-6 sm:p-7" novalidate data-kind={type} data-error={t("error")} data-too-big={t("tooBig")}>
    <span class:list={["grid h-12 w-12 place-items-center rounded-2xl", type === "bug" ? "bg-lav text-lav-ink" : "bg-accent-100 text-accent-600"]}>
      <Icon name={type === "bug" ? "bug" : "flag"} class="h-6 w-6" />
    </span>
    <h1 class="mt-4 text-2xl font-extrabold tracking-tight">{title}</h1>
    {targetName && <p class="mt-1 truncate font-semibold text-ink">{targetName}</p>}
    <p class="mt-2 text-sm text-ink-soft">{type === "bug" ? t("bug.text") : t("content.text")}</p>

    <input type="hidden" name="kind" value={type} />
    <input type="hidden" name="target_id" value={id} />
    <input type="hidden" name="page_url" value={from} />
    <!-- Honeypot: hidden from people, bots fill it in. -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] h-px w-px opacity-0" aria-hidden="true" />

    {
      type !== "bug" && (
        <fieldset class="mt-5">
          <legend class="text-sm font-semibold text-ink">{t("reason")}</legend>
          <div class="mt-2 grid gap-2">
            {reasons.map((r) => (
              <label class="cursor-pointer">
                <input type="radio" name="reason" value={r} required class="peer sr-only" />
                <span class="flex items-center gap-3 rounded-2xl border-[1.5px] border-line bg-white px-3.5 py-3 text-sm font-semibold transition hover:border-accent-300 peer-checked:border-accent-500 peer-checked:bg-accent-50 peer-focus-visible:ring-4 peer-focus-visible:ring-accent-500/20">
                  {t(`reason.${r}`)}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      )
    }

    <label class="mt-5 block text-sm font-semibold text-ink" for="report-message">
      {type === "bug" ? t("bug.message") : t("details")}
      {type !== "bug" && <span class="font-normal text-ink-soft"> {t("optional")}</span>}
    </label>
    <textarea id="report-message" name="message" rows="5" maxlength="3000" class="field mt-1 resize-y" placeholder={type === "bug" ? t("bug.placeholder") : ""}></textarea>

    {
      type === "bug" && (
        <div class="mt-4">
          <label class="block text-sm font-semibold text-ink" for="report-file">{t("bug.shot")}</label>
          <input id="report-file" name="file" type="file" accept="image/*" class="mt-1 block w-full text-sm text-ink-soft file:mr-3 file:rounded-full file:border-0 file:bg-accent-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-accent-700" />
          <p class="mt-1 text-xs text-ink-soft">{t("bug.shotHint")}</p>
        </div>
      )
    }

    {
      !user && (
        <div class="mt-4">
          <label class="block text-sm font-semibold text-ink" for="report-email">{t("email")}</label>
          <input id="report-email" name="email" type="email" placeholder={t("ph.email")} maxlength="254" autocomplete="email" class="field mt-1" />
          <p class="mt-1 text-xs text-ink-soft">{t("emailHint")}</p>
        </div>
      )
    }

    <p id="report-error" class="mt-3 hidden text-sm font-medium text-rose-600"></p>
    <button type="submit" class="btn btn-primary mt-6 w-full !py-3.5">
      <Icon name="paper-plane-tilt" class="h-4 w-4" />
      {t("send")}
    </button>
  </form>

  <div id="report-done" class="card hidden flex-col items-center p-8 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-3xl bg-mint text-mint-ink">
      <Icon name="check-circle" class="h-8 w-8" />
    </span>
    <h2 class="mt-4 text-2xl font-extrabold tracking-tight">{t("sentTitle")}</h2>
    <p class="mt-2 text-sm text-ink-soft">{type === "bug" ? t("sentBug") : t("sentContent")}</p>
    <a href={from ? localePath(lang, from) : localePath(lang, "/")} class="btn btn-ghost mt-6 !px-6 !py-3 text-sm">{t("back")}</a>
  </div>

  <script>
    const form = document.getElementById("report-form") as HTMLFormElement;
    const error = document.getElementById("report-error")!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.classList.add("hidden");
      const file = form.querySelector<HTMLInputElement>('input[type="file"]')?.files?.[0];
      if (file && file.size > 5 * 1024 * 1024) {
        error.textContent = form.dataset.tooBig!;
        error.classList.remove("hidden");
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      try {
        const res = await fetch("/api/report", { method: "POST", body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || form.dataset.error);
        form.classList.add("hidden");
        document.getElementById("report-done")!.classList.replace("hidden", "flex");
      } catch (err) {
        error.textContent = err instanceof Error && err.message ? err.message : form.dataset.error!;
        error.classList.remove("hidden");
        btn.disabled = false;
      }
    });
  </script>
</Layout>
