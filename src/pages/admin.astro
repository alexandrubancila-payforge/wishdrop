---
/**
 * The owner's dashboard: totals, the last 12 weeks, new accounts and the
 * biggest lists. Only for the OWNER_EMAIL account; everyone else gets a 404.
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/admin";
import reportStrings from "@/i18n/report";
import { adminReports, isAdmin, siteStats, type ReportRow } from "@/lib/admin";
import { imageUrl } from "@/lib/storage";

const { lang, user } = Astro.locals;
if (!isAdmin(user)) return Astro.rewrite(localePath(lang, "/404"));

const t = makeT(lang, common, strings, reportStrings);
const [{ totals, weekly, recent, topLists }, reports] = await Promise.all([siteStats(), adminReports()]);
const n = (k: string) => totals[k] ?? 0;
const fmt = new Intl.NumberFormat(lang);
const day = new Intl.DateTimeFormat(lang, { day: "numeric", month: "short", timeZone: "UTC" });
const dateTime = new Intl.DateTimeFormat(lang, { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Bucharest" });

const kpis = [
  { key: "users", icon: "users", tint: "bg-accent-100 text-accent-600", total: n("users"), d7: n("users7"), d30: n("users30") },
  { key: "lists", icon: "list-heart", tint: "bg-lav text-lav-ink", total: n("lists"), d7: n("lists7"), d30: n("lists30") },
  { key: "gifts", icon: "gift", tint: "bg-sun text-sun-ink", total: n("gifts"), d7: n("gifts7"), d30: n("gifts30") },
  { key: "reserved", icon: "hand-heart", tint: "bg-mint text-mint-ink", total: n("reserved"), d7: n("reserved7"), d30: n("reserved30") },
  { key: "follows", icon: "user-plus", tint: "bg-accent-100 text-accent-600", total: n("follows"), d7: n("follows7"), d30: null },
];
const series = [
  { key: "users", bar: "bg-accent-500" },
  { key: "lists", bar: "bg-lav-ink" },
  { key: "gifts", bar: "bg-sun-ink" },
  { key: "reserved", bar: "bg-mint-ink" },
] as const;
const more = [
  { key: "usersWithLists", icon: "list-heart" },
  { key: "googleUsers", icon: "google-logo" },
  { key: "pushUsers", icon: "device-mobile" },
  { key: "reactions", icon: "heart" },
  { key: "groupGifts", icon: "users-three" },
  { key: "joins", icon: "hand-coins" },
  { key: "received", icon: "package" },
];
const KIND_TINT: Record<string, string> = { bug: "bg-lav text-lav-ink", user: "bg-accent-100 text-accent-700", list: "bg-sun text-sun-ink", photo: "bg-rose-100 text-rose-700" };
const KIND_ICON: Record<string, string> = { bug: "bug", user: "user", list: "list-heart", photo: "image" };
/** Open reports about the same profile, list or uploader share one card. */
const openGroups = [
  ...reports.open
    .reduce((m, r) => {
      // A photo report is about one photo, so photos group by the photo itself.
      const key = r.kind === "photo" ? `photo:${r.image_key ?? r.id}` : r.kind !== "bug" && r.target_id ? `${r.kind}:${r.target_id}` : r.id;
      m.set(key, [...(m.get(key) ?? []), r]);
      return m;
    }, new Map<string, ReportRow[]>())
    .values(),
];
const reasonLabel = (r: string | null) => (r ? t(`reason.${r}`) : "");
const reporterOf = (r: ReportRow) => r.reporter_name || (r.reporter_username ? `@${r.reporter_username}` : r.email || t("anon"));
const listName = (r: { owner_name: string | null; owner_username: string | null; owner_email: string }) =>
  r.owner_name || (r.owner_username ? `@${r.owner_username}` : r.owner_email.split("@")[0]);
---

<Layout title={`${t("title")} — WishDrop`} noindex mainClass="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
  <h1 class="flex items-center gap-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
    <span class="grid h-12 w-12 place-items-center rounded-2xl bg-accent-100 text-accent-600">
      <Icon name="chart-line-up" class="h-6 w-6" />
    </span>
    {t("title")}
  </h1>
  <p class="mt-2 text-ink-soft">{t("subtitle")}</p>

  <section id="reports" class="mt-8 scroll-mt-24">
    <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
      <Icon name="flag" class="h-5 w-5 text-accent-500" />
      {t("reports")}
      {openGroups.length > 0 && <span class="chip bg-accent-500 !py-0.5 text-white">{t("reportsOpen", { n: openGroups.length })}</span>}
    </h2>
    {reports.open.length > 0 && <p class="mt-1 text-sm text-ink-soft">{t("reportsHint")}</p>}
    {
      reports.open.length === 0 ? (
        <p class="card mt-3 p-5 text-sm text-ink-soft">{t("reportsEmpty")}</p>
      ) : (
        <ul class="mt-3 grid gap-3">
          {openGroups.map((g) => {
            const r = g[0];
            const reasons = [...new Set(g.map((x) => x.reason).filter(Boolean))] as string[];
            const who = r.kind === "list" ? { id: r.owner_id, name: r.owner_name, username: r.owner_username, suspended: r.owner_suspended } : { id: r.target_id, name: r.target_name, username: r.target_username, suspended: r.target_suspended };
            const whoName = who.name || (who.username ? `@${who.username}` : "—");
            const suspendBtn = r.kind !== "bug" && who.id && (
              <button type="button" class="btn btn-ghost !px-4 !py-2 text-xs !text-rose-600" data-admin-action={`/api/admin/users/${who.id}`} data-body={JSON.stringify({ suspended: !who.suspended })} data-confirm={who.suspended ? "" : t("confirmSuspend")}>
                <Icon name={who.suspended ? "arrow-counter-clockwise" : "prohibit"} class="h-3.5 w-3.5" />
                {who.suspended ? t("unsuspend") : r.kind === "list" ? t("suspendOwner") : t("suspend")}
              </button>
            );
            return (
              <li class="card overflow-hidden" data-report={r.id}>
                <div class="flex gap-4 p-4 sm:p-5">
                  <span class:list={["grid h-11 w-11 shrink-0 place-items-center rounded-2xl", KIND_TINT[r.kind]]}>
                    <Icon name={KIND_ICON[r.kind]} class="h-5 w-5" />
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-xs font-bold uppercase tracking-wide text-ink-soft">{t(`head.${r.kind}`)}</p>
                      {g.length > 1 && <span class="chip bg-accent-500 !py-0.5 text-xs text-white">{t("sameTarget", { n: g.length })}</span>}
                    </div>

                    {r.kind === "list" && !r.list_slug && <p class="mt-1 text-lg font-extrabold leading-tight text-ink-soft">{t("listGone")}</p>}
                    {r.kind === "list" && r.list_slug && (
                      <>
                        <p class="mt-1 flex flex-wrap items-center gap-2 text-lg font-extrabold leading-tight">
                          {r.list_name || "—"}
                          {r.list_hidden && <span class="chip bg-ink !py-0.5 text-xs text-white">{t("hiddenBadge")}</span>}
                          {r.list_slug && (
                            <a href={`/w/${r.list_slug}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs font-bold text-accent-700 hover:underline">
                              {t("open")} <Icon name="arrow-square-out" class="h-3.5 w-3.5" />
                            </a>
                          )}
                        </p>
                        <p class="mt-1 text-sm text-ink-soft">
                          {t("listOwner")}{" "}
                          {who.username ? <a href={localePath(lang, `/@${who.username}`)} class="font-bold text-ink hover:text-accent-700">{whoName}</a> : <span class="font-bold text-ink">{whoName}</span>}
                          {who.suspended && <span class="chip ml-2 bg-ink !py-0.5 text-xs text-white">{t("suspendedBadge")}</span>}
                        </p>
                      </>
                    )}
                    {(r.kind === "user" || r.kind === "photo") && (
                      <p class="mt-1 flex flex-wrap items-center gap-2 text-lg font-extrabold leading-tight">
                        {r.kind === "photo" && <span class="text-sm font-semibold text-ink-soft">{t("uploadedBy")}</span>}
                        {who.username ? <a href={localePath(lang, `/@${who.username}`)} class="hover:text-accent-700">{whoName}</a> : whoName}
                        {who.username && who.name && <span class="text-sm font-semibold text-ink-soft">@{who.username}</span>}
                        {who.suspended && <span class="chip bg-ink !py-0.5 text-xs text-white">{t("suspendedBadge")}</span>}
                      </p>
                    )}

                    {reasons.length > 0 && (
                      <p class="mt-3 flex flex-wrap gap-1.5">
                        {reasons.map((reason) => (
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1 text-xs">
                            <Icon name="warning" class="h-3.5 w-3.5 text-accent-600" />
                            <span class="text-ink-soft">{t("reasonIs")}:</span>
                            <span class="font-bold">{reasonLabel(reason)}</span>
                          </span>
                        ))}
                      </p>
                    )}
                    {r.kind === "bug" && (r.page_url || r.user_agent) && (
                      <p class="mt-2 break-all text-xs text-ink-soft">
                        {r.page_url && <span class="block">{r.page_url}</span>}
                        {r.user_agent}
                      </p>
                    )}

                    <ul class="mt-3 space-y-2">
                      {g.map((x) => (
                        <li>
                          {x.message && <p class="whitespace-pre-line rounded-xl border-l-4 border-line bg-sand/60 px-3 py-2 text-sm text-ink">{x.message}</p>}
                          {x.image_key && (
                            <a href={imageUrl(x.image_key)} target="_blank" rel="noopener" class="mt-2 inline-block">
                              <img src={imageUrl(x.image_key)} alt={t("screenshot")} class="max-h-48 rounded-xl ring-1 ring-line" />
                            </a>
                          )}
                          <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-soft">
                            <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" />{dateTime.format(x.created_at)}</span>
                            <span>{t("reportedBy", { who: reporterOf(x) })}</span>
                            {x.email && (
                              <a href={`mailto:${x.email}`} class="inline-flex items-center gap-1 font-bold text-accent-700 hover:underline" title={x.email}>
                                <Icon name="envelope-simple" class="h-3.5 w-3.5" /> {t("writeTo")}
                              </a>
                            )}
                          </p>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 border-t border-line bg-sand/40 px-4 py-3 sm:px-5">
                  {r.kind === "list" && r.list_slug && r.target_id && (
                    <button type="button" class="btn btn-ghost !px-4 !py-2 text-xs !text-rose-600" data-admin-action={`/api/admin/lists/${r.target_id}`} data-body={JSON.stringify({ hidden: !r.list_hidden })} data-confirm={r.list_hidden ? "" : t("confirmHide")}>
                      <Icon name={r.list_hidden ? "arrow-counter-clockwise" : "eye-slash"} class="h-3.5 w-3.5" />
                      {r.list_hidden ? t("unhide") : t("hide")}
                    </button>
                  )}
                  {r.kind === "photo" && r.image_key && (
                    <button type="button" class="btn btn-ghost !px-4 !py-2 text-xs !text-rose-600" data-admin-action="/api/admin/photos/delete" data-body={JSON.stringify({ key: r.image_key, report: r.id })} data-confirm={t("confirmRemovePhoto")}>
                      <Icon name="trash" class="h-3.5 w-3.5" /> {t("removePhoto")}
                    </button>
                  )}
                  {suspendBtn}
                  <button type="button" class="btn btn-primary ml-auto !px-4 !py-2 text-xs" data-admin-action={`/api/admin/reports/${r.id}`} data-body='{"status":"done"}'>
                    <Icon name="check" weight="bold" class="h-3.5 w-3.5" /> {t("markDone")}
                  </button>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
    {
      reports.done.length > 0 && (
        <details class="mt-3">
          <summary class="cursor-pointer text-sm font-bold text-ink-soft">{t("reportsDone")} ({reports.done.length})</summary>
          <ul class="card mt-2 divide-y divide-line px-4">
            {reports.done.map((r) => (
              <li class="flex flex-wrap items-center gap-2 py-3 text-sm">
                <span class:list={["chip text-xs", KIND_TINT[r.kind]]}>{t(`kind.${r.kind}`)}</span>
                <span class="min-w-0 flex-1 truncate">{r.list_name || r.target_name || (r.target_username && `@${r.target_username}`) || r.message}</span>
                {r.target_suspended && <span class="chip bg-ink text-xs text-white">{t("suspendedBadge")}</span>}
                {r.list_hidden && <span class="chip bg-ink text-xs text-white">{t("hiddenBadge")}</span>}
                {r.kind === "user" && r.target_suspended && (
                  <button type="button" class="text-xs font-bold text-accent-700 hover:underline" data-admin-action={`/api/admin/users/${r.target_id}`} data-body='{"suspended":false}'>{t("unsuspend")}</button>
                )}
                {r.kind === "list" && r.list_hidden && (
                  <button type="button" class="text-xs font-bold text-accent-700 hover:underline" data-admin-action={`/api/admin/lists/${r.target_id}`} data-body='{"hidden":false}'>{t("unhide")}</button>
                )}
                <button type="button" class="text-xs font-bold text-ink-soft hover:underline" data-admin-action={`/api/admin/reports/${r.id}`} data-body='{"status":"open"}'>{t("reopen")}</button>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </section>

  <section class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-5">
    {
      kpis.map((k) => (
        <div class="card p-4 sm:p-5">
          <div class="flex items-center gap-2">
            <span class:list={["grid h-9 w-9 place-items-center rounded-xl", k.tint]}>
              <Icon name={k.icon} class="h-5 w-5" />
            </span>
            <span class="text-sm font-bold text-ink-soft">{t(k.key)}</span>
          </div>
          <p class="mt-3 text-3xl font-extrabold tabular-nums tracking-tight">{fmt.format(k.total)}</p>
          <p class:list={["mt-1 text-xs font-semibold", k.d7 ? "text-mint-ink" : "text-ink-soft"]}>{t("week", { n: fmt.format(k.d7) })}</p>
          {k.d30 !== null && <p class="text-xs text-ink-soft">{t("month", { n: fmt.format(k.d30) })}</p>}
        </div>
      ))
    }
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-extrabold tracking-tight">{t("weekly")}</h2>
    <p class="text-sm text-ink-soft">{t("weeklyText")}</p>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 sm:gap-4">
      {
        series.map((s) => {
          const values = weekly.map((w) => w[s.key]);
          const max = Math.max(1, ...values);
          const sum = values.reduce((a, b) => a + b, 0);
          return (
            <div class="card p-4 sm:p-5">
              <div class="flex items-baseline justify-between gap-2">
                <p class="font-bold">{t(`series.${s.key}`)}</p>
                <p class="text-sm font-extrabold tabular-nums">{fmt.format(sum)}</p>
              </div>
              <div class="mt-4 flex h-32 items-end gap-1.5" role="img" aria-label={`${t(`series.${s.key}`)}: ${values.join(", ")}`}>
                {weekly.map((w) => (
                  <div class="group relative flex h-full flex-1 flex-col justify-end">
                    <span class="pointer-events-none absolute -top-1 left-1/2 z-10 hidden -translate-x-1/2 -translate-y-full whitespace-nowrap rounded-lg bg-ink px-2 py-1 text-xs font-bold text-white group-hover:block">
                      {day.format(w.start)}: {w[s.key]}
                    </span>
                    <div
                      class:list={["w-full rounded-t-md", w[s.key] ? s.bar : "bg-sand"]}
                      style={`height:${w[s.key] ? Math.max(6, (w[s.key] / max) * 100) : 4}%`}
                    />
                  </div>
                ))}
              </div>
              <div class="mt-2 flex justify-between text-[11px] font-medium text-ink-soft">
                <span>{day.format(weekly[0].start)}</span>
                <span>{day.format(weekly[weekly.length - 1].start)}</span>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-extrabold tracking-tight">{t("more")}</h2>
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
      {
        more.map((m) => (
          <div class="card p-4">
            <Icon name={m.icon} class="h-5 w-5 text-accent-500" />
            <p class="mt-2 text-2xl font-extrabold tabular-nums">{fmt.format(n(m.key))}</p>
            <p class="mt-0.5 text-xs leading-snug text-ink-soft">{t(m.key)}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section>
      <h2 class="text-lg font-extrabold tracking-tight">{t("recent")}</h2>
      <ul class="card mt-3 divide-y divide-line px-4 sm:px-5">
        {
          recent.map((u) => (
            <li class="flex items-center gap-3 py-3">
              <Avatar user={u} size={40} class="h-10 w-10" />
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-bold">
                  {u.username ? <a href={localePath(lang, `/@${u.username}`)} class="hover:text-accent-700">{u.name || `@${u.username}`}</a> : u.name || "—"}
                  {!!u.google && <Icon name="google-logo" class="ml-1 inline h-3.5 w-3.5 text-ink-soft" />}
                </p>
                <p class="truncate text-xs text-ink-soft">{u.email}</p>
              </div>
              <div class="shrink-0 text-right text-xs text-ink-soft">
                <p class="font-semibold text-ink">{t("listsShort", { n: u.lists })} · {t("giftsShort", { n: u.gifts })}</p>
                <p>{dateTime.format(u.created_at)}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h2 class="text-lg font-extrabold tracking-tight">{t("topLists")}</h2>
      <ul class="card mt-3 divide-y divide-line px-4 sm:px-5">
        {
          topLists.map((l) => (
            <li class="flex items-center gap-3 py-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-lav text-lav-ink">
                <Icon name={l.visibility === "link" ? "link" : l.visibility === "followers" ? "users" : "globe"} class="h-5 w-5" />
              </span>
              <div class="min-w-0 flex-1">
                <a href={`/w/${l.slug}`} class="block truncate text-sm font-bold hover:text-accent-700">{l.name}</a>
                <p class="truncate text-xs text-ink-soft">{listName(l)}</p>
              </div>
              <p class="shrink-0 text-right text-xs text-ink-soft">
                <span class="block font-semibold text-ink">{t("giftsShort", { n: l.gifts })}</span>
                {t("reservedShort", { n: l.reserved ?? 0 })}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
  <script>
    // Moderation buttons: POST the button's body, then reload.
    document.querySelectorAll<HTMLButtonElement>("[data-admin-action]").forEach((b) => {
      b.addEventListener("click", async () => {
        if (b.dataset.confirm) {
          const ask = (window as any).wdConfirm as ((m: string) => Promise<boolean>) | undefined;
          if (!(ask ? await ask(b.dataset.confirm) : confirm(b.dataset.confirm))) return;
        }
        b.disabled = true;
        const res = await fetch(b.dataset.adminAction!, { method: "POST", headers: { "content-type": "application/json" }, body: b.dataset.body });
        if (res.ok) location.reload();
        else b.disabled = false;
      });
    });
  </script>
</Layout>
