---
/** Contact details and a message form (POST /api/contact → email to OWNER_EMAIL). */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { makeT, pick } from "@/lib/i18n";
import common from "@/i18n/common";
import contact from "@/i18n/contact";

const t = makeT(Astro.locals.lang, common, contact);
const CONTACT_EMAIL = "contact@wishdrop.site";

// Strings for the form script below.
const f = pick(t, {
  heading: "cf.heading",
  name: "cf.name",
  email: "cf.email",
  message: "cf.message",
  send: "cf.send",
  sending: "cf.sending",
  sent: "cf.sent",
  error: "cf.error",
  errName: "cf.errName",
  errEmail: "cf.errEmail",
  errMessage: "cf.errMessage",
});
---

<Layout title={t("contact.title")} description={t("contact.intro")} mainClass="mx-auto max-w-2xl px-4 py-10 sm:px-6 sm:py-14">
  <header class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("contact.h1")}</h1>
      <p class="mt-3 leading-relaxed text-ink-soft">{t("contact.intro")}</p>
    </div>
    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent-100 text-accent-600">
      <Icon name="chat-circle-dots" class="h-7 w-7" />
    </span>
  </header>

  <dl class="mt-8 grid gap-3">
    <div class="card relative py-4 pl-[4.75rem] pr-5">
      <dt class="text-sm font-semibold text-ink-soft">
        <span class="absolute left-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-2xl bg-accent-100 text-accent-600" aria-hidden="true">
          <Icon name="envelope-simple" class="h-6 w-6" />
        </span>
        {t("contact.email")}
      </dt>
      <dd class="mt-0.5 min-w-0">
        <a href={`mailto:${CONTACT_EMAIL}`} class="break-all text-lg font-extrabold text-accent-700 hover:underline">{CONTACT_EMAIL}</a>
      </dd>
    </div>
    <div class="card relative py-4 pl-[4.75rem] pr-5">
      <dt class="text-sm font-semibold text-ink-soft">
        <span class="absolute left-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-2xl bg-lav text-lav-ink" aria-hidden="true">
          <Icon name="hand-heart" class="h-6 w-6" />
        </span>
        {t("contact.madeBy")}
      </dt>
      <dd class="mt-0.5">
        <a href="https://banstudio.dev/" target="_blank" rel="noopener" class="text-lg font-extrabold text-accent-700 hover:underline">Ban Studio</a>
      </dd>
    </div>
    <div class="card relative py-4 pl-[4.75rem] pr-5">
      <dt class="text-sm font-semibold text-ink-soft">
        <span class="absolute left-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-2xl bg-sun text-sun-ink" aria-hidden="true">
          <Icon name="map-pin" class="h-6 w-6" />
        </span>
        {t("contact.location")}
      </dt>
      <dd class="mt-0.5 text-lg font-extrabold text-ink">{t("contact.country")}</dd>
    </div>
  </dl>
  <p class="mt-4 flex items-center gap-1.5 text-sm text-ink-soft">
    <Icon name="clock" class="h-4 w-4 shrink-0" />
    {t("contact.reply")}
  </p>

  <form id="contact-form" class="card mt-8 p-5 sm:p-6" novalidate>
    <h2 class="flex items-center gap-2 text-lg font-extrabold">
      <Icon name="paper-plane-tilt" class="h-5 w-5 text-accent-500" />
      {f.heading}
    </h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <label for="cf-name" class="block text-sm font-semibold text-ink">{f.name}</label>
        <input id="cf-name" name="name" type="text" placeholder={t("ph.name")} required maxlength="100" class="field mt-1.5" aria-describedby="cf-name-err" />
        <p id="cf-name-err" class="mt-1 hidden text-xs font-medium text-rose-600"></p>
      </div>
      <div>
        <label for="cf-email" class="block text-sm font-semibold text-ink">{f.email}</label>
        <input id="cf-email" name="email" type="email" placeholder={t("ph.email")} required maxlength="200" class="field mt-1.5" aria-describedby="cf-email-err" />
        <p id="cf-email-err" class="mt-1 hidden text-xs font-medium text-rose-600"></p>
      </div>
    </div>
    <div class="mt-4">
      <label for="cf-message" class="block text-sm font-semibold text-ink">{f.message}</label>
      <textarea
        id="cf-message"
        name="message" placeholder={t("ph.message")}
        rows="5"
        required
        minlength="10"
        maxlength="4000"
        class="field mt-1.5 resize-y"
        aria-describedby="cf-message-err"></textarea>
      <p id="cf-message-err" class="mt-1 hidden text-xs font-medium text-rose-600"></p>
    </div>
    <!-- Honeypot: hidden from people, bots fill it in. -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <p id="cf-status" class="mt-3 hidden text-sm font-medium"></p>
    <div class="mt-5 flex justify-end">
      <button type="submit" id="cf-submit" class="btn btn-primary w-full !py-3.5 sm:w-auto">
        <span data-submit-label>{f.send}</span>
      </button>
    </div>
  </form>

  <script is:inline define:vars={{ f }}>
  const form = document.getElementById("contact-form");
  const btn = document.getElementById("cf-submit");
  const label = form.querySelector("[data-submit-label]");
  const status = document.getElementById("cf-status");

  const fields = {
    name: {
      el: document.getElementById("cf-name"),
      err: document.getElementById("cf-name-err"),
      validate: (v) => (v.trim().length >= 1 ? "" : f.errName),
    },
    email: {
      el: document.getElementById("cf-email"),
      err: document.getElementById("cf-email-err"),
      validate: (v) => (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.trim()) ? "" : f.errEmail),
    },
    message: {
      el: document.getElementById("cf-message"),
      err: document.getElementById("cf-message-err"),
      validate: (v) => (v.trim().length >= 10 ? "" : f.errMessage),
    },
  };

  function showFieldError(field, msg) {
    field.err.textContent = msg;
    field.err.classList.toggle("hidden", !msg);
    field.el.classList.toggle("ring-2", !!msg);
    field.el.classList.toggle("ring-rose-400", !!msg);
  }

  function setStatus(msg, ok) {
    status.textContent = msg;
    status.className = "mt-3 text-sm font-medium " + (ok ? "text-mint-ink" : "text-rose-600");
    status.classList.remove("hidden");
  }

  // Clear a field's error as soon as the user fixes it.
  Object.values(fields).forEach((field) => {
    field.el.addEventListener("input", () => {
      if (!field.err.classList.contains("hidden") && !field.validate(field.el.value)) {
        showFieldError(field, "");
      }
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.classList.add("hidden");

    // Validate every field; collect the first invalid one to focus.
    let firstInvalid = null;
    for (const field of Object.values(fields)) {
      const msg = field.validate(field.el.value);
      showFieldError(field, msg);
      if (msg && !firstInvalid) firstInvalid = field.el;
    }
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    const data = {
      name: fields.name.el.value.trim(),
      email: fields.email.el.value.trim(),
      message: fields.message.el.value.trim(),
      company: form.company.value,
    };

    btn.disabled = true;
    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error();
      setStatus(f.sent, true);
      form.reset();
    } catch {
      setStatus(f.error, false);
    } finally {
      btn.disabled = false;
      label.textContent = f.send;
    }
  });
</script>
</Layout>
