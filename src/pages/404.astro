---
/** Not found — for unknown pages and for list links that no longer exist. */
import Layout from "@/layouts/Layout.astro";
import { localePath, makeT, type Bundle } from "@/lib/i18n";
import common from "@/i18n/common";

const strings = {
  ro: { title: "Pagina nu a fost găsită", text: "Linkul poate fi greșit sau lista a fost ștearsă.", home: "Mergi la prima pagină" },
  en: { title: "Page not found", text: "The link may be wrong, or the list was deleted.", home: "Go to the home page" },
  de: { title: "Seite nicht gefunden", text: "Der Link ist vielleicht falsch oder die Liste wurde gelöscht.", home: "Zur Startseite" },
  ru: { title: "Страница не найдена", text: "Возможно, ссылка неверна или список был удалён.", home: "На главную" },
} satisfies Bundle;

const { lang } = Astro.locals;
const t = makeT(lang, common, strings);
Astro.response.status = 404;
---

<Layout title={`${t("title")} — WishDrop`} noindex mainClass="mx-auto flex max-w-md flex-col items-center px-4 py-20 text-center sm:py-28">
  <div class="text-6xl" aria-hidden="true">🎁</div>
  <p class="mt-6 font-display text-sm font-bold uppercase tracking-widest text-accent-600">404</p>
  <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{t("title")}</h1>
  <p class="mt-3 text-ink-soft">{t("text")}</p>
  <a href={localePath(lang, "/")} class="btn btn-primary mt-8">{t("home")}</a>
</Layout>
