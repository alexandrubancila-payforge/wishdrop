---
/** Not found — for unknown pages and for list links that no longer exist. */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT, type Bundle } from "@/lib/i18n";
import common from "@/i18n/common";

const strings = {
  ro: { title: "Pagina nu a fost găsită", text: "Linkul poate fi greșit sau lista a fost ștearsă.", home: "Mergi la prima pagină" },
  en: { title: "Page not found", text: "The link may be wrong, or the list was deleted.", home: "Go to the home page" },
  de: { title: "Seite nicht gefunden", text: "Der Link ist vielleicht falsch oder die Liste wurde gelöscht.", home: "Zur Startseite" },
  ru: { title: "Страница не найдена", text: "Возможно, ссылка неверна или список был удалён.", home: "На главную" },
} satisfies Bundle;

const { lang } = Astro.locals;
const t = makeT(lang, common, strings);
Astro.response.status = 404;
---

<Layout title={`${t("title")} — WishDrop`} noindex mainClass="mx-auto flex max-w-md flex-col px-4 py-14 sm:py-24">
  <div class="card rise-in flex flex-col items-center px-6 py-10 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600" aria-hidden="true">
      <Icon name="gift" class="h-8 w-8" />
    </span>
    <p class="chip mt-5 bg-sun text-sun-ink">404</p>
    <h1 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">{t("title")}</h1>
    <p class="mt-2 text-sm text-ink-soft">{t("text")}</p>
    <a href={localePath(lang, "/")} class="btn btn-primary mt-6 !py-3 text-sm">
      <Icon name="house" class="h-4 w-4" />
      {t("home")}
    </a>
  </div>
</Layout>
