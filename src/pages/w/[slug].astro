---
/**
 * A public wishlist: anyone with the link can see it; reserving a gift or
 * joining a group gift needs an account (guests get a sign-in prompt that
 * brings them back with ?reserve=<item id>, which reopens the dialog).
 *
 * - The owner sees "← Manage list"; in surprise mode (wishlists.hide_reservations)
 *   reservations are hidden from them until they press "Reveal".
 * - Whoever reserved a gift can cancel it: by the token kept on their device
 *   (localStorage "wd_resv"), or by account when signed in.
 * - Group gifts (items.group_size): people join instead of reserving; the
 *   join token is kept in localStorage "wd_join".
 * - Signed-in visitors react to gifts (❤️ / "I want it too").
 * - Gifts the owner ticked as received are not shown.
 * - The site header is hidden here, as on the live site: the list is the page.
 */
import Layout from "@/layouts/Layout.astro";
import HeroArt from "@/components/list/HeroArt.astro";
import GuestCta from "@/components/list/GuestCta.astro";
import SeasonGreeting from "@/components/list/SeasonGreeting.astro";
import Avatar from "@/components/Avatar.astro";
import GiftArt from "@/components/gifts/GiftArt.astro";
import AdultCover from "@/components/gifts/AdultCover.astro";
import { isAdultGift } from "@/lib/adult";
import Icon from "@/components/Icon.astro";
import Reactions from "@/components/gifts/Reactions.astro";
import { localePath, makeT, pick } from "@/lib/i18n";
import { getItems, getUserById, getWishlistBySlug } from "@/lib/db";
import { contributorsFor, reactionsFor } from "@/lib/gifts";
import { plural } from "@/components/dashboard/plural";
import { imageUrl } from "@/lib/storage";
import common from "@/i18n/common";
import publiclist from "@/i18n/publiclist";
import social from "@/i18n/social";
import gifts from "@/i18n/gifts";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, publiclist, social, gifts);

const found = await getWishlistBySlug(Astro.params.slug ?? "");
const foundOwner = found ? await getUserById(found.user_id) : null;
// A list hidden in /admin, or of a suspended account, is "not found" for everyone but its owner.
const gone = !!found && user?.id !== found.user_id && (!!found.hidden_at || !!foundOwner?.suspended_at);
const list = gone ? null : found;
if (!list) Astro.response.status = 404;

const owner = list ? foundOwner : null;
const items = list ? (await getItems(list.id)).filter((i) => !i.received_at) : [];
const isOwner = !!user && !!list && user.id === list.user_id;
const [contributors, reactions] = list
  ? await Promise.all([contributorsFor(list.id), reactionsFor(items.map((i) => i.id), user?.id ?? null)])
  : [new Map(), new Map()];
const reactMode = isOwner ? "readonly" : user ? "react" : "login";
const loginHref = list ? `${localePath(lang, "/login")}?next=${encodeURIComponent(`/w/${list.slug}`)}` : "/login";
const surprise = isOwner && !!list?.hide_reservations;
const available = items.filter((i) => !i.reserved_at).length;

const host = (url: string | null) => {
  if (!url) return "";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};

const RM = {
  ...pick(t, {
    confirm: "modal.confirm",
    reveal: "list.reveal",
    hide: "list.hide",
    conflict: "js.conflict",
    fail: "js.fail",
    err: "js.err",
    cancelFail: "js.cancelFail",
    title: "modal.title",
    text: "modal.text",
    nameQuestion: "modal.nameQuestion",
    joinTitle: "group.joinTitle",
    joinText: "group.joinText",
    joinNameQuestion: "group.nameQuestion",
    joinConfirm: "group.confirm",
    progress: "group.progress",
    leaveFail: "group.leaveFail",
  }),
  isLoggedIn: !!user,
  /** Prefill for "show my name": the signed-in user's profile name. */
  myName: user ? (user.name || user.username || "").trim().slice(0, 60) : "",
  registerUrl: localePath(lang, "/register"),
  loginUrl: localePath(lang, "/login"),
  /** This list's path without the language prefix, for ?next= after signing in. */
  listPath: list ? `/w/${list.slug}` : "",
};

// Countdown to the list's event (hidden once it's past).
const eventDays = list?.event_date
  ? Math.round((Date.parse(list.event_date + "T00:00:00Z") - Date.UTC(new Date().getUTCFullYear(), new Date().getUTCMonth(), new Date().getUTCDate())) / 86_400_000)
  : null;
const eventLabel =
  eventDays === null || eventDays < 0
    ? null
    : `${new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", timeZone: "UTC" }).format(new Date(list!.event_date + "T00:00:00Z"))} · ${
        eventDays === 0 ? t("event.today") : eventDays === 1 ? t("event.tomorrow") : plural(t, lang, "event.in", eventDays)
      }`;

const ownerName = owner ? owner.name || (owner.username ? `@${owner.username}` : "") : "";
---

{
  !list ? (
    <Layout title={t("notFound.title")} description={t("list.description")} noindex mainClass="mx-auto flex max-w-md flex-col px-4 py-14 sm:py-20">
      <div class="card rise-in flex flex-col items-center p-8 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
          <Icon name="gift" class="h-8 w-8" />
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight">{t("notFound.heading")}</h1>
        <p class="mt-2 text-sm text-ink-soft">{t("notFound.text")}</p>
        <a href={localePath(lang, "/")} class="btn btn-primary mt-6 w-full !py-3">
          {t("notFound.button")}
        </a>
      </div>
    </Layout>
  ) : (
    <Layout
      title={`${list.name} — WishDrop`}
      description={t("list.description")}
      noindex
      header={false}
      tabbar={false}
      mainClass="relative z-10 mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-8"
    >
      <header class="relative">
        <HeroArt />
        <!-- Top row: logo left · seasonal greeting right -->
        <div class="relative z-10 flex items-center justify-between gap-3">
          <div class="flex shrink-0 items-center gap-3">
            {/* Back to where you came from on this site, otherwise home (the feed when signed in). */}
            <a
              href={localePath(lang, "/")}
              data-back
              aria-label={t("list.back")}
              title={t("list.back")}
              class="grid h-10 w-10 place-items-center rounded-full bg-white text-ink shadow-soft transition hover:text-accent-700"
            >
              <Icon name="caret-left" weight="bold" class="h-5 w-5" />
            </a>
            <a href={localePath(lang, "/")} class="flex items-center gap-2 text-base font-extrabold tracking-tight text-ink">
              <span class="grid h-8 w-8 place-items-center rounded-xl bg-accent-500 text-white shadow-coral">
                <Icon name="gift" weight="fill" class="h-4 w-4" />
              </span>
              <span>Wish<span class="text-accent-600">Drop</span></span>
            </a>
          </div>
          {owner && !owner.disable_seasons && <SeasonGreeting lang={lang} birthday={owner.birthday} />}
        </div>

        <div class="relative z-10 mt-8 sm:mt-10 sm:max-w-[60%]">
          <h1 class="break-words text-4xl font-extrabold tracking-tight sm:text-5xl">{list.name}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {
              owner && ownerName && (owner.username ? (
                <a
                  href={localePath(lang, `/@${owner.username}`)}
                  title={t("list.ownerProfile", { username: owner.username })}
                  class="chip bg-white !py-1 !pl-1 !pr-3 text-sm text-ink shadow-soft transition hover:text-accent-700"
                >
                  <Avatar user={owner} size={24} class="h-6 w-6" />
                  {ownerName}
                </a>
              ) : (
                <span class="chip bg-white !py-1 !pl-1 !pr-3 text-sm text-ink shadow-soft">
                  <Avatar user={owner} size={24} class="h-6 w-6" />
                  {ownerName}
                </span>
              ))
            }
            {
              eventLabel && (
                <span class:list={["chip !py-1.5", eventDays === 0 ? "bg-accent-500 text-white" : "bg-lav text-lav-ink"]}>
                  <Icon name="calendar-blank" weight="bold" class="h-3.5 w-3.5" />
                  {eventLabel}
                </span>
              )
            }
            {
              items.length > 0 && !surprise && (
                <span class="chip bg-sun !py-1.5 text-sun-ink">
                  <Icon name="gift" weight="bold" class="h-3.5 w-3.5" />
                  {t("list.available", { available, total: items.length })}
                </span>
              )
            }
          </div>
          <p class="mt-4 max-w-md text-ink-soft">{isOwner ? t("list.ownerSubtitle") : t("list.subtitle")}</p>
          {isOwner && list.hidden_at && (
            <p class="mt-3 flex max-w-md items-start gap-2 rounded-2xl bg-sun px-3 py-2 text-sm font-medium text-sun-ink">
              <Icon name="eye-slash" class="mt-0.5 h-4 w-4 shrink-0" />
              {t("list.hiddenByAdmin")}
            </p>
          )}
          {
            isOwner && (
              <div class="mt-5 flex flex-wrap items-center gap-2.5">
                <a href={localePath(lang, `/dashboard/${list.id}`)} class="btn btn-ghost !px-4 !py-2.5 text-sm">
                  {t("list.manage")}
                </a>
                {surprise && (
                  <button id="reveal-btn" type="button" data-revealed="false" class="btn btn-ghost !px-4 !py-2.5 text-sm">
                    {t("list.reveal")}
                  </button>
                )}
              </div>
            )
          }
        </div>
      </header>

      {
        items.length === 0 ? (
          <div class="card mt-8 flex flex-col items-center px-6 py-10 text-center">
            <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
              <Icon name="gift" class="h-8 w-8" />
            </span>
            <p class="mt-4 text-ink-soft">{t("list.empty")}</p>
            {isOwner && (
              <a href={localePath(lang, `/dashboard/${list.id}`)} class="btn btn-primary mt-5 !px-5 !py-3 text-sm">
                {t("list.emptyOwner")}
              </a>
            )}
          </div>
        ) : (
          <div
            id="items-grid"
            data-surprise={surprise ? "on" : "off"}
            data-owner={isOwner ? "true" : "false"}
            class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3"
          >
            {items.map((item) => {
              const reserved = !!item.reserved_at;
              const group = contributors.get(item.id) ?? [];
              const named = group.filter((c) => c.name).map((c) => c.name!);
              const mine = !!user && !!item.reserver_user_id && item.reserver_user_id === user.id;
              const img = imageUrl(item.image_key);
              const site = host(item.product_url);
              const adult = !isOwner && isAdultGift(item);
              const Wrapper = item.product_url ? "a" : "div";
              const wrapperProps = item.product_url
                ? { href: item.product_url, target: "_blank", rel: "noopener noreferrer", title: t("list.openProduct") }
                : {};
              return (
                <article
                  class:list={["card group relative flex flex-col !rounded-3xl p-2 transition duration-200 hover:-translate-y-1 hover:shadow-lift", adult && "adult-gift"]}
                  data-item-id={item.id}
                  data-reserved={reserved ? "true" : "false"}
                  data-my-reservation={mine ? "true" : "false"}
                  data-price={item.price ?? ""}
                  data-product-url={item.product_url ?? ""}
                  data-image-url={img}
                  data-group-size={item.group_size ?? ""}
                  data-my-join={group.some((c) => user && c.user_id === user.id) ? "true" : "false"}
                >
                  <Wrapper class="relative block aspect-square overflow-hidden rounded-2xl bg-sand" {...wrapperProps}>
                    {adult && <AdultCover />}
                    {img ? (
                      <img
                        src={img}
                        alt={item.title || (item.price ? `${t("list.giftAlt")} — ${item.price}` : t("list.giftAlt"))}
                        loading="lazy"
                        class:list={[
                          "h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]",
                          { "opacity-50 grayscale": reserved },
                        ]}
                        data-card-img
                      />
                    ) : (
                      <GiftArt id={item.id} title={item.title} host={site} size="lg" class={reserved && "opacity-50 grayscale"} data-card-img />
                    )}
                    {(item.priority < 0 || item.group_size) && (
                      <span class="absolute left-2 top-2 flex flex-col items-start gap-1">
                        {item.group_size && (
                          <span class="chip bg-white/95 text-mint-ink shadow-soft">
                            <Icon name="users-three" weight="bold" class="h-3.5 w-3.5" />
                            {t("group.badge")}
                          </span>
                        )}
                        {item.priority < 0 && (
                          <span class="chip bg-white/95 text-sun-ink shadow-soft">
                            <Icon name="lightbulb" weight="bold" class="h-3.5 w-3.5" />
                            {t("prio.short.-1")}
                          </span>
                        )}
                      </span>
                    )}
                  </Wrapper>
                  {/* "Most wanted" star — kept OUTSIDE the image link so tapping it never navigates. Indicator for visitors. */}
                  {item.priority > 0 ? (
                    <span
                      class="absolute right-4 top-4 z-10 grid h-9 w-9 place-items-center rounded-full bg-white text-accent-500 shadow-soft"
                      title={t("list.mostWanted")}
                    >
                      <Icon name="star" weight="fill" class="h-5 w-5" label={t("list.mostWanted")} />
                    </span>
                  ) : null}
                  <div class="flex flex-1 flex-col px-1.5 pb-1 pt-3">
                    <div class="min-w-0 px-0.5">
                      {item.title && <p class="adult-text line-clamp-2 text-sm font-bold leading-snug text-ink">{item.title}</p>}
                      {item.price ? (
                        <>
                          <p class="line-clamp-2 break-words text-xl font-extrabold tracking-tight">{item.price}</p>
                          {site && <p class="adult-text mt-0.5 truncate text-xs font-medium text-ink-soft">{site}</p>}
                        </>
                      ) : (
                        site && <p class="adult-text truncate text-sm font-semibold text-ink-soft">{site}</p>
                      )}
                    </div>
                    <Reactions lang={lang} itemId={item.id} summary={reactions.get(item.id)} mode={reactMode} loginHref={loginHref} class="mt-2.5" />
                    <div class="mt-auto pt-3">
                      {item.group_size ? (
                        <div data-group>
                          <div data-reserved-overlay>
                            <div class="h-2 overflow-hidden rounded-full bg-sand">
                              <div data-group-bar class="h-full rounded-full bg-mint-ink transition-all" style={`width:${Math.min(100, (group.length / item.group_size) * 100)}%`} />
                            </div>
                            <p class="mt-1.5 text-xs font-semibold text-ink-soft" data-group-text>
                              {t("group.progress", { n: group.length, size: item.group_size })}
                            </p>
                            {named.length > 0 && <p class="mt-0.5 truncate text-xs text-ink-soft" title={named.join(", ")}>{named.join(", ")}</p>}
                          </div>
                          <button data-join-btn class:list={["btn btn-soft mt-2.5 w-full !py-3 text-sm", { hidden: reserved }]}>
                            <Icon name="users-three" weight="bold" class="h-4 w-4" />
                            {t("group.join")}
                          </button>
                          <p data-group-full class:list={["mt-2.5 flex min-h-11 items-center justify-center rounded-2xl bg-mint px-3 py-2 text-sm font-bold text-mint-ink", { hidden: !reserved }]} data-reserved-overlay>
                            {t("group.full")}
                          </p>
                          <button data-leave-btn class="mt-1.5 hidden w-full text-center text-xs font-semibold text-ink-soft transition hover:text-rose-600">
                            {t("group.leave")}
                          </button>
                        </div>
                      ) : (
                        <>
                      <button data-reserve-btn class:list={["btn btn-soft w-full !py-3 text-sm", { hidden: reserved }]}>
                        {t("list.reserve")}
                      </button>
                      <div class:list={["text-center", { hidden: !reserved }]} data-reserved-overlay>
                        <p class="flex min-h-11 min-w-0 items-center justify-center gap-1.5 rounded-2xl bg-mint px-3 py-2 text-sm font-bold leading-tight text-mint-ink">
                          {/* With a name: "Reserved by Ana" (the prefix drawn by CSS, the script only sets the name); without one: "Reserved". */}
                          <Icon name="check-circle" weight="fill" class="h-4 w-4 shrink-0" />
                          <span
                            class:list={[
                              "peer min-w-0 break-words before:mr-1 before:content-[attr(data-prefix)]",
                              { hidden: !(reserved && item.reserved_by) },
                            ]}
                            data-prefix={t("list.reservedBy")}
                            data-reserved-name
                          >
                            {reserved ? item.reserved_by : ""}
                          </span>
                          <span class="peer-[:not(.hidden)]:hidden">{t("list.reserved")}</span>
                        </p>
                        <button data-unreserve-btn class="mt-1.5 text-xs font-semibold text-ink-soft transition hover:text-rose-600 hidden">
                          {t("list.cancelReservation")}
                        </button>
                      </div>
                        </>
                      )}
                      {item.product_url && (
                        <a
                          href={item.product_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-2 flex items-center justify-center gap-1 py-1 text-xs font-semibold text-ink-soft transition hover:text-accent-700"
                        >
                          {t("list.viewProduct")} <Icon name="arrow-square-out" class="h-3.5 w-3.5" />
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )
      }

      {
        !isOwner && (
          <p class="mt-8 text-center">
            <a href={`${localePath(lang, "/report")}?type=list&id=${list.id}`} class="inline-flex items-center gap-1.5 text-xs font-semibold text-ink-soft transition hover:text-rose-600">
              <Icon name="flag" class="h-3.5 w-3.5" />
              {t("list.report")}
            </a>
          </p>
        )
      }

      {!user && <GuestCta lang={lang} />}

      <div id="reserve-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/40 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="reserve-modal-title">
        <!-- Step 1: reservation form -->
        <div class="card w-full max-w-md !rounded-3xl p-6 shadow-lift" id="reserve-step-1">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-accent-100 text-accent-600">
            <Icon name="hand-heart" class="h-6 w-6" />
          </span>
          <h2 id="reserve-modal-title" class="mt-4 text-2xl font-extrabold tracking-tight">{t("modal.title")}</h2>
          <p class="mt-1 text-sm text-ink-soft" id="reserve-modal-text">{t("modal.text")}</p>
          <p class="mt-5 text-sm font-semibold text-ink" id="reserve-name-question">{t("modal.nameQuestion")}</p>
          <div class="mt-2 grid grid-cols-2 gap-2.5">
            <button type="button" data-choice="named" class="reserve-choice"><Icon name="user-circle" class="h-5 w-5" />{t("modal.named")}</button>
            <button type="button" data-choice="anon" class="reserve-choice"><Icon name="detective" class="h-5 w-5" />{t("modal.anon")}</button>
          </div>
          <div id="reserve-name-field" class="mt-3 hidden">
            <input id="reserve-name" type="text" maxlength="60" placeholder={t("modal.namePlaceholder")} class="field" />
          </div>
          <p id="reserve-error" class="mt-2 hidden text-sm font-medium text-rose-600"></p>
          <div class="mt-6 flex flex-col gap-2.5">
            <button id="reserve-confirm" class="btn btn-primary w-full !py-3.5 text-sm" disabled>
              <span data-confirm-label>{t("modal.confirm")}</span>
            </button>
            <button id="reserve-cancel" class="btn btn-ghost w-full !py-3 text-sm">{t("modal.cancel")}</button>
          </div>
        </div>
        <!-- Sign-in prompt for guests who tap Reserve / Join -->
        <div class="card hidden w-full max-w-md !rounded-3xl p-6 text-center shadow-lift" id="reserve-step-2">
          <span class="mx-auto grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
            <Icon name="gift" class="h-8 w-8" />
          </span>
          <h2 class="mt-4 text-xl font-extrabold tracking-tight">{t("step2.title")}</h2>
          <p class="mt-2 text-sm text-ink-soft">{t("step2.text")}</p>
          <div class="mt-6 flex flex-col gap-2.5">
            <a id="reserve-cta-btn" href={RM.registerUrl} class="btn btn-primary w-full !py-3.5 text-sm">
              {t("step2.create")}
            </a>
            <a id="reserve-cta-login" href={RM.loginUrl} class="btn btn-ghost w-full !py-3 text-sm">
              {t("step2.login")}
            </a>
            <button id="reserve-cta-skip" class="btn w-full !py-2 text-xs font-semibold text-ink-soft hover:text-ink">{t("step2.skip")}</button>
          </div>
        </div>
      </div>

      <script is:inline define:vars={{ RM }}>
        // A tiny dependency-free confetti burst, fired when a gift is reserved.
        function fireConfetti() {
          if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          const canvas = document.createElement("canvas");
          canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:60";
          document.body.appendChild(canvas);
          const ctx = canvas.getContext("2d");
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const resize = () => {
            canvas.width = window.innerWidth * dpr;
            canvas.height = window.innerHeight * dpr;
          };
          resize();
          // Pastel: coral, light coral, lavender, sun, mint (mid-tones so they show on the warm page).
          const colors = ["#f0726a", "#f7aca5", "#9d8cf0", "#f5c26b", "#6fcfb4"];
          const parts = [];
          for (let i = 0; i < 130; i++) {
            parts.push({
              x: (window.innerWidth / 2) * dpr,
              y: window.innerHeight * 0.4 * dpr,
              vx: (Math.random() - 0.5) * 16 * dpr,
              vy: (Math.random() * -13 - 5) * dpr,
              g: 0.38 * dpr,
              size: (Math.random() * 6 + 4) * dpr,
              color: colors[i % colors.length],
              rot: Math.random() * Math.PI,
              vr: (Math.random() - 0.5) * 0.3,
            });
          }
          const start = performance.now();
          function frame(now) {
            const t = now - start;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (const p of parts) {
              p.vy += p.g;
              p.x += p.vx;
              p.y += p.vy;
              p.vx *= 0.99;
              p.rot += p.vr;
              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate(p.rot);
              ctx.globalAlpha = Math.max(0, 1 - t / 2400);
              ctx.fillStyle = p.color;
              ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
              ctx.restore();
            }
            if (t < 2400) requestAnimationFrame(frame);
            else canvas.remove();
          }
          requestAnimationFrame(frame);
        }

        const modal = document.getElementById("reserve-modal");
        const nameInput = document.getElementById("reserve-name");
        const nameField = document.getElementById("reserve-name-field");
        const confirmBtn = document.getElementById("reserve-confirm");
        const cancelBtn = document.getElementById("reserve-cancel");
        const confirmLabel = modal.querySelector("[data-confirm-label]");
        const modalError = document.getElementById("reserve-error");
        const choiceBtns = Array.from(modal.querySelectorAll("[data-choice]"));

        // Sign-in prompt (guests can't reserve or join)
        const step1 = document.getElementById("reserve-step-1");
        const step2 = document.getElementById("reserve-step-2");
        const ctaBtn = document.getElementById("reserve-cta-btn");
        const ctaSkip = document.getElementById("reserve-cta-skip");
        const ctaLoginBtn = document.getElementById("reserve-cta-login");

        let activeCard = null;
        let mode = "reserve"; // or "join" (group gift)
        let choice = null;
        const modalTitle = document.getElementById("reserve-modal-title");
        const modalText = document.getElementById("reserve-modal-text");
        const nameQuestion = document.getElementById("reserve-name-question");
        let busy = false;

        function updateConfirm() {
          const ready = choice === "anon" || (choice === "named" && nameInput.value.trim().length > 0);
          confirmBtn.disabled = busy || !ready;
        }

        function setChoice(next) {
          choice = next;
          choiceBtns.forEach((b) => {
            b.classList.toggle("is-selected", b.dataset.choice === next);
          });
          if (next === "named") {
            nameField.classList.remove("hidden");
            nameInput.focus();
            nameInput.setSelectionRange(nameInput.value.length, nameInput.value.length);
          } else {
            nameField.classList.add("hidden");
          }
          updateConfirm();
        }

        // The name to suggest: the profile name when signed in, otherwise the
        // name this browser used for its last reservation.
        const NAME_KEY = "wd_name";
        function suggestedName() {
          if (RM.myName) return RM.myName;
          try {
            return localStorage.getItem(NAME_KEY) || "";
          } catch {
            return "";
          }
        }

        function openModal(card, nextMode = "reserve") {
          activeCard = card;
          mode = nextMode;
          if (!RM.isLoggedIn) return showSignIn(card);
          const join = mode === "join";
          modalTitle.textContent = join ? RM.joinTitle : RM.title;
          modalText.textContent = join ? RM.joinText : RM.text;
          nameQuestion.textContent = join ? RM.joinNameQuestion : RM.nameQuestion;
          choice = null;
          busy = false;
          nameInput.value = suggestedName();
          nameField.classList.add("hidden");
          choiceBtns.forEach((b) => b.classList.remove("is-selected"));
          confirmLabel.textContent = join ? RM.joinConfirm : RM.confirm;
          confirmBtn.disabled = true;
          modalError.classList.add("hidden");
          step1.classList.remove("hidden");
          step2.classList.add("hidden");
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }

        function closeModal() {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          activeCard = null;
        }

        function setLoading(loading) {
          // No content swap → button keeps its size; disabled state signals progress.
          busy = loading;
          updateConfirm();
        }

        choiceBtns.forEach((b) => b.addEventListener("click", () => setChoice(b.dataset.choice)));
        nameInput.addEventListener("input", updateConfirm);

        document.querySelectorAll("[data-reserve-btn]").forEach((btn) => {
          btn.addEventListener("click", () => openModal(btn.closest("[data-item-id]")));
        });

        cancelBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", (e) => {
          if (e.target === modal) closeModal();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
        });

        function markReserved(card, name) {
          card.dataset.reserved = "true";
          card.querySelector("[data-card-img]")?.classList.add("opacity-50", "grayscale");
          card.querySelector("[data-reserve-btn]")?.classList.add("hidden");
          card.querySelector("[data-reserved-overlay]")?.classList.remove("hidden");
          const nameEl = card.querySelector("[data-reserved-name]");
          if (nameEl) {
            if (name) {
              nameEl.textContent = name;
              nameEl.classList.remove("hidden");
            } else {
              nameEl.classList.add("hidden");
            }
          }
        }

        ctaSkip?.addEventListener("click", closeModal);

        function showSignIn(card) {
          // Come back to this list with the same gift's dialog open.
          const next = encodeURIComponent(`${RM.listPath}?reserve=${card.dataset.itemId}`);
          ctaBtn.href = `${RM.registerUrl}?next=${next}`;
          ctaLoginBtn.href = `${RM.loginUrl}?next=${next}`;
          step1.classList.add("hidden");
          step2.classList.remove("hidden");
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }

        confirmBtn.addEventListener("click", async () => {
          if (!activeCard || confirmBtn.disabled) return;
          const itemId = activeCard.dataset.itemId;
          const name = choice === "named" ? nameInput.value.trim() : "";
          modalError.classList.add("hidden");
          setLoading(true);
          if (mode === "join") return confirmJoin(itemId, name);
          try {
            const res = await fetch(`/api/items/${itemId}/reserve`, {
              method: "PATCH",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ reserved_by: name || null }),
            });
            const data = await res.json();
            if (res.status === 409) {
              markReserved(activeCard, "");
              throw new Error(RM.conflict);
            }
            if (!res.ok) throw new Error(data.error || RM.fail);
            markReserved(activeCard, name);
            if (name && !RM.myName) {
              try {
                localStorage.setItem(NAME_KEY, name);
              } catch {}
            }
            if (data.token) saveToken(itemId, data.token);
            showCancel(activeCard);
            fireConfetti();
            closeModal();
          } catch (err) {
            modalError.textContent = err instanceof Error ? err.message : RM.err;
            modalError.classList.remove("hidden");
            setLoading(false);
          }
        });

        // --- Cancel reservation (only the reserver, from this device, via token) ---
        const TOKENS_KEY = "wd_resv";
        function getTokens() {
          try {
            return JSON.parse(localStorage.getItem(TOKENS_KEY) || "{}");
          } catch {
            return {};
          }
        }
        function saveToken(id, token) {
          const t = getTokens();
          t[id] = token;
          localStorage.setItem(TOKENS_KEY, JSON.stringify(t));
        }
        function removeToken(id) {
          const t = getTokens();
          delete t[id];
          localStorage.setItem(TOKENS_KEY, JSON.stringify(t));
        }
        function showCancel(card) {
          card?.querySelector("[data-unreserve-btn]")?.classList.remove("hidden");
        }
        function markAvailable(card) {
          card.dataset.reserved = "false";
          card.querySelector("[data-card-img]")?.classList.remove("opacity-50", "grayscale");
          card.querySelector("[data-reserve-btn]")?.classList.remove("hidden");
          card.querySelector("[data-reserved-overlay]")?.classList.add("hidden");
          card.querySelector("[data-unreserve-btn]")?.classList.add("hidden");
        }

        // On load, reveal the cancel button for: items with a localStorage token OR
        // items where the signed-in user is the reserver (data-my-reservation).
        const myTokens = getTokens();
        document.querySelectorAll("[data-item-id]").forEach((card) => {
          if (card.dataset.reserved === "true") {
            if (myTokens[card.dataset.itemId] || card.dataset.myReservation === "true") {
              showCancel(card);
            }
          }
        });

        document.querySelectorAll("[data-unreserve-btn]").forEach((btn) => {
          btn.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const card = btn.closest("[data-item-id]");
            const id = card.dataset.itemId;
            const token = getTokens()[id];
            const isMyReservation = card.dataset.myReservation === "true";
            if (!token && !isMyReservation) return;
            btn.disabled = true;
            try {
              const res = await fetch(`/api/items/${id}/reserve`, {
                method: "DELETE",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ token: token || "" }),
              });
              if (!res.ok) throw new Error();
              removeToken(id);
              markAvailable(card);
            } catch {
              alert(RM.cancelFail);
              btn.disabled = false;
            }
          });
        });

        // --- Group gifts: join / leave (token in localStorage "wd_join") ---
        const JOIN_KEY = "wd_join";
        function getJoins() {
          try {
            return JSON.parse(localStorage.getItem(JOIN_KEY) || "{}");
          } catch {
            return {};
          }
        }
        function setJoin(id, token) {
          const j = getJoins();
          if (token) j[id] = token;
          else delete j[id];
          try {
            localStorage.setItem(JOIN_KEY, JSON.stringify(j));
          } catch {}
        }
        function paintGroup(card, count, size, mine) {
          const full = count >= size;
          card.dataset.reserved = full ? "true" : "false";
          card.querySelector("[data-group-bar]").style.width = Math.min(100, (count / size) * 100) + "%";
          card.querySelector("[data-group-text]").textContent = RM.progress.replace("{n}", count).replace("{size}", size);
          card.querySelector("[data-join-btn]").classList.toggle("hidden", full || mine);
          card.querySelector("[data-group-full]").classList.toggle("hidden", !full);
          card.querySelector("[data-leave-btn]").classList.toggle("hidden", !mine);
          card.querySelector("[data-card-img]")?.classList.toggle("opacity-50", full);
          card.querySelector("[data-card-img]")?.classList.toggle("grayscale", full);
        }
        const groupCount = (card) => parseInt(card.querySelector("[data-group-text]").textContent, 10) || 0;

        async function confirmJoin(itemId, name) {
          try {
            const res = await fetch(`/api/items/${itemId}/join`, {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ name: name || null }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || RM.fail);
            setJoin(itemId, data.token);
            if (name && !RM.myName) {
              try {
                localStorage.setItem(NAME_KEY, name);
              } catch {}
            }
            paintGroup(activeCard, data.count, data.size, true);
            fireConfetti();
            closeModal();
          } catch (err) {
            modalError.textContent = err instanceof Error ? err.message : RM.err;
            modalError.classList.remove("hidden");
            setLoading(false);
          }
        }

        const myJoins = getJoins();
        document.querySelectorAll("[data-group]").forEach((box) => {
          const card = box.closest("[data-item-id]");
          const mine = !!myJoins[card.dataset.itemId] || card.dataset.myJoin === "true";
          if (mine) paintGroup(card, groupCount(card), Number(card.dataset.groupSize), true);
          box.querySelector("[data-join-btn]").addEventListener("click", () => openModal(card, "join"));
          box.querySelector("[data-leave-btn]").addEventListener("click", async (e) => {
            const btn = e.currentTarget;
            btn.disabled = true;
            try {
              const res = await fetch(`/api/items/${card.dataset.itemId}/join`, {
                method: "DELETE",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ token: getJoins()[card.dataset.itemId] || "" }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error();
              setJoin(card.dataset.itemId, null);
              card.dataset.myJoin = "false";
              paintGroup(card, data.count, data.size, false);
            } catch {
              alert(RM.leaveFail);
            } finally {
              btn.disabled = false;
            }
          });
        });

        // Back from signing in (?reserve=<item id>): reopen that gift's dialog if it's still free.
        const wanted = new URLSearchParams(location.search).get("reserve");
        if (wanted) {
          const url = new URL(location.href);
          url.searchParams.delete("reserve");
          history.replaceState(null, "", url.pathname + url.search + url.hash);
          const card = RM.isLoggedIn ? document.querySelector(`[data-item-id="${CSS.escape(wanted)}"]`) : null;
          if (card && card.dataset.reserved !== "true") {
            card.scrollIntoView({ block: "center" });
            const isGroup = !!card.querySelector("[data-group]");
            const mineAlready = card.dataset.myJoin === "true" || !!getJoins()[wanted];
            if (!isGroup) openModal(card);
            else if (!mineAlready) openModal(card, "join");
          }
        }

        // "Back": the previous page when it was on WishDrop, otherwise the link's home page.
        document.querySelector("[data-back]")?.addEventListener("click", (e) => {
          let sameSite = false;
          try {
            sameSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
          } catch {}
          if (sameSite && history.length > 1) {
            e.preventDefault();
            history.back();
          }
        });

        // Owner surprise mode: peek at reservations
        const revealBtn = document.getElementById("reveal-btn");
        const grid = document.getElementById("items-grid");
        revealBtn?.addEventListener("click", () => {
          const next = revealBtn.dataset.revealed !== "true";
          revealBtn.dataset.revealed = String(next);
          grid?.setAttribute("data-surprise", next ? "off" : "on");
          revealBtn.textContent = next ? RM.hide : RM.reveal;
        });
      </script>
    </Layout>
  )
}
