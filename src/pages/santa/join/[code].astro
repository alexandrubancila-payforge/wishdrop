---
/** /santa/join/<code> — the invite link. Anyone can open it; joining needs an account. */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { plural } from "@/components/dashboard/plural";
import Avatar from "@/components/Avatar.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/santa";
import { getUserById } from "@/lib/db";
import { getGroupByCode, membership, members } from "@/lib/santa";

const { lang, user } = Astro.locals;
const t = makeT(lang, common, strings);
const href = (p: string) => localePath(lang, p);
const code = Astro.params.code ?? "";
const group = await getGroupByCode(code);
if (!group) return Astro.rewrite(localePath(lang, "/404"));
const [owner, people, mine] = await Promise.all([
  getUserById(group.owner_id),
  members(group.id),
  user ? membership(group.id, user.id) : null,
]);
const next = encodeURIComponent(`/santa/join/${code}`);
const ownerName = owner ? owner.name || (owner.username ? `@${owner.username}` : "") : "";
const day = new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", timeZone: "UTC" });
---

<Layout title={`${group.name} — ${t("title")}`} noindex mainClass="mx-auto flex max-w-md flex-col px-4 py-10 sm:py-16">
  <div class="card rise-in flex flex-col items-center p-8 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-500 text-white shadow-coral">
      <Icon name="gift" weight="fill" class="h-8 w-8" />
    </span>
    <p class="mt-5 text-sm font-bold text-accent-700">{t("join.title")}</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight">{group.name}</h1>
    {owner && <p class="mt-3 flex items-center gap-2 text-sm text-ink-soft"><Avatar user={owner} size={24} class="h-6 w-6" />{t("join.by", { name: ownerName })}</p>}
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <span class="chip bg-sand text-sm text-ink">{plural(t, lang, "members", people.length)}</span>
      {group.budget && <span class="chip bg-sun text-sm text-sun-ink">{t("budget")}: {group.budget}</span>}
      {group.exchange_date && <span class="chip bg-lav text-sm text-lav-ink">{day.format(new Date(group.exchange_date + "T00:00:00Z"))}</span>}
    </div>

    {
      mine ? (
        <>
          <p class="mt-6 text-sm text-ink-soft">{t("join.member")}</p>
          <a href={href(`/santa/${group.id}`)} class="btn btn-primary mt-3 w-full !py-3.5">{t("join.open")}</a>
        </>
      ) : group.drawn_at ? (
        <p class="mt-6 text-sm text-ink-soft">{t("join.closed")}</p>
      ) : user ? (
        <>
          <button type="button" id="santa-join" data-code={code} data-target={href(`/santa/${group.id}`)} class="btn btn-primary mt-6 w-full !py-3.5">
            {t("join.btn")}
          </button>
          <p id="join-error" class="mt-2 hidden text-sm font-medium text-rose-600"></p>
        </>
      ) : (
        <>
          <a href={`${href("/register")}?next=${next}`} class="btn btn-primary mt-6 w-full !py-3.5">{t("join.register")}</a>
          <a href={`${href("/login")}?next=${next}`} class="btn btn-ghost mt-2.5 w-full !py-3">{t("join.login")}</a>
        </>
      )
    }
  </div>

  <script>
    const b = document.getElementById("santa-join") as HTMLButtonElement | null;
    b?.addEventListener("click", async () => {
      b.disabled = true;
      const res = await fetch("/api/santa/join", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ code: b.dataset.code }) });
      if (res.ok) location.href = b.dataset.target!;
      else {
        const err = document.getElementById("join-error")!;
        err.textContent = (await res.json().catch(() => ({}))).error || "Error";
        err.classList.remove("hidden");
        b.disabled = false;
      }
    });
  </script>
</Layout>
