---
/**
 * /santa/<id> — one Secret Santa group, for its members. Before the draw:
 * invite link, participants, "the list my Santa sees", and the organizer's
 * "Draw names". After: only the person I give to (nobody sees other pairs).
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/santa";
import { db } from "@/lib/db";
import { getGroup, members, membership, myGiftee, SANTA_MIN } from "@/lib/santa";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);
const href = (p: string) => localePath(lang, p);

const group = await getGroup(Astro.params.id ?? "");
const me = group ? await membership(group.id, user.id) : null;
if (!group || !me) return Astro.rewrite(localePath(lang, "/404"));

const isOwner = group.owner_id === user.id;
const people = await members(group.id);
const giftee = group.drawn_at ? await myGiftee(group.id, user.id) : null;
const { results: myLists } = await db()
  .prepare("SELECT id, name FROM wishlists WHERE user_id = ? ORDER BY created_at DESC")
  .bind(user.id)
  .all<{ id: string; name: string }>();
const inviteUrl = `${Astro.url.origin}${localePath(lang, `/santa/join/${group.code}`)}`;
const owner = people.find((p) => p.user_id === group.owner_id);
const nameOf = (p: { name: string | null; username: string | null; email: string }) => p.name || (p.username ? `@${p.username}` : p.email.split("@")[0]);
const day = new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const missing = Math.max(0, SANTA_MIN - people.length);
const S = {
  copied: t("copied"),
  copy: t("copy"),
  saved: t("saved"),
  shareText: t("shareText", { group: group.name }),
  confirmDelete: t("confirmDelete"),
  confirmLeave: t("confirmLeave"),
  confirmRemove: t("confirmRemove"),
  drawConfirm: t("drawConfirm"),
  home: href("/santa"),
};
---

<Layout title={`${group.name} — ${t("title")}`} noindex mainClass="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-10">
  <a href={href("/santa")} class="text-sm font-semibold text-ink-soft hover:text-accent-700">{t("back")}</a>
  <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{group.name}</h1>
  <div class="mt-3 flex flex-wrap gap-2">
    {owner && <span class="chip bg-white text-sm shadow-soft"><Avatar user={owner} size={22} class="h-5.5 w-5.5" />{nameOf(owner)} · {t("organizer")}</span>}
    {group.budget && <span class="chip bg-sun text-sm text-sun-ink"><Icon name="tag" weight="bold" class="h-4 w-4" />{t("budget")}: {group.budget}</span>}
    {group.exchange_date && <span class="chip bg-lav text-sm text-lav-ink"><Icon name="calendar-blank" weight="bold" class="h-4 w-4" />{day.format(new Date(group.exchange_date + "T00:00:00Z"))}</span>}
  </div>

  {
    giftee ? (
      <section class="card mt-6 flex flex-col items-center bg-accent-50 p-8 text-center">
        <p class="text-sm font-extrabold uppercase tracking-wide text-accent-700">{t("giftee")}</p>
        <div class="mt-4 rounded-full shadow-[0_0_0_8px_var(--color-accent-100)] ring-4 ring-white">
          <Avatar user={giftee} size={96} class="h-24 w-24" />
        </div>
        <p class="mt-4 text-3xl font-extrabold tracking-tight">{nameOf(giftee)}</p>
        {giftee.list_slug ? (
          <a href={href(`/w/${giftee.list_slug}`)} class="btn btn-primary mt-5 !px-6 !py-3.5">
            <Icon name="gift" class="h-4 w-4" />
            {t("seeList")}: {giftee.list_name}
          </a>
        ) : (
          <>
            <p class="mt-3 text-sm text-ink-soft">{t("noGifteeList")}</p>
            {giftee.username && <a href={href(`/@${giftee.username}`)} class="btn btn-ghost mt-4 !px-6 !py-3">{t("seeProfile")}</a>}
          </>
        )}
        <p class="mt-6 text-sm font-bold">{t("secret")}</p>
        <p class="mt-1 text-xs text-ink-soft">{t("noOnePairs")}</p>
      </section>
    ) : (
      <section class="card mt-6 p-5 sm:p-6">
        <h2 class="flex items-center gap-2 font-extrabold"><Icon name="user-plus" class="h-5 w-5 text-accent-500" />{t("invite")}</h2>
        <p class="mt-1 text-sm text-ink-soft">{t("inviteText")}</p>
        <div class="mt-3 flex items-center gap-2">
          <input readonly value={inviteUrl} id="invite-url" class="field min-w-0 flex-1 truncate !py-2.5 text-sm text-ink-soft" />
          <button type="button" id="invite-copy" class="btn btn-soft shrink-0 !px-4 !py-2.5 text-sm">{t("copy")}</button>
          <button type="button" id="invite-share" class="btn btn-ghost hidden h-10 w-10 shrink-0 !p-0" aria-label={t("share")} title={t("share")}>
            <Icon name="share-network" class="h-[18px] w-[18px]" />
          </button>
        </div>
      </section>
    )
  }

  <section class="card mt-4 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 font-extrabold"><Icon name="list-heart" class="h-5 w-5 text-accent-500" />{t("myList")}</h2>
    <p class="mt-1 text-sm text-ink-soft">{t("myListHint")}</p>
    <div class="mt-3 flex items-center gap-2">
      <select id="my-list" class="field min-w-0 flex-1 !py-2.5" data-group={group.id}>
        <option value="">{t("noList")}</option>
        {myLists.map((l) => <option value={l.id} selected={l.id === me.wishlist_id}>{l.name}</option>)}
      </select>
      <span id="my-list-status" class="hidden text-xs font-semibold text-mint-ink"></span>
    </div>
    {myLists.length === 0 && <a href={href("/dashboard") + "#new"} class="mt-2 inline-block text-sm font-bold text-accent-700 hover:underline">{t("createList")} →</a>}
  </section>

  <section class="card mt-4 p-5 sm:p-6">
    <h2 class="flex items-center gap-2 font-extrabold"><Icon name="users-three" class="h-5 w-5 text-accent-500" />{t("membersTitle", { n: people.length })}</h2>
    <ul class="mt-2 divide-y divide-line">
      {
        people.map((p) => (
          <li class="flex items-center gap-3 py-3">
            <Avatar user={p} size={40} class="h-10 w-10" />
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-bold">{nameOf(p)}{p.user_id === user.id && <span class="font-medium text-ink-soft"> · {t("you")}</span>}</span>
              {p.user_id === group.owner_id && <span class="block text-xs text-ink-soft">{t("organizer")}</span>}
            </span>
            {p.wishlist_id && <Icon name="list-heart" class="h-5 w-5 text-mint-ink" />}
            {isOwner && !group.drawn_at && p.user_id !== user.id && (
              <button type="button" data-remove={p.user_id} class="text-xs font-bold text-ink-soft hover:text-rose-600">{t("remove")}</button>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  {
    !group.drawn_at && (
      <section class="card mt-4 p-5 sm:p-6">
        {isOwner ? (
          <>
            <button type="button" id="santa-draw" class="btn btn-primary w-full !py-4 text-base" disabled={missing > 0}>
              <Icon name="sparkle" weight="fill" class="h-5 w-5" />
              {t("draw")}
            </button>
            <p class="mt-2 text-center text-xs text-ink-soft">{missing > 0 ? t("needMore", { n: missing }) : t("drawHint")}</p>
            <p id="draw-error" class="mt-2 hidden text-center text-sm font-medium text-rose-600"></p>
          </>
        ) : (
          <p class="flex items-center gap-2 text-sm text-ink-soft"><Icon name="clock" class="h-5 w-5 text-accent-500" />{t("waitOwner")}</p>
        )}
      </section>
    )
  }

  <div class="mt-6 text-center">
    {
      isOwner ? (
        <button type="button" id="santa-delete" class="text-sm font-bold text-ink-soft hover:text-rose-600">{t("deleteGroup")}</button>
      ) : (
        !group.drawn_at && <button type="button" id="santa-leave" class="text-sm font-bold text-ink-soft hover:text-rose-600">{t("leave")}</button>
      )
    }
  </div>

  <div id="santa-data" data-s={JSON.stringify(S)} data-group={group.id} data-me={user.id} hidden></div>

  <script>
    const el = document.getElementById("santa-data")!;
    const S = JSON.parse(el.dataset.s!);
    const groupId = el.dataset.group!;
    const ask = (m: string) => ((window as any).wdConfirm ? (window as any).wdConfirm(m) : Promise.resolve(confirm(m)));
    const api = (path: string, method: string, body?: object) =>
      fetch(`/api/santa/${groupId}${path}`, { method, headers: { "content-type": "application/json" }, body: body ? JSON.stringify(body) : undefined });

    // Invite link: copy / native share.
    const url = (document.getElementById("invite-url") as HTMLInputElement | null)?.value;
    const copyBtn = document.getElementById("invite-copy");
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url!);
      } catch {}
      copyBtn.textContent = S.copied;
      setTimeout(() => (copyBtn.textContent = S.copy), 1500);
    });
    const shareBtn = document.getElementById("invite-share");
    if (shareBtn && navigator.share) {
      shareBtn.classList.replace("hidden", "grid");
      shareBtn.addEventListener("click", () => navigator.share({ text: S.shareText, url }).catch(() => {}));
    }

    // The list my Santa sees.
    const select = document.getElementById("my-list") as HTMLSelectElement;
    const status = document.getElementById("my-list-status")!;
    select.addEventListener("change", async () => {
      const res = await api("", "PATCH", { wishlist_id: select.value || null });
      if (res.ok) {
        status.textContent = S.saved;
        status.classList.remove("hidden");
        setTimeout(() => status.classList.add("hidden"), 1500);
      }
    });

    // Organizer: remove someone, draw names, delete. Members: leave.
    document.querySelectorAll<HTMLButtonElement>("[data-remove]").forEach((b) =>
      b.addEventListener("click", async () => {
        if (!(await ask(S.confirmRemove))) return;
        if ((await api("", "DELETE", { user_id: b.dataset.remove })).ok) location.reload();
      }),
    );
    document.getElementById("santa-draw")?.addEventListener("click", async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      if (!(await ask(S.drawConfirm))) return;
      b.disabled = true;
      const res = await api("/draw", "POST");
      if (res.ok) location.reload();
      else {
        const err = document.getElementById("draw-error")!;
        err.textContent = (await res.json().catch(() => ({}))).error || "Error";
        err.classList.remove("hidden");
        b.disabled = false;
      }
    });
    document.getElementById("santa-delete")?.addEventListener("click", async () => {
      if (!(await ask(S.confirmDelete))) return;
      if ((await api("", "DELETE")).ok) location.href = S.home;
    });
    document.getElementById("santa-leave")?.addEventListener("click", async () => {
      if (!(await ask(S.confirmLeave))) return;
      if ((await api("", "DELETE", {})).ok) location.href = S.home;
    });
  </script>
</Layout>
