---
/** /santa — my Secret Santa groups and a form to start one (lib/santa.ts). */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import strings from "@/i18n/santa";
import { myGroups } from "@/lib/santa";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, strings);
const href = (p: string) => localePath(lang, p);
const groups = await myGroups(user.id);
const day = new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", timeZone: "UTC" });
---

<Layout title={`${t("title")} — WishDrop`} noindex mainClass="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-10">
  <header>
    <h1 class="flex items-center gap-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
      <span class="grid h-12 w-12 place-items-center rounded-2xl bg-accent-500 text-white shadow-coral">
        <Icon name="gift" weight="fill" class="h-6 w-6" />
      </span>
      {t("title")}
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">{t("intro")}</p>
    <ol class="mt-5 grid gap-2 sm:grid-cols-3">
      {
        ["how.1", "how.2", "how.3"].map((k, i) => (
          <li class="flex items-center gap-3 rounded-2xl bg-white p-3 text-sm font-bold shadow-soft">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent-100 text-accent-700">{i + 1}</span>
            {t(k)}
          </li>
        ))
      }
    </ol>
  </header>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_360px]">
    <section>
      <h2 class="text-lg font-extrabold tracking-tight">{t("groups")}</h2>
      {
        groups.length === 0 ? (
          <p class="card mt-3 p-6 text-sm text-ink-soft">{t("empty")}</p>
        ) : (
          <ul class="mt-3 grid gap-3">
            {groups.map((g) => (
              <li>
                <a href={href(`/santa/${g.id}`)} class="card flex items-center gap-4 p-4 transition hover:-translate-y-0.5 hover:shadow-lift">
                  <span class:list={["grid h-12 w-12 shrink-0 place-items-center rounded-2xl", g.drawn_at ? "bg-mint text-mint-ink" : "bg-sun text-sun-ink"]}>
                    <Icon name={g.drawn_at ? "check-circle" : "users-three"} class="h-6 w-6" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-extrabold">{g.name}</span>
                    <span class="mt-0.5 block text-xs text-ink-soft">
                      {t("members", { n: g.member_count })}
                      {g.budget && ` · ${g.budget}`}
                      {g.exchange_date && ` · ${day.format(new Date(g.exchange_date + "T00:00:00Z"))}`}
                    </span>
                  </span>
                  <span class:list={["chip shrink-0 text-xs", g.drawn_at ? "bg-mint text-mint-ink" : "bg-sand text-ink-soft"]}>
                    {g.drawn_at && <Icon name="check" weight="bold" class="h-3.5 w-3.5" />}
                    {g.drawn_at ? t("drawnBadge") : t("openBadge")}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <form id="santa-create" class="card h-fit p-5 sm:p-6">
      <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
        <Icon name="plus" weight="bold" class="h-5 w-5 text-accent-500" />
        {t("create.title")}
      </h2>
      <label class="mt-4 block text-sm font-semibold" for="santa-name">{t("create.name")}</label>
      <input id="santa-name" name="name" required maxlength="60" placeholder={t("create.namePh")} class="field mt-1" />
      <label class="mt-4 block text-sm font-semibold" for="santa-budget">
        {t("create.budget")} <span class="font-normal text-ink-soft">{t("optional")}</span>
      </label>
      <input id="santa-budget" name="budget" maxlength="40" placeholder={t("create.budgetPh")} class="field mt-1" />
      <label class="mt-4 block text-sm font-semibold" for="santa-date">
        {t("create.date")} <span class="font-normal text-ink-soft">{t("optional")}</span>
      </label>
      <input id="santa-date" name="exchange_date" type="date" class="field mt-1" />
      <p id="santa-error" class="mt-3 hidden text-sm font-medium text-rose-600"></p>
      <button type="submit" class="btn btn-primary mt-5 w-full !py-3.5">{t("create.btn")}</button>
    </form>
  </div>

  <script>
    const form = document.getElementById("santa-create") as HTMLFormElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button")!;
      const err = document.getElementById("santa-error")!;
      btn.disabled = true;
      err.classList.add("hidden");
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch("/api/santa", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(data) });
      const body = await res.json().catch(() => ({}));
      if (res.ok) {
        location.href = `${location.pathname.replace(/\/$/, "")}/${body.id}`;
      } else {
        err.textContent = body.error || "Error";
        err.classList.remove("hidden");
        btn.disabled = false;
      }
    });
  </script>
</Layout>
