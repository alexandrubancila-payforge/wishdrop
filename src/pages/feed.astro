---
/**
 * Home for signed-in users (/ shows this page to them): upcoming birthdays of
 * the people you follow and the gifts they recently added to visible lists.
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import PersonRow from "@/components/social/PersonRow.astro";
import FollowButton from "@/components/social/FollowButton.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import feed from "@/i18n/feed";
import social from "@/i18n/social";
import { friendsActivity, suggestedPeople, upcomingBirthdays, upcomingEvents } from "@/lib/feed";
import { followCounts } from "@/lib/social";
import { imageUrl } from "@/lib/storage";
import { db } from "@/lib/db";
import { unreadCount } from "@/lib/notifications";
import notifStrings from "@/i18n/notifications";
import { plural } from "@/components/dashboard/plural";
import type { FeedEntry } from "@/lib/feed";
import Reactions from "@/components/gifts/Reactions.astro";
import { reactionsFor } from "@/lib/gifts";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, social, feed);
const href = (p: string) => localePath(lang, p);

const [bdays, events, activity, counts, suggestions, myLists, unread] = await Promise.all([
  upcomingBirthdays(user.id),
  upcomingEvents(user.id),
  friendsActivity(user.id),
  followCounts(user.id),
  suggestedPeople(user.id, 5),
  db().prepare("SELECT COUNT(*) AS n FROM wishlists WHERE user_id = ?").bind(user.id).first<{ n: number }>(),
  unreadCount(user.id),
]);
// "Coming up": friends' birthdays and the events their lists are for, soonest first.
const birthdays = [
  ...bdays.map((b) => ({ ...b, kind: "bday" as const, title: b.name || `@${b.username}`, link: b.username ? href(`/@${b.username}`) : "#" })),
  ...events.map((e) => ({ ...e, kind: "event" as const, title: e.list_name, link: href(`/w/${e.list_slug}`) })),
].sort((a, b) => a.inDays - b.inDays);
const reactions = await reactionsFor(activity.map((a) => a.id), user.id);
const notifLabel = makeT(lang, notifStrings)("title");
const profileHref = user.username ? href(`/@${user.username}`) : href("/settings") + "#public-profile";
const displayName = user.name || (user.username ? `@${user.username}` : user.email.split("@")[0]);

const firstName = (user.name || user.username || user.email.split("@")[0]).trim().split(/\s+/)[0];
const day = new Intl.DateTimeFormat(lang, { day: "2-digit", timeZone: "UTC" });
const month = new Intl.DateTimeFormat(lang, { month: "short", timeZone: "UTC" });
const rtf = new Intl.RelativeTimeFormat(lang, { numeric: "auto" });
function ago(ms: number) {
  const s = (ms - Date.now()) / 1000;
  const steps: [Intl.RelativeTimeFormatUnit, number][] = [["minute", 60], ["hour", 3600], ["day", 86400], ["week", 604800]];
  if (-s < 60) return rtf.format(0, "minute");
  let unit: Intl.RelativeTimeFormatUnit = "minute";
  let size = 60;
  for (const [u, sz] of steps) if (-s >= sz) [unit, size] = [u, sz];
  return rtf.format(Math.round(s / size), unit);
}
const when = (n: number) => (n === 0 ? t("today") : n === 1 ? t("tomorrow") : t("inDays", { n }));
const domain = (url: string | null) => {
  try {
    return url ? new URL(url).hostname.replace(/^www\./, "") : "";
  } catch {
    return "";
  }
};
// Several gifts added to the same list in a row become one post.
const posts: FeedEntry[][] = [];
for (const it of activity) {
  const last = posts.at(-1);
  if (last && last[0].list_slug === it.list_slug) last.push(it);
  else posts.push([it]);
}
const DATE_TINTS = ["bg-accent-500 text-white", "bg-mint text-mint-ink", "bg-lav text-lav-ink", "bg-sun text-sun-ink"];
---

<Layout title={t("title")} noindex mainClass="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
  <div class="grid gap-8 lg:grid-cols-[240px_minmax(0,1fr)_300px] xl:gap-10">
    <!-- Left: you (desktop) -->
    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-4">
        <div class="card overflow-hidden">
          <div class="h-16 bg-accent-100"></div>
          <div class="-mt-9 px-5 pb-5 text-center">
            <a href={profileHref} class="inline-block rounded-full ring-4 ring-white">
              <Avatar user={user} size={72} class="h-[72px] w-[72px]" />
            </a>
            <a href={profileHref} class="mt-2 block truncate text-lg font-extrabold tracking-tight hover:text-accent-700">{displayName}</a>
            {user.username && <p class="truncate text-sm text-ink-soft">@{user.username}</p>}
            <dl class="mt-4 grid grid-cols-3 gap-1 border-t border-line pt-4 text-center">
              <a href={href("/dashboard")} class="rounded-xl py-1 transition hover:bg-sand">
                <dd class="text-lg font-extrabold">{myLists?.n ?? 0}</dd>
                <dt class="text-[11px] font-semibold text-ink-soft">{t("profile.stat.lists")}</dt>
              </a>
              <a href={user.username ? href(`/@${user.username}/followers`) : profileHref} class="rounded-xl py-1 transition hover:bg-sand">
                <dd class="text-lg font-extrabold">{counts.followers}</dd>
                <dt class="text-[11px] font-semibold text-ink-soft">{t("profile.stat.followers")}</dt>
              </a>
              <a href={user.username ? href(`/@${user.username}/following`) : profileHref} class="rounded-xl py-1 transition hover:bg-sand">
                <dd class="text-lg font-extrabold">{counts.following}</dd>
                <dt class="text-[11px] font-semibold text-ink-soft">{t("profile.stat.following")}</dt>
              </a>
            </dl>
          </div>
        </div>
        <nav class="card p-2" aria-label={t("nav.navigation")}>
          {[
            { href: href("/"), icon: "house", label: t("nav.feed"), active: true },
            { href: href("/notifications"), icon: "bell", label: notifLabel, badge: unread },
            { href: href("/dashboard"), icon: "list-heart", label: t("myLists") },
            { href: href("/dashboard/reservations"), icon: "hand-heart", label: t("myReservations") },
            { href: href("/search"), icon: "user-plus", label: t("findFriends") },
            { href: href("/settings"), icon: "gear", label: t("nav.settings") },
          ].map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-semibold transition",
                item.active ? "bg-accent-50 text-accent-700" : "text-ink hover:bg-sand",
              ]}
            >
              <Icon name={item.icon} weight={item.active ? "fill" : "regular"} class:list={["h-5 w-5", item.active ? "text-accent-600" : "text-ink-soft"]} />
              <span class="flex-1">{item.label}</span>
              {!!item.badge && <span class="chip bg-accent-600 !px-2 !py-0.5 text-white">{item.badge}</span>}
            </a>
          ))}
        </nav>
        <a href={href("/dashboard") + "#new"} class="btn btn-primary w-full !py-3.5 text-sm">
          <Icon name="plus" weight="bold" class="h-4 w-4" />{t("createList")}
        </a>
      </div>
    </aside>

    <!-- Center: the feed -->
    <div class="min-w-0">
      <header class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("hi", { name: firstName })}</h1>
          <p class="mt-1 text-ink-soft">{t("intro")}</p>
        </div>
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-sun text-sun-ink">
          <Icon name="hand-waving" class="h-7 w-7" />
        </span>
      </header>

      <form action={href("/search")} method="get" class="mt-6" role="search">
        <label class="relative block">
          <span class="sr-only">{t("search")}</span>
          <Icon name="magnifying-glass" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-soft" />
          <input name="q" type="search" autocomplete="off" placeholder={t("search")} class="field !rounded-full !bg-white !py-3.5 !pl-12 shadow-soft" />
        </label>
      </form>

      <nav class="no-scrollbar -mx-4 mt-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0 lg:hidden">
        <a href={href("/dashboard")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="list-heart" class="h-4 w-4 text-accent-500" />{t("myLists")}
        </a>
        <a href={href("/dashboard/reservations")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="hand-heart" class="h-4 w-4 text-accent-500" />{t("myReservations")}
        </a>
        <a href={href("/search")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="user-plus" class="h-4 w-4 text-accent-500" />{t("findFriends")}
        </a>
      </nav>

      {
        birthdays.length > 0 && (
          <section class="mt-8 lg:hidden">
            <h2 class="flex items-center gap-2 text-lg font-extrabold">
              <Icon name="cake" class="h-5 w-5 text-accent-500" />
              {t("birthdays")}
            </h2>
            <ul class="no-scrollbar -mx-4 mt-3 flex gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
              {birthdays.map((b, i) => (
                <li class="shrink-0">
                  <a
                    href={b.link}
                    class="card flex w-56 items-stretch overflow-hidden !rounded-2xl transition hover:-translate-y-0.5 hover:shadow-lift"
                  >
                    <span class:list={["grid w-14 shrink-0 place-content-center text-center leading-none", DATE_TINTS[i % DATE_TINTS.length]]}>
                      <span class="text-xl font-extrabold">{day.format(b.next)}</span>
                      <span class="mt-1 text-[11px] font-semibold uppercase">{month.format(b.next).replace(".", "")}</span>
                    </span>
                    <span class="flex min-w-0 items-center gap-2.5 p-3">
                      <Avatar user={b} size={36} class="h-9 w-9" />
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-bold">{b.kind === "event" && <Icon name="confetti" class="mr-1 inline h-3.5 w-3.5 text-accent-500" />}{b.title}</span>
                        <span class:list={["block text-xs", b.inDays === 0 ? "font-bold text-accent-700" : "text-ink-soft"]}>{when(b.inDays)}</span>
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="mt-8">
        <h2 class="flex items-center gap-2 text-lg font-extrabold">
          <Icon name="sparkle" class="h-5 w-5 text-accent-500" />
          {t("activity")}
        </h2>
        {
          activity.length === 0 ? (
            <div class="card mt-3 flex flex-col items-center px-6 py-10 text-center">
              <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
                <Icon name={counts.following ? "coffee" : "users-three"} class="h-8 w-8" />
              </span>
              <h3 class="mt-4 text-lg font-extrabold">{counts.following ? t("quietTitle") : t("emptyTitle")}</h3>
              <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">{counts.following ? t("quietText") : t("emptyText")}</p>
              <a href={href("/search")} class="btn btn-primary mt-5 !py-3 text-sm">
                <Icon name="magnifying-glass" weight="bold" class="h-4 w-4" />{t("findFriends")}
              </a>
            </div>
          ) : (
            <ul class="mt-3 grid grid-cols-1 gap-6">
              {posts.map((group) => {
                const it = group[0];
                const owner = { name: it.owner_name, email: it.owner_email, avatar_url: it.owner_avatar };
                const ownerName = it.owner_name || (it.owner_username ? `@${it.owner_username}` : "");
                const ownerHref = it.owner_username ? href(`/@${it.owner_username}`) : href(`/w/${it.list_slug}`);
                const listHref = href(`/w/${it.list_slug}`);
                const shown = group.slice(0, 4);
                return (
                  <li class="card !rounded-3xl p-3 sm:p-4">
                    <div class="flex items-center gap-3 px-1">
                      <a href={ownerHref}>
                        <Avatar user={owner} size={40} class="h-10 w-10" />
                      </a>
                      <p class="min-w-0 flex-1 text-sm leading-tight">
                        <a href={ownerHref} class="font-bold hover:text-accent-700">{ownerName}</a>
                        <span class="block truncate text-xs text-ink-soft">
                          {group.length > 1
                            ? plural(t, lang, "addedMany", group.length, { list: it.list_name })
                            : t("addedTo", { list: it.list_name })}{" "}
                          · {ago(it.created_at)}
                        </span>
                      </p>
                      <a href={listHref} class="btn btn-soft hidden !px-4 !py-2 text-xs sm:inline-flex">
                        {t("open")}
                        <Icon name="caret-right" weight="bold" class="h-3.5 w-3.5" />
                      </a>
                    </div>
                    {group.length === 1 ? (
                      <a href={listHref} class="mt-3 grid grid-cols-[96px_1fr_auto] items-center gap-4 rounded-2xl bg-sand/60 p-2.5 transition hover:bg-sand sm:grid-cols-[140px_1fr_auto]">
                        {it.image_key ? (
                          <img src={imageUrl(it.image_key)} alt="" loading="lazy" class:list={["aspect-square w-full rounded-2xl bg-white object-cover", it.reserved_at && "opacity-50 grayscale"]} />
                        ) : (
                          <span class="grid aspect-square w-full place-items-center rounded-2xl bg-accent-50 text-accent-500">
                            <Icon name="gift" class="h-9 w-9" />
                          </span>
                        )}
                        <span class="min-w-0">
                          <span class="block truncate font-bold sm:text-lg">{domain(it.product_url) || it.list_name}</span>
                          <span class="mt-1.5 flex flex-wrap gap-1.5">
                            {it.priority > 0 && <span class="chip bg-accent-100 text-accent-700">★ {t("mostWanted")}</span>}
                            {it.reserved_at && <span class="chip bg-mint text-mint-ink">✓ {t("reserved")}</span>}
                          </span>
                          {it.price && <span class="mt-2 block text-lg font-extrabold sm:text-2xl">{it.price}</span>}
                        </span>
                        <Icon name="caret-right" weight="bold" class="mr-2 h-5 w-5 text-ink-soft" />
                      </a>
                    ) : (
                      <div class="mt-3">
                        <div class:list={["grid gap-2", shown.length === 2 ? "grid-cols-2" : shown.length === 3 ? "grid-cols-3" : "grid-cols-2 sm:grid-cols-4"]}>
                          {shown.map((g, i) => {
                            const more = i === shown.length - 1 && group.length > shown.length;
                            return (
                              <div class="relative">
                                <a href={listHref} class="relative block overflow-hidden rounded-2xl">
                                  {g.image_key ? (
                                    <img src={imageUrl(g.image_key)} alt="" loading="lazy" class:list={["aspect-square w-full bg-sand object-cover transition duration-300 hover:scale-[1.03]", g.reserved_at && "opacity-50 grayscale"]} />
                                  ) : (
                                    <span class="grid aspect-square w-full place-items-center bg-accent-50 text-accent-500">
                                      <Icon name="gift" class="h-9 w-9" />
                                    </span>
                                  )}
                                  {g.price && <span class="chip absolute bottom-2 left-2 max-w-[85%] truncate bg-white/95 text-ink shadow-soft">{g.price}</span>}
                                  {more && (
                                    <span class="absolute inset-0 grid place-items-center bg-ink/45 text-2xl font-extrabold text-white">
                                      +{group.length - shown.length}
                                    </span>
                                  )}
                                </a>
                                {/* A ❤️ on each photo, outside the link so tapping it never opens the list. */}
                                {!more && <Reactions lang={lang} itemId={g.id} summary={reactions.get(g.id)} mode="react" heartOnly class="absolute right-2 top-2" />}
                              </div>
                            );
                          })}
                        </div>
                        <a href={listHref} class="flex items-center justify-between px-1 pt-3 text-sm font-bold sm:hidden">
                          {it.list_name}
                          <span class="flex items-center gap-1 text-accent-700">{t("open")} <Icon name="caret-right" weight="bold" class="h-4 w-4" /></span>
                        </a>
                      </div>
                    )}
                    {group.length === 1 && <Reactions lang={lang} itemId={it.id} summary={reactions.get(it.id)} mode="react" class="mt-3 px-1" />}
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      {
        suggestions.length > 0 && activity.length < 4 && (
          <section class="mt-10 lg:hidden">
            <h2 class="flex items-center gap-2 text-lg font-extrabold">
              <Icon name="user-plus" class="h-5 w-5 text-accent-500" />
              {t("suggested")}
            </h2>
            <ul class="card mt-3 divide-y divide-line px-5">
              {suggestions.map((p) => (
                <PersonRow person={p} meta={t("lists", { n: p.lists })}>
                  <FollowButton username={p.username} relation="none" isPrivate={!!p.is_private} size="sm" />
                </PersonRow>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <!-- Right: birthdays and people (desktop) -->
    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-4">
        <section class="card p-5">
          <h2 class="flex items-center gap-2 font-extrabold">
            <Icon name="cake" class="h-5 w-5 text-accent-500" />
            {t("birthdays")}
          </h2>
          {
            birthdays.length === 0 ? (
              <p class="mt-3 text-sm text-ink-soft">{t("noBirthdays")}</p>
            ) : (
              <ul class="mt-3 space-y-2">
                {birthdays.slice(0, 5).map((b, i) => (
                  <li>
                    <a href={b.link} class="flex items-center gap-3 rounded-2xl p-1.5 transition hover:bg-sand">
                      <span class:list={["grid h-11 w-11 shrink-0 place-content-center rounded-xl text-center leading-none", DATE_TINTS[i % DATE_TINTS.length]]}>
                        <span class="text-base font-extrabold">{day.format(b.next)}</span>
                        <span class="text-[9px] font-semibold uppercase">{month.format(b.next).replace(".", "")}</span>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-bold">{b.kind === "event" && <Icon name="confetti" class="mr-1 inline h-3.5 w-3.5 text-accent-500" />}{b.title}</span>
                        <span class:list={["block text-xs", b.inDays === 0 ? "font-bold text-accent-700" : "text-ink-soft"]}>{when(b.inDays)}</span>
                      </span>
                      <Avatar user={b} size={32} class="h-8 w-8" />
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
        {
          suggestions.length > 0 && (
            <section class="card p-5">
              <div class="flex items-center justify-between gap-2">
                <h2 class="flex min-w-0 items-center gap-2 font-extrabold">
                  <Icon name="user-plus" class="h-5 w-5 shrink-0 text-accent-500" />
                  <span class="truncate">{t("suggested")}</span>
                </h2>
                <a href={href("/search")} class="shrink-0 whitespace-nowrap text-xs font-bold text-accent-700 hover:underline">{t("seeAll")}</a>
              </div>
              <ul class="mt-2 divide-y divide-line">
                {suggestions.map((p) => (
                  <PersonRow person={p} meta={t("lists", { n: p.lists })}>
                    <FollowButton username={p.username} relation="none" isPrivate={!!p.is_private} size="sm" />
                  </PersonRow>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </aside>
  </div>
</Layout>
