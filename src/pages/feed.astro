---
/**
 * Home for signed-in users (/ shows this page to them): upcoming birthdays of
 * the people you follow and the gifts they recently added to visible lists.
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import PersonRow from "@/components/social/PersonRow.astro";
import FollowButton from "@/components/social/FollowButton.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import feed from "@/i18n/feed";
import social from "@/i18n/social";
import FeedPost from "@/components/feed/FeedPost.astro";
import { feedPage, storyFriends, suggestedPeople, upcomingBirthdays, upcomingEvents } from "@/lib/feed";
import { followCounts } from "@/lib/social";
import { db } from "@/lib/db";
import { unreadCount } from "@/lib/notifications";
import notifStrings from "@/i18n/notifications";
import santaStrings from "@/i18n/santa";
import { reactionsFor } from "@/lib/gifts";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, social, feed);
const href = (p: string) => localePath(lang, p);

const [bdays, events, firstPage, friendsWithNews, counts, suggestions, myLists, unread] = await Promise.all([
  upcomingBirthdays(user.id),
  upcomingEvents(user.id),
  feedPage(user.id),
  storyFriends(user.id),
  followCounts(user.id),
  suggestedPeople(user.id, 5),
  db().prepare("SELECT COUNT(*) AS n FROM wishlists WHERE user_id = ?").bind(user.id).first<{ n: number }>(),
  unreadCount(user.id),
]);
// "Coming up": friends' birthdays and the events their lists are for, soonest first.
const birthdays = [
  ...bdays.map((b) => ({ ...b, kind: "bday" as const, title: b.name || `@${b.username}`, link: b.username ? href(`/@${b.username}`) : "#" })),
  ...events.map((e) => ({ ...e, kind: "event" as const, title: e.list_name, link: href(`/w/${e.list_slug}`) })),
].sort((a, b) => a.inDays - b.inDays);
const { posts, next } = firstPage;
const when = (n: number) => (n === 0 ? t("today") : n === 1 ? t("tomorrow") : t("inDays", { n }));

// The bubbles at the top (like Instagram stories): you, then friends whose birthday is within a
// week (gold ring, cake), then friends who added gifts in the last 7 days (coral ring).
// The script marks the ones already opened as seen (grey ring) and moves them to the end.
const year = new Date().getUTCFullYear();
const soonBdays = bdays.filter((b) => b.inDays <= 7);
const bdayIds = new Set(soonBdays.map((b) => b.id));
const stories = [
  ...soonBdays.map((b) => ({
    key: `bday:${b.id}:${year}`,
    kind: "bday" as const,
    who: b,
    label: (b.name || b.username || "").trim().split(/\s+/)[0],
    sub: when(b.inDays),
    href: b.username ? href(`/@${b.username}`) : "#",
  })),
  ...friendsWithNews
    .filter((f) => !bdayIds.has(f.id))
    .map((f) => ({
      key: `new:${f.id}:${f.last_at}`,
      kind: "new" as const,
      who: f,
      label: (f.name || f.username || "").trim().split(/\s+/)[0],
      sub: "",
      href: href(`/w/${f.list_slug}`),
    })),
];
const myListsHref = myLists?.n ? href("/dashboard") : href("/dashboard") + "#new";
const activity = posts.flat();
const reactions = await reactionsFor(activity.map((a) => a.id), user.id);
const notifLabel = makeT(lang, notifStrings)("title");
// Secret Santa card in the gift season (November to January).
const santaSeason = [10, 11, 0].includes(new Date().getUTCMonth());
const santaT = makeT(lang, santaStrings);
const profileHref = user.username ? href(`/@${user.username}`) : href("/settings") + "#public-profile";
const displayName = user.name || (user.username ? `@${user.username}` : user.email.split("@")[0]);

const day = new Intl.DateTimeFormat(lang, { day: "2-digit", timeZone: "UTC" });
const month = new Intl.DateTimeFormat(lang, { month: "short", timeZone: "UTC" });
const DATE_TINTS = ["bg-accent-500 text-white", "bg-mint text-mint-ink", "bg-lav text-lav-ink", "bg-sun text-sun-ink"];
---

<Layout title={t("title")} noindex mainClass="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
  <div class="grid gap-8 lg:grid-cols-[240px_minmax(0,1fr)_300px] xl:gap-10">
    <!-- Left: you (desktop) -->
    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-4">
        <div class="card overflow-hidden">
          <div class="h-16 bg-accent-100"></div>
          <div class="-mt-9 px-5 pb-5 text-center">
            <a href={profileHref} class="inline-block rounded-full ring-4 ring-white">
              <Avatar user={user} size={72} class="h-[72px] w-[72px]" />
            </a>
            <a href={profileHref} class="mt-2 block truncate text-lg font-extrabold tracking-tight hover:text-accent-700">{displayName}</a>
            {user.username && <p class="truncate text-sm text-ink-soft">@{user.username}</p>}
            <dl class="mt-4 grid grid-cols-3 gap-1 border-t border-line pt-4 text-center">
              <a href={href("/dashboard")} class="rounded-xl py-1 transition hover:bg-sand">
                <dd class="text-lg font-extrabold">{myLists?.n ?? 0}</dd>
                <dt class="text-[11px] font-semibold text-ink-soft">{t("profile.stat.lists")}</dt>
              </a>
              <a href={user.username ? href(`/@${user.username}/followers`) : profileHref} class="rounded-xl py-1 transition hover:bg-sand">
                <dd class="text-lg font-extrabold">{counts.followers}</dd>
                <dt class="text-[11px] font-semibold text-ink-soft">{t("profile.stat.followers")}</dt>
              </a>
              <a href={user.username ? href(`/@${user.username}/following`) : profileHref} class="rounded-xl py-1 transition hover:bg-sand">
                <dd class="text-lg font-extrabold">{counts.following}</dd>
                <dt class="text-[11px] font-semibold text-ink-soft">{t("profile.stat.following")}</dt>
              </a>
            </dl>
          </div>
        </div>
        <nav class="card p-2" aria-label={t("nav.navigation")}>
          {[
            { href: href("/"), icon: "house", label: t("nav.feed"), active: true },
            { href: href("/notifications"), icon: "bell", label: notifLabel, badge: unread },
            { href: href("/dashboard"), icon: "list-heart", label: t("myLists") },
            { href: href("/dashboard/reservations"), icon: "hand-heart", label: t("myReservations") },
            { href: href("/search"), icon: "user-plus", label: t("findFriends") },
            { href: href("/popular"), icon: "fire", label: makeT(lang, common)("nav.popular") },
            { href: href("/santa"), icon: "gift", label: makeT(lang, common)("nav.santa") },
            { href: href("/settings"), icon: "gear", label: t("nav.settings") },
          ].map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-2xl px-3 py-2.5 text-sm font-semibold transition",
                item.active ? "bg-accent-50 text-accent-700" : "text-ink hover:bg-sand",
              ]}
            >
              <Icon name={item.icon} weight={item.active ? "fill" : "regular"} class:list={["h-5 w-5", item.active ? "text-accent-600" : "text-ink-soft"]} />
              <span class="flex-1">{item.label}</span>
              {!!item.badge && <span class="chip bg-accent-600 !px-2 !py-0.5 text-white">{item.badge}</span>}
            </a>
          ))}
        </nav>
        <a href={href("/dashboard") + "#new"} class="btn btn-primary w-full !py-3.5 text-sm">
          <Icon name="plus" weight="bold" class="h-4 w-4" />{t("createList")}
        </a>
      </div>
    </aside>

    <!-- Center: the feed -->
    <div class="min-w-0">
      <header>
        {/* The bubbles open the page; the heading stays for screen readers. */}
        <h1 class="sr-only">{makeT(lang, common)("nav.feed")}</h1>
        <div class="stories-wrap relative">
        <button type="button" data-stories-prev class="stories-arrow left-0" aria-label={t("story.prev")} hidden>
          <Icon name="caret-left" weight="bold" class="h-4 w-4" />
        </button>
        <button type="button" data-stories-next class="stories-arrow right-0" aria-label={t("story.next")} hidden>
          <Icon name="caret-right" weight="bold" class="h-4 w-4" />
        </button>
        <ul id="stories" class="no-scrollbar -mx-4 flex snap-x scroll-px-4 gap-3 overflow-x-auto scroll-smooth px-4 py-1 sm:mx-0 sm:scroll-px-0 sm:px-0" aria-label={t("story.label")}>
          <li>
            <a href={myListsHref} class="story">
              <span class="story-ring is-you">
                <span class="story-inner"><Avatar user={user} size={60} class="h-[60px] w-[60px]" /></span>
                <span class="story-badge bg-accent-500 text-white"><Icon name="plus" weight="bold" class="h-3.5 w-3.5" /></span>
              </span>
              <span class="story-name">{t("story.you")}</span>
            </a>
          </li>
          {stories.map((s) => (
            <li data-story={s.key}>
              <a href={s.href} class="story">
                <span class:list={["story-ring", s.kind === "bday" ? "is-bday" : "is-new"]}>
                  <span class="story-inner"><Avatar user={s.who} size={60} class="h-[60px] w-[60px]" /></span>
                  {s.kind === "bday" && (
                    <span class="story-badge bg-sun text-sun-ink"><Icon name="cake" weight="fill" class="h-3.5 w-3.5" /></span>
                  )}
                </span>
                <span class="story-name">{s.label}</span>
                {s.sub && <span class="-mt-1 text-[11px] font-bold leading-none text-sun-ink">{s.sub}</span>}
              </a>
            </li>
          ))}
          {
            stories.length === 0 && (
              <li>
                <a href={href("/search")} class="story">
                  <span class="story-ring is-empty">
                    <span class="story-inner grid h-[60px] w-[60px] place-items-center rounded-full bg-white text-accent-500">
                      <Icon name="user-plus" class="h-6 w-6" />
                    </span>
                  </span>
                  <span class="story-name">{t("findFriends")}</span>
                </a>
              </li>
            )
          }
        </ul>
        </div>
      </header>

      <form action={href("/search")} method="get" class="mt-6" role="search">
        <label class="relative block">
          <span class="sr-only">{t("search")}</span>
          <Icon name="magnifying-glass" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-soft" />
          <input name="q" type="search" autocomplete="off" placeholder={t("search")} class="field !rounded-full !bg-white !py-3.5 !pl-12 shadow-soft" />
        </label>
      </form>

      <nav class="no-scrollbar -mx-4 mt-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0 lg:hidden">
        <a href={href("/dashboard")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="list-heart" class="h-4 w-4 text-accent-500" />{t("myLists")}
        </a>
        <a href={href("/santa")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="gift" class="h-4 w-4 text-accent-500" />{makeT(lang, common)("nav.santa")}
        </a>
        <a href={href("/popular")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="fire" class="h-4 w-4 text-accent-500" />{makeT(lang, common)("nav.popular")}
        </a>
        <a href={href("/dashboard/reservations")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="hand-heart" class="h-4 w-4 text-accent-500" />{t("myReservations")}
        </a>
        <a href={href("/search")} class="chip shrink-0 bg-white !px-4 !py-2 text-ink shadow-soft hover:text-accent-700">
          <Icon name="user-plus" class="h-4 w-4 text-accent-500" />{t("findFriends")}
        </a>
      </nav>

      {
        birthdays.length > 0 && (
          <section class="mt-8 lg:hidden">
            <h2 class="flex items-center gap-2 text-lg font-extrabold">
              <Icon name="cake" class="h-5 w-5 text-accent-500" />
              {t("birthdays")}
            </h2>
            <ul class="no-scrollbar -mx-4 mt-3 flex gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
              {birthdays.map((b, i) => (
                <li class="shrink-0">
                  <a
                    href={b.link}
                    class="card flex w-56 items-stretch overflow-hidden !rounded-2xl transition hover:-translate-y-0.5 hover:shadow-lift"
                  >
                    <span class:list={["grid w-14 shrink-0 place-content-center text-center leading-none", DATE_TINTS[i % DATE_TINTS.length]]}>
                      <span class="text-xl font-extrabold">{day.format(b.next)}</span>
                      <span class="mt-1 text-[11px] font-semibold uppercase">{month.format(b.next).replace(".", "")}</span>
                    </span>
                    <span class="flex min-w-0 items-center gap-2.5 p-3">
                      <Avatar user={b} size={36} class="h-9 w-9" />
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-bold">{b.kind === "event" && <Icon name="confetti" class="mr-1 inline h-3.5 w-3.5 text-accent-500" />}{b.title}</span>
                        <span class:list={["block text-xs", b.inDays === 0 ? "font-bold text-accent-700" : "text-ink-soft"]}>{when(b.inDays)}</span>
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        santaSeason && (
          <a href={href("/santa")} class="card mt-8 flex items-center gap-4 bg-accent-500 p-5 text-white transition hover:-translate-y-0.5 hover:shadow-lift">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/20">
              <Icon name="gift" weight="fill" class="h-6 w-6" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-extrabold">{santaT("promo.title")}</span>
              <span class="mt-0.5 block text-sm text-white/85">{santaT("promo.text")}</span>
            </span>
            <span class="chip hidden shrink-0 bg-white text-accent-700 sm:inline-flex">{santaT("promo.btn")} →</span>
          </a>
        )
      }

      <section class="mt-8">
        <h2 class="flex items-center gap-2 text-lg font-extrabold">
          <Icon name="sparkle" class="h-5 w-5 text-accent-500" />
          {t("activity")}
        </h2>
        {
          activity.length === 0 ? (
            <div class="card mt-3 flex flex-col items-center px-6 py-10 text-center">
              <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
                <Icon name={counts.following ? "coffee" : "users-three"} class="h-8 w-8" />
              </span>
              <h3 class="mt-4 text-lg font-extrabold">{counts.following ? t("quietTitle") : t("emptyTitle")}</h3>
              <p class="mx-auto mt-1 max-w-sm text-sm text-ink-soft">{counts.following ? t("quietText") : t("emptyText")}</p>
              <a href={href("/search")} class="btn btn-primary mt-5 !py-3 text-sm">
                <Icon name="magnifying-glass" weight="bold" class="h-4 w-4" />{t("findFriends")}
              </a>
            </div>
          ) : (
            <>
              <ul id="feed-posts" class="mt-3 grid grid-cols-1 gap-6">
                {posts.map((group) => <FeedPost lang={lang} group={group} reactions={reactions} />)}
              </ul>
              {/* Scrolling near the end loads older posts (pages/feed/more.astro), like Instagram. */}
              <div id="feed-more" data-next={next ? `${href("/feed/more")}?at=${next.at}&id=${encodeURIComponent(next.id)}` : ""} class="py-8 text-center text-sm text-ink-soft">
                <span data-loading class="inline-flex items-center gap-2" hidden={!next}>
                  <span class="h-4 w-4 animate-spin rounded-full border-2 border-accent-200 border-t-accent-500"></span>
                  {t("loadingMore")}
                </span>
                <button type="button" data-retry class="btn btn-soft !px-4 !py-2 text-xs" hidden>{t("loadMoreRetry")}</button>
                <span data-end hidden={!!next}>{t("allCaughtUp")}</span>
              </div>
            </>
          )
        }
      </section>

      {
        suggestions.length > 0 && activity.length < 4 && (
          <section class="mt-10 lg:hidden">
            <h2 class="flex items-center gap-2 text-lg font-extrabold">
              <Icon name="user-plus" class="h-5 w-5 text-accent-500" />
              {t("suggested")}
            </h2>
            <ul class="card mt-3 divide-y divide-line px-5">
              {suggestions.map((p) => (
                <PersonRow person={p} meta={t("lists", { n: p.lists })}>
                  <FollowButton username={p.username} relation="none" isPrivate={!!p.is_private} size="sm" />
                </PersonRow>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <!-- Right: birthdays and people (desktop) -->
    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-4">
        <section class="card p-5">
          <h2 class="flex items-center gap-2 font-extrabold">
            <Icon name="cake" class="h-5 w-5 text-accent-500" />
            {t("birthdays")}
          </h2>
          {
            birthdays.length === 0 ? (
              <p class="mt-3 text-sm text-ink-soft">{t("noBirthdays")}</p>
            ) : (
              <ul class="mt-3 space-y-2">
                {birthdays.slice(0, 5).map((b, i) => (
                  <li>
                    <a href={b.link} class="flex items-center gap-3 rounded-2xl p-1.5 transition hover:bg-sand">
                      <span class:list={["grid h-11 w-11 shrink-0 place-content-center rounded-xl text-center leading-none", DATE_TINTS[i % DATE_TINTS.length]]}>
                        <span class="text-base font-extrabold">{day.format(b.next)}</span>
                        <span class="text-[9px] font-semibold uppercase">{month.format(b.next).replace(".", "")}</span>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-bold">{b.kind === "event" && <Icon name="confetti" class="mr-1 inline h-3.5 w-3.5 text-accent-500" />}{b.title}</span>
                        <span class:list={["block text-xs", b.inDays === 0 ? "font-bold text-accent-700" : "text-ink-soft"]}>{when(b.inDays)}</span>
                      </span>
                      <Avatar user={b} size={32} class="h-8 w-8" />
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
        {
          suggestions.length > 0 && (
            <section class="card p-5">
              <div class="flex items-center justify-between gap-2">
                <h2 class="flex min-w-0 items-center gap-2 font-extrabold">
                  <Icon name="user-plus" class="h-5 w-5 shrink-0 text-accent-500" />
                  <span class="leading-snug">{t("suggested")}</span>
                </h2>
                <a href={href("/search")} class="shrink-0 whitespace-nowrap text-xs font-bold text-accent-700 hover:underline">{t("seeAll")}</a>
              </div>
              <ul class="mt-2 divide-y divide-line">
                {suggestions.map((p) => (
                  <PersonRow person={p} meta={t("lists", { n: p.lists })}>
                    <FollowButton username={p.username} relation="none" isPrivate={!!p.is_private} size="sm" />
                  </PersonRow>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </aside>
  </div>
</Layout>

<script>
  // Older posts load as the end of the feed comes into view (pages/feed/more.astro).
  const box = document.getElementById("feed-more");
  const list = document.getElementById("feed-posts");
  if (box && list && box.dataset.next) {
    const loading = box.querySelector<HTMLElement>("[data-loading]")!;
    const retry = box.querySelector<HTMLElement>("[data-retry]")!;
    const end = box.querySelector<HTMLElement>("[data-end]")!;
    let busy = false;
    const load = async () => {
      const url = box.dataset.next;
      if (busy || !url) return;
      busy = true;
      loading.hidden = false;
      retry.hidden = true;
      try {
        const res = await fetch(url, { headers: { accept: "text/html" } });
        // A redirect means the session ended (the login page came back instead of posts).
        if (!res.ok || res.redirected) throw new Error(String(res.status));
        const tpl = document.createElement("template");
        tpl.innerHTML = await res.text();
        const nextEl = tpl.content.querySelector<HTMLElement>("[data-feed-next]");
        box.dataset.next = nextEl?.dataset.feedNext ?? "";
        nextEl?.remove();
        list.append(tpl.content);
        if (!box.dataset.next) {
          observer.disconnect();
          loading.hidden = true;
          end.hidden = false;
        }
      } catch {
        loading.hidden = true;
        retry.hidden = false;
      } finally {
        busy = false;
      }
      // Still on screen (a short page)? Keep going.
      if (box.dataset.next && box.getBoundingClientRect().top < innerHeight + 800) load();
    };
    const observer = new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && load(), { rootMargin: "800px 0px" });
    observer.observe(box);
    retry.addEventListener("click", load);
  }
</script>

<script>
  // Bubbles already opened turn grey and move to the end (remembered in this browser).
  const row = document.getElementById("stories");
  if (row) {
    const KEY = "wd_stories_seen";
    let seen: Record<string, number> = {};
    try {
      seen = JSON.parse(localStorage.getItem(KEY) || "{}");
    } catch {}
    const items = [...row.querySelectorAll<HTMLElement>("li[data-story]")];
    for (const li of items) {
      if (!seen[li.dataset.story!]) continue;
      li.querySelector(".story-ring")?.classList.add("is-seen");
      row.append(li);
    }
    // On a computer the row can't be swiped: arrows appear at an edge that has more bubbles,
    // the edge fades out, and the mouse wheel scrolls sideways.
    const wrap = row.parentElement!;
    const prev = wrap.querySelector<HTMLButtonElement>("[data-stories-prev]")!;
    const next = wrap.querySelector<HTMLButtonElement>("[data-stories-next]")!;
    const update = () => {
      const more = row.scrollWidth - row.clientWidth;
      const atStart = row.scrollLeft <= 2;
      const atEnd = row.scrollLeft >= more - 2;
      prev.hidden = more <= 2 || atStart;
      next.hidden = more <= 2 || atEnd;
      wrap.classList.toggle("fade-left", more > 2 && !atStart);
      wrap.classList.toggle("fade-right", more > 2 && !atEnd);
    };
    const step = () => Math.max(160, row.clientWidth * 0.8);
    prev.addEventListener("click", () => row.scrollBy({ left: -step() }));
    next.addEventListener("click", () => row.scrollBy({ left: step() }));
    row.addEventListener("scroll", update, { passive: true });
    row.addEventListener(
      "wheel",
      (e) => {
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX) || row.scrollWidth <= row.clientWidth) return;
        const before = row.scrollLeft;
        row.scrollLeft += e.deltaY;
        if (row.scrollLeft !== before) e.preventDefault(); // at either end, let the page scroll
      },
      { passive: false },
    );
    new ResizeObserver(update).observe(row);
    update();

    row.addEventListener("click", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-story]");
      if (!li) return;
      seen[li.dataset.story!] = Date.now();
      // Forget bubbles older than a month so the list stays small.
      const cutoff = Date.now() - 30 * 86_400_000;
      for (const k of Object.keys(seen)) if (seen[k] < cutoff) delete seen[k];
      try {
        localStorage.setItem(KEY, JSON.stringify(seen));
      } catch {}
    });
  }
</script>
