---
/** People asking to follow my private profile: accept or decline. */
import Layout from "@/layouts/Layout.astro";
import PersonRow from "@/components/social/PersonRow.astro";
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { followersOf } from "@/lib/social";

const { lang } = Astro.locals;
const user = Astro.locals.user!;
const t = makeT(lang, common, social);
const requests = await followersOf(user.id, "pending");
---

<Layout title={`${t("requests.title")} — WishDrop`} noindex mainClass="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-10">
  <h1 class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{t("requests.title")}</h1>
  <p class="mt-1 text-ink-soft">{t("requests.intro")}</p>

  {
    requests.length === 0 ? (
      <div class="card mt-6 p-8 text-center">
        <div class="text-4xl">📭</div>
        <p class="mt-3 text-sm text-ink-soft">{t("requests.empty")}</p>
      </div>
    ) : (
      <ul class="card mt-6 divide-y divide-black/5 px-5">
        {requests.map((p) => (
          <PersonRow person={p}>
            <div class="flex gap-2" data-request={p.id} data-l-accepted={t("requests.accepted")} data-l-declined={t("requests.declined")}>
              <button type="button" data-action="accept" class="btn btn-primary !px-3.5 !py-2 text-xs">{t("requests.accept")}</button>
              <button type="button" data-action="decline" class="btn btn-ghost !px-3.5 !py-2 text-xs">{t("requests.decline")}</button>
            </div>
          </PersonRow>
        ))}
      </ul>
    )
  }

  <script>
    document.querySelectorAll<HTMLElement>("[data-request]").forEach((box) => {
      box.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((b) => {
        b.addEventListener("click", async () => {
          const action = b.dataset.action!;
          box.querySelectorAll("button").forEach((x) => (x.disabled = true));
          const res = await fetch("/api/follows/requests", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ user_id: box.dataset.request, action }),
          });
          if (res.ok) {
            box.innerHTML = `<span class="text-sm font-medium ${action === "accept" ? "text-emerald-600" : "text-ink-soft"}"></span>`;
            box.firstElementChild!.textContent = action === "accept" ? box.dataset.lAccepted! : box.dataset.lDeclined!;
          } else {
            box.querySelectorAll("button").forEach((x) => (x.disabled = false));
          }
        });
      });
    });
  </script>
</Layout>
