---
/**
 * Every page: <head> (SEO, hreflang, PWA, fonts), header with the language and
 * account menus, footer, mobile tab bar, and the shared donate/confirm modals.
 */
import "@/styles/global.css";
import { LANGS, LANG_NAMES, OG_LOCALE, localePath, makeT, DEFAULT_LANG } from "@/lib/i18n";
import common from "@/i18n/common";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import DonateModal from "@/components/DonateModal.astro";
import ConfirmModal from "@/components/ConfirmModal.astro";

interface Props {
  /** Full <title>; defaults to the home title. Pages pass "My lists — WishDrop". */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Classes on <main>. */
  mainClass?: string;
  /** Show the mobile tab bar (adds bottom padding on phones). */
  tabbar?: boolean;
  footer?: boolean;
  /** The site header; the public list page has its own hero instead. */
  header?: boolean;
}

const { lang, path, user } = Astro.locals;
const t = makeT(lang, common);
const {
  title = t("meta.title"),
  description = t("meta.description"),
  noindex = false,
  mainClass,
  tabbar = true,
  footer = true,
  header = true,
} = Astro.props;

const site = import.meta.env.SITE ?? "https://wishdrop.site";
const href = (p: string) => localePath(lang, p);
const abs = (l: typeof lang) => new URL(localePath(l, path), site).href;
const displayName = user ? user.name || user.email.split("@")[0] : "";
const tabActive = (p: string) => path === p;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(lang)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LANG)} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WishDrop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={new URL("/og.png", site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WishDrop" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", site).href} />
    <!-- Favicons — SVG for modern browsers, PNG 96×96 for Google Search -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <!-- PWA: installable on phones ("Add to Home Screen") -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="WishDrop" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class:list={["min-h-screen antialiased", { "has-tabbar": tabbar }]}>
    {
      header && (
    <header class="sticky top-0 z-30 border-b border-black/5 bg-[#fffbf7]/80 backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={href("/")} class="flex shrink-0 items-center gap-2 font-display text-lg font-extrabold tracking-tight text-ink sm:text-xl">
          <span class="grid h-9 w-9 place-items-center rounded-xl gift-gradient text-white shadow-sm">
            <Icon name="gift" class="h-5 w-5" />
          </span>
          <span>Wish<span class="gradient-text">Drop</span></span>
        </a>
        <div class="flex shrink-0 items-center gap-1.5 sm:gap-3">
          <!-- Language switcher (dropdown) -->
          <div class="relative" id="lang-menu">
            <button
              id="lang-menu-btn"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label={t("nav.language")}
              class="flex items-center gap-1.5 rounded-full border border-black/5 bg-white/70 px-2.5 py-1.5 text-xs font-bold text-ink shadow-sm transition hover:shadow-md"
            >
              <Icon name="globe" class="h-4 w-4 text-accent-600" />
              <span>{lang.toUpperCase()}</span>
              <Icon name="chevronDown" class="h-3.5 w-3.5 text-ink-soft/50" />
            </button>
            <div id="lang-menu-panel" class="absolute right-0 mt-2 hidden w-44 origin-top-right rounded-2xl border border-black/5 bg-white p-1.5 shadow-xl">
              {
                LANGS.map((l) => (
                  <a
                    href={localePath(l, path) + Astro.url.search}
                    data-lang-link={l}
                    class:list={[
                      "flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition",
                      l === lang ? "bg-accent-50 text-accent-700" : "text-ink hover:bg-gray-50",
                    ]}
                  >
                    <span>{LANG_NAMES[l]}</span>
                    {l === lang && <Icon name="check" class="h-4 w-4" strokeWidth={2.5} />}
                  </a>
                ))
              }
            </div>
          </div>
          {
            user ? (
              <div class="relative" id="user-menu">
                <button
                  id="user-menu-btn"
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  class="flex items-center gap-2 rounded-full border border-black/5 bg-white/70 py-1 pl-1 pr-2 shadow-sm transition hover:shadow-md"
                >
                  <Avatar user={user} size={32} class="h-8 w-8" alt={displayName} />
                  <span class="hidden max-w-[14ch] truncate text-sm font-medium text-ink sm:block">{displayName}</span>
                  <Icon name="chevronDown" class="h-4 w-4 text-ink-soft/60" />
                </button>
                <div id="user-menu-panel" class="absolute right-0 mt-2 hidden w-60 origin-top-right rounded-2xl border border-black/5 bg-white p-2 shadow-xl">
                  <div class="flex items-center gap-3 px-2 py-2">
                    <Avatar user={user} size={40} class="h-10 w-10" />
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold text-ink">{displayName}</p>
                      <p class="truncate text-xs text-ink-soft">{user.email}</p>
                    </div>
                  </div>
                  <div class="my-1 h-px bg-black/5" />
                  <a href={href("/dashboard")} class="flex items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-medium text-ink transition hover:bg-gray-50">
                    <Icon name="list" class="h-4 w-4 text-accent-600" /> {t("nav.myLists")}
                  </a>
                  <a href={href("/dashboard/reservations")} class="flex items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-medium text-ink transition hover:bg-gray-50">
                    <Icon name="heart" class="h-4 w-4 text-accent-600" /> {t("nav.myReservations")}
                  </a>
                  <a href={href("/settings")} class="flex items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-medium text-ink transition hover:bg-gray-50">
                    <Icon name="settings" class="h-4 w-4 text-accent-600" /> {t("nav.settings")}
                  </a>
                  <button id="logout-btn" type="button" class="flex w-full items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-medium text-rose-600 transition hover:bg-rose-50">
                    <Icon name="logout" class="h-4 w-4" /> {t("nav.logout")}
                  </button>
                </div>
              </div>
            ) : (
              <div class="hidden items-center gap-3 sm:flex">
                <a href={href("/login")} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:text-ink">{t("nav.login")}</a>
                <a href={href("/register")} class="btn btn-primary whitespace-nowrap !px-4 !py-2 text-sm">{t("nav.signup")}</a>
              </div>
            )
          }
        </div>
      </nav>
    </header>
      )
    }

    <main class={mainClass}>
      <slot />
    </main>

    {
      footer && (
        <footer class="mt-12 border-t border-black/5 sm:mt-20">
          <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
            <!-- Support — subtle, not shouty -->
            <div class="text-center">
              <h2 class="font-display text-lg font-bold tracking-tight">{t("footer.free")}</h2>
              <p class="mx-auto mt-1.5 max-w-sm text-sm text-ink-soft">{t("footer.support")}</p>
              <button data-donate-open class="btn btn-ghost mt-4 !px-5 !py-2.5 text-sm">{t("footer.supportBtn")}</button>
            </div>
            {
              !user && (
                <p class="mt-8 text-center text-sm text-ink-soft">
                  {t("footer.wantList")}{" "}
                  <a href={href("/register")} class="font-semibold text-accent-600 hover:underline">{t("footer.createFree")}</a>
                </p>
              )
            }
            <!-- Legal / trust links -->
            <nav class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 border-t border-black/5 pt-6 text-sm text-ink-soft">
              <a href={href("/privacy")} class="hover:text-ink hover:underline">{t("footer.privacy")}</a>
              <a href={href("/terms")} class="hover:text-ink hover:underline">{t("footer.terms")}</a>
              <a href={href("/contact")} class="hover:text-ink hover:underline">{t("footer.contact")}</a>
            </nav>
            <!-- Bottom bar -->
            <div class="mt-6 flex flex-col items-center justify-between gap-4 pt-2 sm:flex-row">
              <a href={href("/")} class="flex items-center gap-2 font-display text-base font-extrabold text-ink">
                <span class="grid h-7 w-7 place-items-center rounded-lg gift-gradient text-white">
                  <Icon name="gift" class="h-4 w-4" />
                </span>
                <span>Wish<span class="gradient-text">Drop</span></span>
              </a>
              <p class="text-sm text-ink-soft/80">
                {t("footer.madeBy", { year })}{" "}
                <a href="https://banstudio.dev/" target="_blank" rel="noopener" class="font-semibold text-accent-600 hover:underline">Ban Studio</a>
              </p>
            </div>
          </div>
        </footer>
      )
    }

    {
      tabbar && (
        <nav
          class="mobile-tabbar fixed inset-x-0 bottom-0 z-40 flex items-stretch border-t border-black/5 bg-[#fffbf7]/95 backdrop-blur-md sm:hidden"
          aria-label={t("nav.navigation")}
        >
          <a
            href={href("/")}
            class:list={[
              "flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-[11px] font-semibold transition",
              tabActive("/") ? "text-accent-600" : "text-ink-soft/70",
            ]}
          >
            <Icon name="home" class="h-6 w-6" /> {t("nav.home")}
          </a>
          <a
            href={user ? href("/dashboard") + "#new" : href("/register")}
            class="flex flex-1 flex-col items-center justify-center gap-1 py-1.5 text-[11px] font-semibold text-ink-soft/70"
          >
            <span class="-mt-5 grid h-12 w-12 place-items-center rounded-2xl gift-gradient text-white shadow-lg">
              <Icon name="plus" class="h-6 w-6" strokeWidth={2.5} />
            </span>
            <span class="-mt-1">{t("nav.create")}</span>
          </a>
          {
            user ? (
              <a
                href={href("/settings")}
                class:list={[
                  "flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-[11px] font-semibold transition",
                  tabActive("/settings") ? "text-accent-600" : "text-ink-soft/70",
                ]}
              >
                <Avatar user={user} size={24} class="h-6 w-6" /> {t("nav.account")}
              </a>
            ) : (
              <a
                href={href("/login")}
                class:list={[
                  "flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-[11px] font-semibold transition",
                  tabActive("/login") ? "text-accent-600" : "text-ink-soft/70",
                ]}
              >
                <Icon name="login" class="h-6 w-6" /> {t("nav.login")}
              </a>
            )
          }
        </nav>
      )
    }

    <DonateModal />
    <ConfirmModal />

    <script>
      // Header menus (language + account), logout, and remembering the chosen language.
      function dropdown(rootId: string, btnId: string, panelId: string) {
        const root = document.getElementById(rootId);
        const btn = document.getElementById(btnId);
        const panel = document.getElementById(panelId);
        const close = () => {
          panel?.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
        };
        btn?.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = panel?.classList.toggle("hidden") === false;
          btn.setAttribute("aria-expanded", open ? "true" : "false");
        });
        document.addEventListener("click", (e) => {
          if (root && !root.contains(e.target as Node)) close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      }
      dropdown("user-menu", "user-menu-btn", "user-menu-panel");
      dropdown("lang-menu", "lang-menu-btn", "lang-menu-panel");

      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/";
      });

      document.querySelectorAll<HTMLElement>("[data-lang-link]").forEach((a) => {
        a.addEventListener("click", () => {
          document.cookie = `wd_lang=${a.dataset.langLink};path=/;max-age=31536000;samesite=lax`;
        });
      });
    </script>

    <script is:inline>
      (function () {
        function isInternalNav(a) {
          if (!a || a.target === "_blank" || a.hasAttribute("download")) return false;
          var href = a.getAttribute("href");
          if (!href || href[0] === "#" || /^(mailto:|tel:|javascript:)/i.test(href)) return false;
          var url;
          try {
            url = new URL(a.href);
          } catch (e) {
            return false;
          }
          if (url.origin !== location.origin) return false;
          // Same page (just a hash/query no-op)? don't show a loader.
          return url.pathname !== location.pathname || url.search !== location.search;
        }

        // Subtle feedback on list-card navigation only — dim the card, no
        // content swap or spinner (buttons must not resize).
        document.addEventListener(
          "click",
          function (e) {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var a = e.target.closest("a[href]");
            if (!a || a.classList.contains("btn") || !isInternalNav(a)) return;
            var card = a.closest("[data-wishlist-id], article");
            if (card) card.classList.add("is-navigating");
          },
          true,
        );

        // Coming back via bfcache: clear any dimmed card.
        window.addEventListener("pageshow", function () {
          document.querySelectorAll(".is-navigating").forEach(function (el) {
            el.classList.remove("is-navigating");
          });
        });
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
