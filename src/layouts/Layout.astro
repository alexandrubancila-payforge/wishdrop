---
/**
 * Every page: <head> (SEO, hreflang, PWA, fonts), header with the language and
 * account menus, footer, mobile tab bar, and the shared donate/confirm modals.
 */
import "@/styles/global.css";
import { LANGS, LANG_NAMES, OG_LOCALE, localePath, makeT, DEFAULT_LANG } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { pendingCount } from "@/lib/social";
import { unreadCount } from "@/lib/notifications";
import notifStrings from "@/i18n/notifications";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import DonateModal from "@/components/DonateModal.astro";
import ConfirmModal from "@/components/ConfirmModal.astro";

interface Props {
  /** Full <title>; defaults to the home title. Pages pass "My lists — WishDrop". */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Classes on <main>. */
  mainClass?: string;
  /** Show the mobile tab bar (adds bottom padding on phones). */
  tabbar?: boolean;
  footer?: boolean;
  /** The site header; the public list page has its own hero instead. */
  header?: boolean;
}

const { lang, path, user } = Astro.locals;
const t = makeT(lang, common, social);
const [requests, unread] = user ? await Promise.all([pendingCount(user.id), unreadCount(user.id)]) : [0, 0];
const bellLabel = makeT(lang, notifStrings)("bell");
const profileHref = user?.username ? localePath(lang, `/@${user.username}`) : localePath(lang, "/settings") + "#public-profile";
const {
  title = t("meta.title"),
  description = t("meta.description"),
  noindex = false,
  mainClass,
  tabbar = true,
  footer = true,
  header = true,
} = Astro.props;

const site = import.meta.env.SITE ?? "https://wishdrop.site";
const href = (p: string) => localePath(lang, p);
const abs = (l: typeof lang) => new URL(localePath(l, path), site).href;
const displayName = user ? user.name || user.email.split("@")[0] : "";
const tabActive = (p: string) => path === p;
const onProfile = !!user?.username && (path === `/@${user.username}` || path.startsWith(`/@${user.username}/`));
const tabs = user
  ? [
      { href: href("/"), label: t("nav.feed"), icon: "house", active: path === "/" },
      { href: href("/search"), label: t("nav.searchShort"), icon: "magnifying-glass", active: path === "/search" },
      { href: href("/dashboard") + "#new", label: t("nav.create"), icon: "plus", create: true },
      { href: href("/dashboard"), label: t("nav.listsShort"), icon: "list-heart", active: path === "/dashboard" || path.startsWith("/dashboard/") },
      { href: profileHref, label: t("nav.profileShort"), avatar: true, active: onProfile || path.startsWith("/settings") },
    ]
  : [
      { href: href("/"), label: t("nav.feed"), icon: "house", active: path === "/" },
      { href: href("/search"), label: t("nav.searchShort"), icon: "magnifying-glass", active: path === "/search" },
      { href: href("/register"), label: t("nav.create"), icon: "plus", create: true },
      { href: href("/example"), label: t("nav.example"), icon: "sparkle", active: path === "/example" },
      { href: href("/login"), label: t("nav.login"), icon: "sign-in", active: path === "/login" },
    ];
const year = new Date().getFullYear();
/** Share preview per language; a new file name makes apps fetch it again. */
const ogImage = new URL(`/og/wishdrop-${lang}.png`, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(lang)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LANG)} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WishDrop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WishDrop" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Favicons — SVG for modern browsers, PNG 96×96 for Google Search -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
    <!-- PWA: installable on phones ("Add to Home Screen") -->
    <link rel="manifest" href="/manifest.webmanifest?v=2" />
    <meta name="theme-color" content="#fffaf7" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="WishDrop" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class:list={["flex min-h-screen flex-col antialiased", { "has-tabbar": tabbar }]}>
    {
      header && (
        <header class="sticky top-0 z-30 bg-paper/85 backdrop-blur-md">
          <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
            <a href={href("/")} class="flex min-w-0 items-center gap-2.5 text-lg font-extrabold tracking-tight text-ink sm:text-xl">
              <span class="grid h-9 w-9 place-items-center rounded-2xl gift-gradient text-white shadow-coral">
                <Icon name="gift" weight="fill" class="h-5 w-5" />
              </span>
              <span>Wish<span class="text-accent-600">Drop</span></span>
            </a>
            <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
              <!-- Find people -->
              <a
                href={href("/search")}
                aria-label={t("nav.search")}
                title={t("nav.search")}
                class:list={[
                  "grid h-10 w-10 place-items-center rounded-full bg-white shadow-soft transition hover:text-accent-600",
                  path === "/search" ? "text-accent-600" : "text-ink",
                ]}
              >
                <Icon name="magnifying-glass" weight={path === "/search" ? "bold" : "regular"} class="h-5 w-5" />
              </a>
              {
                user && (
                  <a
                    href={href("/notifications")}
                    aria-label={unread ? `${bellLabel} (${unread})` : bellLabel}
                    title={bellLabel}
                    class:list={[
                      "relative grid h-10 w-10 place-items-center rounded-full bg-white shadow-soft transition hover:text-accent-600",
                      path === "/notifications" ? "text-accent-600" : "text-ink",
                    ]}
                  >
                    <Icon name="bell" weight={path === "/notifications" ? "fill" : "regular"} class="h-5 w-5" />
                    {unread > 0 && (
                      <span class="absolute -right-1 -top-1 grid h-5 min-w-5 place-items-center rounded-full bg-accent-600 px-1 text-[11px] font-bold leading-none text-white ring-2 ring-paper">
                        {unread > 9 ? "9+" : unread}
                      </span>
                    )}
                  </a>
                )
              }
              <!-- Language switcher (dropdown) -->
              <div class="relative" id="lang-menu">
                <button
                  id="lang-menu-btn"
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-label={t("nav.language")}
                  class="flex h-10 items-center gap-1.5 rounded-full bg-white px-2.5 text-xs font-bold text-ink shadow-soft transition hover:text-accent-600 sm:px-3"
                >
                  <Icon name="globe" class="hidden h-[18px] w-[18px] text-accent-500 sm:block" />
                  <span>{lang.toUpperCase()}</span>
                  <Icon name="caret-down" weight="bold" class="h-3 w-3 text-ink-soft" />
                </button>
                <div id="lang-menu-panel" class="absolute right-0 mt-2 hidden w-44 origin-top-right rounded-2xl bg-white p-1.5 shadow-lift ring-1 ring-line">
                  {
                    LANGS.map((l) => (
                      <a
                        href={localePath(l, path) + Astro.url.search}
                        data-lang-link={l}
                        class:list={[
                          "flex items-center justify-between rounded-xl px-3 py-2 text-sm font-semibold transition",
                          l === lang ? "bg-accent-50 text-accent-700" : "text-ink hover:bg-sand",
                        ]}
                      >
                        <span>{LANG_NAMES[l]}</span>
                        {l === lang && <Icon name="check" weight="bold" class="h-4 w-4" />}
                      </a>
                    ))
                  }
                </div>
              </div>
              {
                user ? (
                  <div class="relative" id="user-menu">
                    <button
                      id="user-menu-btn"
                      type="button"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-label={displayName}
                      class="flex h-10 items-center gap-2 rounded-full bg-white p-1 shadow-soft transition hover:text-accent-600 sm:pr-3"
                    >
                      <span class="relative">
                        <Avatar user={user} size={32} class="h-8 w-8" alt={displayName} />
                        {requests > 0 && <span class="absolute -right-0.5 -top-0.5 h-3 w-3 rounded-full border-2 border-white bg-accent-500" />}
                      </span>
                      <span class="hidden max-w-[14ch] truncate text-sm font-semibold text-ink sm:block">{displayName}</span>
                      <Icon name="caret-down" weight="bold" class="hidden h-3 w-3 text-ink-soft sm:block" />
                    </button>
                    <div id="user-menu-panel" class="absolute right-0 mt-2 hidden w-64 origin-top-right rounded-3xl bg-white p-2 shadow-lift ring-1 ring-line">
                      <a href={profileHref} class="flex items-center gap-3 rounded-2xl px-2 py-2 transition hover:bg-sand">
                        <Avatar user={user} size={44} class="h-11 w-11" />
                        <div class="min-w-0">
                          <p class="truncate text-sm font-bold text-ink">{displayName}</p>
                          <p class="truncate text-xs text-ink-soft">{user.username ? `@${user.username}` : user.email}</p>
                        </div>
                      </a>
                      <div class="my-1.5 h-px bg-line" />
                      {[
                        { href: profileHref, icon: "user-circle", label: t("nav.profile") },
                        { href: href("/dashboard"), icon: "list-heart", label: t("nav.myLists") },
                        { href: href("/dashboard/reservations"), icon: "hand-heart", label: t("nav.myReservations") },
                      ].map((item) => (
                        <a href={item.href} class="flex items-center gap-3 rounded-xl px-2.5 py-2 text-sm font-semibold text-ink transition hover:bg-sand">
                          <Icon name={item.icon} class="h-5 w-5 text-accent-500" /> {item.label}
                        </a>
                      ))}
                      {(user.is_private || requests > 0) && (
                        <a href={href("/requests")} class="flex items-center gap-3 rounded-xl px-2.5 py-2 text-sm font-semibold text-ink transition hover:bg-sand">
                          <Icon name="user-plus" class="h-5 w-5 text-accent-500" />
                          <span class="flex-1">{t("nav.requests")}</span>
                          {requests > 0 && <span class="chip bg-accent-500 !py-0.5 text-white">{requests}</span>}
                        </a>
                      )}
                      <a href={href("/settings")} class="flex items-center gap-3 rounded-xl px-2.5 py-2 text-sm font-semibold text-ink transition hover:bg-sand">
                        <Icon name="gear" class="h-5 w-5 text-accent-500" /> {t("nav.settings")}
                      </a>
                      <div class="my-1.5 h-px bg-line" />
                      <button id="logout-btn" type="button" class="flex w-full items-center gap-3 rounded-xl px-2.5 py-2 text-sm font-semibold text-accent-700 transition hover:bg-accent-50">
                        <Icon name="sign-out" class="h-5 w-5" /> {t("nav.logout")}
                      </button>
                    </div>
                  </div>
                ) : (
                  <div class="hidden items-center gap-2 sm:flex">
                    <a href={href("/login")} class="rounded-full px-4 py-2.5 text-sm font-semibold text-ink-soft transition hover:text-ink">{t("nav.login")}</a>
                    <a href={href("/register")} class="btn btn-primary !px-5 !py-2.5 text-sm">{t("nav.signup")}</a>
                  </div>
                )
              }
            </div>
          </nav>
        </header>
      )
    }

    <!-- flex-1 pushes the footer to the bottom on short pages; w-full keeps mx-auto/max-w working inside the flex column. -->
    <main class:list={["w-full flex-1", mainClass]}>
      <slot />
    </main>

    {
      footer && (
        <footer class="mt-16 sm:mt-24">
          <div class="mx-auto max-w-5xl px-4 pb-10 sm:px-6 sm:pb-14">
            <!-- Support — subtle, not shouty -->
            <div class="card flex flex-col items-center gap-4 px-6 py-8 text-center sm:flex-row sm:text-left">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-accent-100 text-accent-600">
                <Icon name="coffee" class="h-7 w-7" />
              </span>
              <div class="flex-1">
                <h2 class="text-lg font-extrabold tracking-tight">{t("footer.free")}</h2>
                <p class="mt-1 text-sm text-ink-soft">{t("footer.support")}</p>
              </div>
              <button data-donate-open class="btn btn-soft shrink-0 !px-5 !py-3 text-sm">{t("footer.supportBtn")}</button>
            </div>
            {
              !user && (
                <p class="mt-6 text-center text-sm text-ink-soft">
                  {t("footer.wantList")}{" "}
                  <a href={href("/register")} class="font-bold text-accent-700 hover:underline">{t("footer.createFree")}</a>
                </p>
              )
            }
            <!-- Legal / trust links + brand -->
            <div class="mt-8 flex flex-col items-center justify-between gap-4 sm:flex-row">
              <a href={href("/")} class="flex items-center gap-2 text-base font-extrabold text-ink">
                <span class="grid h-8 w-8 place-items-center rounded-xl gift-gradient text-white">
                  <Icon name="gift" weight="fill" class="h-4 w-4" />
                </span>
                <span>Wish<span class="text-accent-600">Drop</span></span>
              </a>
              <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-semibold text-ink-soft">
                <a href={href("/privacy")} class="hover:text-ink">{t("footer.privacy")}</a>
                <a href={href("/terms")} class="hover:text-ink">{t("footer.terms")}</a>
                <a href={href("/contact")} class="hover:text-ink">{t("footer.contact")}</a>
              </nav>
              <p class="text-sm text-ink-soft">
                {t("footer.madeBy", { year })}{" "}
                <a href="https://banstudio.dev/" target="_blank" rel="noopener" class="font-bold text-accent-700 hover:underline">Ban Studio</a>
              </p>
            </div>
          </div>
        </footer>
      )
    }

    {
      tabbar && (
        <nav
          class="mobile-tabbar fixed inset-x-0 bottom-0 z-40 flex items-end justify-around bg-white px-2 pt-1.5 sm:hidden"
          aria-label={t("nav.navigation")}
        >
          {tabs.map((tab) =>
            tab.create ? (
              <a href={tab.href} class="flex flex-1 flex-col items-center gap-1 pb-2 text-[11px] font-semibold text-ink-soft" aria-label={tab.label}>
                <span class="-mt-6 grid h-14 w-14 place-items-center rounded-full bg-accent-600 text-white shadow-coral ring-4 ring-white">
                  <Icon name="plus" weight="bold" class="h-6 w-6" />
                </span>
                <span>{tab.label}</span>
              </a>
            ) : (
              <a
                href={tab.href}
                aria-current={tab.active ? "page" : undefined}
                class:list={[
                  "flex flex-1 flex-col items-center gap-1 pb-2 pt-1.5 text-[11px] font-semibold transition",
                  tab.active ? "text-accent-600" : "text-ink-soft",
                ]}
              >
                {tab.avatar && user ? (
                  <span class:list={["rounded-full", tab.active && "ring-2 ring-accent-500 ring-offset-2"]}>
                    <Avatar user={user} size={26} class="h-[26px] w-[26px]" />
                  </span>
                ) : (
                  <Icon name={tab.icon!} weight={tab.active ? "fill" : "regular"} class="h-[26px] w-[26px]" />
                )}
                <span>{tab.label}</span>
              </a>
            ),
          )}
        </nav>
      )
    }

    <DonateModal />
    <ConfirmModal />

    <script>
      // Header menus (language + account), logout, and remembering the chosen language.
      function dropdown(rootId: string, btnId: string, panelId: string) {
        const root = document.getElementById(rootId);
        const btn = document.getElementById(btnId);
        const panel = document.getElementById(panelId);
        const close = () => {
          panel?.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
        };
        btn?.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = panel?.classList.toggle("hidden") === false;
          btn.setAttribute("aria-expanded", open ? "true" : "false");
        });
        document.addEventListener("click", (e) => {
          if (root && !root.contains(e.target as Node)) close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      }
      dropdown("user-menu", "user-menu-btn", "user-menu-panel");
      dropdown("lang-menu", "lang-menu-btn", "lang-menu-panel");

      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/";
      });

      document.querySelectorAll<HTMLElement>("[data-lang-link]").forEach((a) => {
        a.addEventListener("click", () => {
          document.cookie = `wd_lang=${a.dataset.langLink};path=/;max-age=31536000;samesite=lax`;
        });
      });
    </script>

    <script is:inline>
      (function () {
        function isInternalNav(a) {
          if (!a || a.target === "_blank" || a.hasAttribute("download")) return false;
          var href = a.getAttribute("href");
          if (!href || href[0] === "#" || /^(mailto:|tel:|javascript:)/i.test(href)) return false;
          var url;
          try {
            url = new URL(a.href);
          } catch (e) {
            return false;
          }
          if (url.origin !== location.origin) return false;
          // Same page (just a hash/query no-op)? don't show a loader.
          return url.pathname !== location.pathname || url.search !== location.search;
        }

        // Subtle feedback on list-card navigation only — dim the card, no
        // content swap or spinner (buttons must not resize).
        document.addEventListener(
          "click",
          function (e) {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var a = e.target.closest("a[href]");
            if (!a || a.classList.contains("btn") || !isInternalNav(a)) return;
            var card = a.closest("[data-wishlist-id], article");
            if (card) card.classList.add("is-navigating");
          },
          true,
        );

        // Coming back via bfcache: clear any dimmed card.
        window.addEventListener("pageshow", function () {
          document.querySelectorAll(".is-navigating").forEach(function (el) {
            el.classList.remove("is-navigating");
          });
        });
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
