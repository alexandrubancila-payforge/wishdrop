---
/** "Account settings" heading + the Profile · Password · Account tabs. */
import { makeT, localePath } from "@/lib/i18n";
import strings from "@/i18n/settings";
import Icon from "@/components/Icon.astro";

interface Props {
  active: "profile" | "password" | "account";
}
const { active } = Astro.props;
const { lang } = Astro.locals;
const t = makeT(lang, strings);
const tabs = [
  { key: "profile", href: localePath(lang, "/settings"), label: t("tabProfile"), icon: "user" },
  { key: "password", href: localePath(lang, "/settings/password"), label: t("tabPassword"), icon: "key" },
  { key: "account", href: localePath(lang, "/settings/account"), label: t("tabAccount"), icon: "gear" },
] as const;
---

<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t("heading")}</h1>
<nav class="mt-5 grid grid-cols-3 gap-1 rounded-full border border-line bg-white p-1 text-sm font-semibold shadow-soft">
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        aria-current={tab.key === active ? "page" : undefined}
        class:list={[
          "flex min-w-0 items-center justify-center gap-1.5 rounded-full px-2 py-2.5 text-center transition",
          tab.key === active ? "bg-accent-100 text-accent-700" : "text-ink-soft hover:bg-accent-50 hover:text-ink",
        ]}
      >
        <Icon name={tab.icon} weight={tab.key === active ? "fill" : "regular"} class="h-4 w-4 shrink-0" />
        <span class="truncate">{tab.label}</span>
      </a>
    ))
  }
</nav>
