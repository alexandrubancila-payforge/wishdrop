---
/**
 * Big gradient "Want your own gift list?" banner under a public list (signed-out visitors).
 * Rendered at the end of <main>; on the live site it sat right after </main> with the same width.
 */
import { localePath, makeT, type Lang } from "@/lib/i18n";
import publiclist from "@/i18n/publiclist";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = makeT(lang, publiclist);
---

<section class="mt-16"> <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-violet-600 via-fuchsia-500 to-pink-400 px-8 py-12 text-center text-white shadow-2xl shadow-violet-300/60"> <!-- Glow blobs --> <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div> <div class="pointer-events-none absolute -bottom-12 -left-12 h-48 w-48 rounded-full bg-pink-300/20 blur-3xl" aria-hidden="true"></div> <!-- Scattered icons --> <span aria-hidden="true" style="position:absolute;font-size:26px;opacity:0.22;top:12%;left:6%;transform:rotate(-18deg);user-select:none;line-height:1;pointer-events:none">🎁</span><span aria-hidden="true" style="position:absolute;font-size:20px;opacity:0.18;top:68%;left:3%;transform:rotate(14deg);user-select:none;line-height:1;pointer-events:none">⭐</span><span aria-hidden="true" style="position:absolute;font-size:16px;opacity:0.15;top:40%;left:11%;transform:rotate(-8deg);user-select:none;line-height:1;pointer-events:none">🎀</span><span aria-hidden="true" style="position:absolute;font-size:24px;opacity:0.2;top:82%;left:15%;transform:rotate(22deg);user-select:none;line-height:1;pointer-events:none">🎊</span><span aria-hidden="true" style="position:absolute;font-size:15px;opacity:0.14;top:22%;left:22%;transform:rotate(10deg);user-select:none;line-height:1;pointer-events:none">💝</span><span aria-hidden="true" style="position:absolute;font-size:14px;opacity:0.16;top:8%;left:40%;transform:rotate(-12deg);user-select:none;line-height:1;pointer-events:none">⭐</span><span aria-hidden="true" style="position:absolute;font-size:18px;opacity:0.17;top:88%;left:34%;transform:rotate(8deg);user-select:none;line-height:1;pointer-events:none">🎀</span><span aria-hidden="true" style="position:absolute;font-size:16px;opacity:0.15;top:6%;left:62%;transform:rotate(16deg);user-select:none;line-height:1;pointer-events:none">🎁</span><span aria-hidden="true" style="position:absolute;font-size:22px;opacity:0.2;top:84%;left:58%;transform:rotate(-20deg);user-select:none;line-height:1;pointer-events:none">💝</span><span aria-hidden="true" style="position:absolute;font-size:15px;opacity:0.14;top:18%;left:76%;transform:rotate(-6deg);user-select:none;line-height:1;pointer-events:none">🎊</span><span aria-hidden="true" style="position:absolute;font-size:24px;opacity:0.2;top:58%;left:88%;transform:rotate(18deg);user-select:none;line-height:1;pointer-events:none">⭐</span><span aria-hidden="true" style="position:absolute;font-size:17px;opacity:0.16;top:30%;left:92%;transform:rotate(-14deg);user-select:none;line-height:1;pointer-events:none">🎀</span><span aria-hidden="true" style="position:absolute;font-size:28px;opacity:0.22;top:78%;left:82%;transform:rotate(12deg);user-select:none;line-height:1;pointer-events:none">🎁</span><span aria-hidden="true" style="position:absolute;font-size:14px;opacity:0.13;top:46%;left:70%;transform:rotate(24deg);user-select:none;line-height:1;pointer-events:none">💝</span><span aria-hidden="true" style="position:absolute;font-size:16px;opacity:0.15;top:90%;left:94%;transform:rotate(-10deg);user-select:none;line-height:1;pointer-events:none">⭐</span> <!-- Content --> <div class="relative z-10"> <div class="text-5xl">🎁</div> <h2 class="mt-4 font-display text-3xl font-extrabold">{t("cta.heading")}</h2> <div class="mt-5 flex flex-wrap justify-center gap-2"> <span class="rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold backdrop-blur-sm">{t("cta.free")}</span><span class="rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold backdrop-blur-sm">{t("cta.noApp")}</span><span class="rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold backdrop-blur-sm">{t("cta.ready")}</span> </div> <a href={localePath(lang, "/register")} class="mt-7 inline-flex items-center gap-2 rounded-2xl bg-white px-8 py-3.5 text-base font-bold text-violet-700 shadow-lg transition hover:bg-violet-50 hover:-translate-y-0.5 hover:shadow-xl">{t("cta.button")}</a> </div> </div> </section>
