---
/**
 * "Want your own gift list?" card under a public list (signed-out visitors).
 * Rendered at the end of <main>.
 */
import Icon from "@/components/Icon.astro";
import { localePath, makeT, type Lang } from "@/lib/i18n";
import publiclist from "@/i18n/publiclist";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = makeT(lang, publiclist);
---

<section class="mt-14">
  <div class="card flex flex-col items-center !rounded-3xl px-6 py-10 text-center sm:py-12">
    <span class="grid h-16 w-16 place-items-center rounded-3xl bg-accent-100 text-accent-600">
      <Icon name="gift" class="h-8 w-8" />
    </span>
    <h2 class="mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl">{t("cta.heading")}</h2>
    <div class="mt-5 flex flex-wrap justify-center gap-2">
      <span class="chip bg-mint !px-3.5 !py-1.5 text-mint-ink"><Icon name="check" weight="bold" class="h-3.5 w-3.5" />{t("cta.free")}</span>
      <span class="chip bg-lav !px-3.5 !py-1.5 text-lav-ink"><Icon name="device-mobile" class="h-3.5 w-3.5" />{t("cta.noApp")}</span>
      <span class="chip bg-sun !px-3.5 !py-1.5 text-sun-ink"><Icon name="clock" class="h-3.5 w-3.5" />{t("cta.ready")}</span>
    </div>
    <a href={localePath(lang, "/register")} class="btn btn-primary mt-7 !px-7 !py-3.5">{t("cta.button")}</a>
  </div>
</section>
