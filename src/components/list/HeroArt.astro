---
/** Floating pastel icon tiles on the right of a public list's hero (desktop only). Flat colors, no gradients. */
import Icon from "@/components/Icon.astro";

const TILES = [
  { icon: "gift", tint: "bg-accent-100 text-accent-600", box: "h-24 w-24 rounded-[1.75rem]", size: "h-12 w-12", style: "top:34%;left:38%;--tilt:-8deg;animation-duration:5.5s" },
  { icon: "balloon", tint: "bg-lav text-lav-ink", box: "h-16 w-16 rounded-3xl", size: "h-8 w-8", style: "top:4%;left:70%;--tilt:8deg;animation-duration:4.6s;animation-delay:0.6s" },
  { icon: "star", tint: "bg-sun text-sun-ink", box: "h-14 w-14 rounded-2xl", size: "h-7 w-7", style: "top:10%;left:14%;--tilt:12deg;animation-duration:4.2s;animation-delay:1.1s" },
  { icon: "confetti", tint: "bg-mint text-mint-ink", box: "h-16 w-16 rounded-3xl", size: "h-8 w-8", style: "top:66%;left:72%;--tilt:6deg;animation-duration:6.3s;animation-delay:0.3s" },
];
---

<div class="pointer-events-none absolute inset-y-0 right-0 hidden w-2/5 select-none sm:block" aria-hidden="true">
  {
    TILES.map((tile) => (
      <span class:list={["float-soft absolute grid place-items-center shadow-soft", tile.tint, tile.box]} style={tile.style}>
        <Icon name={tile.icon} class={tile.size} />
      </span>
    ))
  }
</div>
