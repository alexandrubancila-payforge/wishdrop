---
/**
 * "Group gift" switch with the number of people (items.group_size). The
 * page reads `[data-group-toggle]` and `[data-group-size]` inside `#<id>`.
 */
import Icon from "@/components/Icon.astro";
import { makeT, type Lang } from "@/lib/i18n";
import gifts from "@/i18n/gifts";
import { GROUP_MAX, GROUP_MIN } from "@/lib/items";

interface Props {
  lang: Lang;
  id: string;
  size?: number | null;
}
const { lang, id, size = null } = Astro.props;
const t = makeT(lang, gifts);
---

<div id={id} class="mt-4 rounded-2xl border-[1.5px] border-line bg-white p-3">
  <label class="flex cursor-pointer items-center gap-3">
    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-mint text-mint-ink">
      <Icon name="users-three" class="h-5 w-5" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-bold text-ink">{t("group.title")}</span>
      <span class="mt-0.5 block text-xs leading-snug text-ink-soft">{t("group.text")}</span>
    </span>
    <input type="checkbox" data-group-toggle class="peer sr-only" checked={!!size} />
    <span class="relative h-6 w-11 shrink-0 rounded-full bg-ink-soft/30 transition after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow-soft after:transition peer-checked:bg-accent-600 peer-checked:after:translate-x-5 peer-focus-visible:ring-4 peer-focus-visible:ring-accent-500/20"></span>
  </label>
  <label class:list={["mt-3 flex items-center justify-between gap-3 border-t border-line pt-3", !size && "hidden"]} data-group-row>
    <span class="text-sm font-semibold text-ink">{t("group.people")}</span>
    <input type="number" data-group-size min={GROUP_MIN} max={GROUP_MAX} value={size ?? 4} inputmode="numeric" class="field !w-20 !py-2 text-center font-bold" />
  </label>
</div>

<script define:vars={{ id }}>
  const box = document.getElementById(id);
  const toggle = box.querySelector("[data-group-toggle]");
  toggle.addEventListener("change", () => box.querySelector("[data-group-row]").classList.toggle("hidden", !toggle.checked));
</script>
