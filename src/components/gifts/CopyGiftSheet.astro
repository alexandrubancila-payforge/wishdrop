---
/**
 * "Add it to your list too?" — opens after a signed-in visitor presses
 * "I want it too" (src/scripts/reactions.ts fires `wd:want`). Copies the gift
 * into one of their lists or a new one (POST /api/items/<id>/copy).
 * Rendered by Layout for signed-in users only.
 */
import Icon from "@/components/Icon.astro";
import { localePath, makeT, type Lang } from "@/lib/i18n";
import gifts from "@/i18n/gifts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = makeT(lang, gifts);
---

<div
  id="copy-sheet"
  class="fixed inset-0 z-50 hidden items-end justify-center bg-ink/40 p-0 backdrop-blur-sm sm:items-center sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="copy-title"
  data-done={t("copy.done")}
  data-fail={t("copy.fail")}
  data-new={t("copy.new")}
  data-dashboard={localePath(lang, "/dashboard")}
>
  <div class="card w-full max-w-md !rounded-b-none !rounded-t-3xl p-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))] shadow-lift sm:!rounded-3xl sm:pb-6">
    <div data-step="ask">
      <div class="flex items-start gap-4">
        <span class="relative h-16 w-16 shrink-0 overflow-hidden rounded-2xl bg-sun text-sun-ink">
          <img data-copy-img alt="" class="hidden h-full w-full object-cover" />
          <span data-copy-ph class="grid h-full w-full place-items-center"><Icon name="sparkle" weight="fill" class="h-7 w-7" /></span>
        </span>
        <div class="min-w-0">
          <h2 id="copy-title" class="text-xl font-extrabold tracking-tight">{t("copy.title")}</h2>
          <p class="mt-1 text-sm text-ink-soft">{t("copy.text")}</p>
        </div>
      </div>
      <label class="mt-5 block text-sm font-semibold text-ink" for="copy-list">{t("copy.list")}</label>
      <select id="copy-list" class="field mt-1"></select>
      <div data-copy-new class="mt-3 hidden">
        <label class="block text-sm font-semibold text-ink" for="copy-new-name">{t("copy.newLabel")}</label>
        <input id="copy-new-name" type="text" maxlength="60" value={t("copy.newName")} class="field mt-1" />
      </div>
      <p data-copy-error class="mt-3 hidden text-sm font-medium text-rose-600"></p>
      <div class="mt-6 flex flex-col gap-2.5">
        <button type="button" data-copy-add class="btn btn-primary w-full !py-3.5 text-sm">
          <Icon name="plus" weight="bold" class="h-4 w-4" />
          {t("copy.add")}
        </button>
        <button type="button" data-copy-close class="btn btn-ghost w-full !py-3 text-sm">{t("copy.skip")}</button>
      </div>
    </div>
    <div data-step="done" class="hidden text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-3xl bg-mint text-mint-ink">
        <Icon name="check-circle" class="h-8 w-8" />
      </span>
      <p data-copy-done class="mt-4 text-lg font-extrabold tracking-tight"></p>
      <div class="mt-6 flex flex-col gap-2.5">
        <a data-copy-view class="btn btn-primary w-full !py-3.5 text-sm">{t("copy.view")}</a>
        <button type="button" data-copy-close class="btn btn-ghost w-full !py-3 text-sm">{t("copy.close")}</button>
      </div>
    </div>
  </div>
</div>

<script>
  const sheet = document.getElementById("copy-sheet");
  if (sheet) {
    const select = sheet.querySelector<HTMLSelectElement>("#copy-list")!;
    const newBox = sheet.querySelector<HTMLElement>("[data-copy-new]")!;
    const newName = sheet.querySelector<HTMLInputElement>("#copy-new-name")!;
    const error = sheet.querySelector<HTMLElement>("[data-copy-error]")!;
    const add = sheet.querySelector<HTMLButtonElement>("[data-copy-add]")!;
    const img = sheet.querySelector<HTMLImageElement>("[data-copy-img]")!;
    const ph = sheet.querySelector<HTMLElement>("[data-copy-ph]")!;
    let itemId = "";
    let lists: { id: string; name: string }[] | null = null;

    const step = (name: "ask" | "done") =>
      sheet.querySelectorAll<HTMLElement>("[data-step]").forEach((s) => s.classList.toggle("hidden", s.dataset.step !== name));
    const close = () => {
      sheet.classList.add("hidden");
      sheet.classList.remove("flex");
    };
    const fillLists = () => {
      select.innerHTML = "";
      for (const l of lists ?? []) select.add(new Option(l.name, l.id));
      select.add(new Option(sheet.dataset.new!, "__new"));
      newBox.classList.toggle("hidden", select.value !== "__new");
    };

    window.addEventListener("wd:want", async (e) => {
      const detail = (e as CustomEvent<{ itemId: string; image?: string }>).detail;
      itemId = detail.itemId;
      error.classList.add("hidden");
      add.disabled = false;
      img.classList.toggle("hidden", !detail.image);
      ph.classList.toggle("hidden", !!detail.image);
      if (detail.image) img.src = detail.image;
      step("ask");
      sheet.classList.remove("hidden");
      sheet.classList.add("flex");
      if (!lists) {
        try {
          lists = (await (await fetch("/api/wishlists")).json()).lists ?? [];
        } catch {
          lists = [];
        }
      }
      fillLists();
    });
    select.addEventListener("change", () => newBox.classList.toggle("hidden", select.value !== "__new"));
    sheet.querySelectorAll("[data-copy-close]").forEach((b) => b.addEventListener("click", close));
    sheet.addEventListener("click", (e) => e.target === sheet && close());
    document.addEventListener("keydown", (e) => e.key === "Escape" && close());

    add.addEventListener("click", async () => {
      add.disabled = true;
      error.classList.add("hidden");
      const body = select.value === "__new" ? { new_list: newName.value.trim() } : { wishlist_id: select.value };
      try {
        const res = await fetch(`/api/items/${itemId}/copy`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        if (select.value === "__new") lists = [{ id: data.list.id, name: data.list.name }, ...(lists ?? [])];
        sheet.querySelector("[data-copy-done]")!.textContent = sheet.dataset.done!.replace("{list}", data.list.name);
        sheet.querySelector<HTMLAnchorElement>("[data-copy-view]")!.href = `${sheet.dataset.dashboard}/${data.list.id}`;
        step("done");
      } catch (err) {
        error.textContent = (err instanceof Error && err.message) || sheet.dataset.fail!;
        error.classList.remove("hidden");
        add.disabled = false;
      }
    });
  }
</script>
