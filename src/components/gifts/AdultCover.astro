---
/**
 * Over the photo of an 18+ gift (lib/adult.ts): a badge and a Show button.
 * Show asks "Are you over 18?" once (remembered in this browser), then every
 * 18+ gift on the page is shown (script in layouts/Layout.astro). The parent
 * carries the "adult-gift" class, which blurs its photo and name.
 */
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";

const t = makeT(Astro.locals.lang, common);
---

<span class="adult-cover absolute inset-0 z-[1] flex flex-col items-center justify-center gap-2 bg-ink/25 text-center" aria-label={t("adult.label")}>
  <span class="rounded-full bg-ink px-3 py-1 text-sm font-extrabold text-white">18+</span>
  <button type="button" data-adult-reveal data-confirm={t("adult.confirm")} data-ok={t("adult.yes")} data-title={t("adult.label")} class="rounded-full bg-white/95 px-3.5 py-1.5 text-xs font-bold text-ink shadow-soft transition hover:bg-white">
    {t("adult.show")}
  </button>
</span>
