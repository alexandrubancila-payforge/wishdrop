---
/**
 * The banner behind an avatar: the person's cover photo, or the soft brand
 * tint. With `editable` (your own banner) it gets a camera button that uploads
 * a new photo right away (through /api/upload, so the photo check applies)
 * and, when there is one, a button to remove it. Fills its parent.
 */
import Icon from "@/components/Icon.astro";
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";

interface Props {
  url: string | null | undefined;
  editable?: boolean;
  /** Spell out "Change cover photo" on the button (Settings) instead of only the camera. */
  labeled?: boolean;
  class?: string;
}
const { url, editable = false, labeled = false, class: cls } = Astro.props;
const t = makeT(Astro.locals.lang, common);
---

<div class:list={["cover-photo relative h-full w-full overflow-hidden bg-accent-100", cls]} data-cover>
  {url && <img src={url} alt="" class="h-full w-full object-cover" />}
  {
    editable && (
      <div class:list={["absolute right-2", labeled ? "top-2" : "bottom-2 cover-actions"]}>
        {url ? (
          // A cover is set: one button opens "Choose another photo" / "Remove cover photo".
          <details class="relative" data-cover-menu>
            <summary
              class:list={["cover-btn list-none [&::-webkit-details-marker]:hidden", labeled ? "px-3.5" : "w-8 !px-0"]}
              aria-label={t("cover.edit")}
              title={t("cover.edit")}
            >
              <Icon name={labeled ? "pencil-simple" : "camera"} class="h-4 w-4" />
              {labeled && <span>{t("cover.edit")}</span>}
            </summary>
            {/* Placed by the script with position: fixed, so the cover's rounded, clipped box can't cut it. */}
            <div data-cover-menu-panel class="fixed z-50 w-56 rounded-2xl border border-line bg-white p-1.5 text-sm shadow-lift">
              <label class="flex cursor-pointer items-center gap-2.5 rounded-xl px-2.5 py-2 font-semibold text-ink transition hover:bg-sand">
                <Icon name="image" class="h-[18px] w-[18px] text-accent-500" />
                {t("cover.replace")}
                <input type="file" accept="image/*" class="hidden" data-cover-input data-fail={t("cover.fail")} />
              </label>
              <button type="button" data-cover-remove class="flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left font-semibold text-rose-600 transition hover:bg-accent-50">
                <Icon name="trash" class="h-[18px] w-[18px]" />
                {t("cover.remove")}
              </button>
            </div>
          </details>
        ) : (
          // No cover yet: the button picks a photo right away.
          <label class:list={["cover-btn cursor-pointer", labeled ? "px-3.5" : "w-8 !px-0"]} aria-label={t("cover.add")} title={t("cover.add")}>
            <Icon name={labeled ? "image" : "camera"} class="h-4 w-4" />
            {labeled && <span>{t("cover.add")}</span>}
            <input type="file" accept="image/*" class="hidden" data-cover-input data-fail={t("cover.fail")} />
          </label>
        )}
      </div>
    )
  }
</div>

<script>
  // Upload: shrink to 1600px wide (WebP), store it, save it on the account, reload to show it everywhere.
  async function shrink(file: File) {
    try {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 1600 / bmp.width);
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(bmp.width * scale);
      canvas.height = Math.round(bmp.height * scale);
      canvas.getContext("2d")!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, "image/webp", 0.85));
      return blob && blob.size < file.size ? new File([blob], "cover.webp", { type: "image/webp" }) : file;
    } catch {
      return file;
    }
  }
  const save = (cover_url: string | null) =>
    fetch("/api/account/profile", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ cover_url }) });

  document.querySelectorAll<HTMLInputElement>("[data-cover-input]").forEach((input) => {
    input.addEventListener("change", async () => {
      const raw = input.files?.[0];
      if (!raw) return;
      const box = input.closest<HTMLElement>("[data-cover]")!;
      box.classList.add("animate-pulse");
      try {
        const fd = new FormData();
        fd.append("file", await shrink(raw));
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data.url) throw new Error(data.error);
        if (!(await save(String(data.url).split("?")[0])).ok) throw new Error();
        location.reload();
      } catch (e) {
        box.classList.remove("animate-pulse");
        alert((e instanceof Error && e.message) || input.dataset.fail);
      }
    });
  });
  // The cover menu opens under its button (fixed, so nothing clips it) and closes on a click outside or a scroll.
  document.querySelectorAll<HTMLDetailsElement>("[data-cover-menu]").forEach((d) =>
    d.addEventListener("toggle", () => {
      if (!d.open) return;
      const r = d.querySelector("summary")!.getBoundingClientRect();
      const panel = d.querySelector<HTMLElement>("[data-cover-menu-panel]")!;
      panel.style.top = `${r.bottom + 6}px`;
      panel.style.left = `${Math.max(8, r.right - panel.offsetWidth)}px`;
    }),
  );
  addEventListener("scroll", () => document.querySelectorAll<HTMLDetailsElement>("[data-cover-menu][open]").forEach((d) => (d.open = false)), { passive: true });
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>("[data-cover-menu][open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-cover-remove]").forEach((b) =>
    b.addEventListener("click", async () => {
      b.disabled = true;
      if ((await save(null)).ok) location.reload();
      else b.disabled = false;
    }),
  );
</script>
