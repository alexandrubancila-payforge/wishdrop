---
/** Body of /@username/followers and /@username/following (the pages check access first). */
import Layout from "@/layouts/Layout.astro";
import PersonRow from "./PersonRow.astro";
import FollowButton from "./FollowButton.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { db, type User } from "@/lib/db";
import { followersOf, followingOf, type Relation } from "@/lib/social";

interface Props {
  kind: "followers" | "following";
  /** Checked by the page (exists, has a username, viewer may see it). */
  owner: User & { username: string };
  rel: Relation;
}
const { kind, owner, rel } = Astro.props;
const { lang, user } = Astro.locals;
const t = makeT(lang, common, social);

const people = kind === "followers" ? await followersOf(owner.id) : await followingOf(owner.id);

// The viewer's own relation to each person, for their follow buttons.
const mine = new Map<string, Relation>();
if (user && people.length) {
  const { results } = await db()
    .prepare(`SELECT followee_id, status FROM follows WHERE follower_id = ? AND followee_id IN (${people.map(() => "?").join(",")})`)
    .bind(user.id, ...people.map((p) => p.id))
    .all<{ followee_id: string; status: string }>();
  for (const r of results) mine.set(r.followee_id, r.status === "accepted" ? "following" : "requested");
}
const relTo = (id: string): Relation => (user?.id === id ? "self" : (mine.get(id) ?? "none"));
const title = kind === "followers" ? t("people.followers") : t("people.following");
const canRemove = kind === "followers" && rel === "self";
---

<Layout title={`${title} · @${owner.username} — WishDrop`} noindex mainClass="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-10">
  <a href={localePath(lang, `/@${owner.username}`)} class="inline-flex items-center gap-1 text-sm font-semibold text-ink-soft hover:text-accent-700">
    <Icon name="caret-left" weight="bold" class="h-4 w-4" />
    {t("people.back").replace(/^←\s*/, "")}
  </a>
  <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
  <p class="mt-1 text-ink-soft">@{owner.username}</p>

  <nav class="mt-5 flex gap-6 border-b border-line">
    {
      (["followers", "following"] as const).map((k) => (
        <a
          href={localePath(lang, `/@${owner.username}/${k}`)}
          aria-current={k === kind ? "page" : undefined}
          class="tab"
        >
          {k === "followers" ? t("people.followers") : t("people.following")}
        </a>
      ))
    }
  </nav>

  {
    people.length === 0 ? (
      <div class="card mt-6 flex flex-col items-center px-6 py-10 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-3xl bg-lav text-lav-ink">
          <Icon name="users-three" class="h-8 w-8" />
        </span>
        <p class="mt-4 text-sm text-ink-soft">{t("people.empty")}</p>
      </div>
    ) : (
      <ul class="card mt-6 divide-y divide-line px-5">
        {people.map((p) => (
          <PersonRow person={p}>
            {canRemove ? (
              <button
                type="button"
                data-remove-follower={p.id}
                data-confirm={t("people.removeConfirm")}
                data-ok={t("people.removeOk")}
                class="btn btn-ghost !px-3.5 !py-2 text-xs"
              >
                {t("people.remove")}
              </button>
            ) : (
              p.username && <FollowButton username={p.username} relation={relTo(p.id)} isPrivate={!!p.is_private} size="sm" />
            )}
          </PersonRow>
        ))}
      </ul>
    )
  }

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-remove-follower]").forEach((b) => {
      b.addEventListener("click", async () => {
        const ok = await window.wdConfirm(b.dataset.confirm, b.dataset.ok);
        if (!ok) return;
        b.disabled = true;
        const res = await fetch("/api/follows/followers", {
          method: "DELETE",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ user_id: b.dataset.removeFollower }),
        });
        if (res.ok) b.closest("li")?.remove();
        else b.disabled = false;
      });
    });
  </script>
</Layout>
