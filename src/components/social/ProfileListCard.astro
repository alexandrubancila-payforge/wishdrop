---
/** A gift list on someone's profile: a 2×2 photo collage, name, gift count. Opens the public list. */
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { imageUrl } from "@/lib/storage";
import GiftArt from "@/components/gifts/GiftArt.astro";
import { isAdultGift } from "@/lib/adult";
import type { Cover } from "@/lib/db";
import { plural } from "@/components/dashboard/plural";

interface Props {
  list: { id: string; name: string; slug: string; item_count: number; covers: Cover[]; visibility: string };
  /** Show the visibility badge (only the owner needs it). */
  showVisibility?: boolean;
}
const { list, showVisibility = false } = Astro.props;
const { lang } = Astro.locals;
const t = makeT(lang, common, social);
const href = localePath(lang, `/w/${list.slug}`);
---

<li class="card group flex flex-col !rounded-3xl p-2 transition duration-200 hover:-translate-y-1 hover:shadow-lift" data-wishlist-id={list.id}>
  <a href={href} class="relative block aspect-square overflow-hidden rounded-2xl" aria-label={list.name}>
    {
      list.covers.length > 0 ? (
        <div
          class:list={[
            "grid h-full gap-0.5",
            list.covers.length === 1 && "grid-cols-1",
            list.covers.length === 2 && "grid-cols-2",
            list.covers.length >= 3 && "grid-cols-2 grid-rows-2",
          ]}
        >
          {list.covers.map((c, i) => (
            <div class:list={["relative overflow-hidden bg-sand", list.covers.length === 3 && i === 0 && "row-span-2", !showVisibility && isAdultGift(c) && "adult-gift"]}>
              {!showVisibility && isAdultGift(c) && <span class="adult-cover absolute inset-0 z-[1] grid place-items-center"><span class="rounded-full bg-ink px-2.5 py-0.5 text-xs font-extrabold text-white">18+</span></span>}
              {c.image_key ? (
                <img src={imageUrl(c.image_key)} alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.04]" />
              ) : (
                <GiftArt id={c.id} title={c.title} size={list.covers.length === 1 ? "lg" : "sm"} />
              )}
              {i === 3 && list.item_count > 4 && (
                <span class="absolute inset-0 grid place-items-center bg-ink/45 text-lg font-extrabold text-white">+{list.item_count - 4}</span>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="grid h-full place-items-center bg-accent-50 text-accent-500">
          <Icon name="gift" class="h-12 w-12 transition duration-300 group-hover:scale-110" />
        </div>
      )
    }
    {
      showVisibility && list.visibility === "followers" && (
        <span class="chip absolute left-2 top-2 bg-lav text-lav-ink shadow-soft">
          <Icon name="users" weight="bold" class="h-3.5 w-3.5" />
          {t("badge.followers")}
        </span>
      )
    }
  </a>
  <div class="min-w-0 px-2 pb-1.5 pt-3">
    <a href={href} title={list.name} class="block truncate font-extrabold leading-tight tracking-tight hover:text-accent-700">{list.name}</a>
    <span class="mt-0.5 block text-xs text-ink-soft">{plural(t, lang, "profile.gifts", list.item_count)}</span>
  </div>
</li>
