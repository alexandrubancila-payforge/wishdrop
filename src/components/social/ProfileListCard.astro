---
/** A gift list on someone's profile: cover photos, name, gift count. Opens the public list. */
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import social from "@/i18n/social";
import { imageUrl } from "@/lib/storage";
import { plural } from "@/components/dashboard/plural";

interface Props {
  list: { id: string; name: string; slug: string; item_count: number; covers: string[]; visibility: string };
  /** Show the visibility badge (only the owner needs it). */
  showVisibility?: boolean;
}
const { list, showVisibility = false } = Astro.props;
const { lang } = Astro.locals;
const t = makeT(lang, common, social);
const href = localePath(lang, `/w/${list.slug}`);
---

<li
  class="card group flex flex-col overflow-hidden transition duration-200 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(124,58,237,0.45)]"
  data-wishlist-id={list.id}
>
  <a href={href} class="relative block h-36 overflow-hidden" aria-label={list.name}>
    {
      list.covers.length > 0 ? (
        <div
          class:list={[
            "grid h-full gap-0.5",
            list.covers.length === 1 && "grid-cols-1",
            list.covers.length === 2 && "grid-cols-2",
            list.covers.length >= 3 && "grid-cols-2 grid-rows-2",
          ]}
        >
          {list.covers.map((key, i) => (
            <div class:list={["relative overflow-hidden", list.covers.length === 3 && i === 0 && "row-span-2"]}>
              <img src={imageUrl(key)} alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.04]" />
              {i === 3 && list.item_count > 4 && (
                <span class="absolute inset-0 grid place-items-center bg-gray-900/55 text-lg font-bold text-white">+{list.item_count - 4}</span>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="grid h-full place-items-center bg-gradient-to-br from-violet-100 via-fuchsia-50 to-amber-50 text-5xl">
          <span class="transition duration-300 group-hover:scale-110">🎁</span>
        </div>
      )
    }
    {
      showVisibility && list.visibility === "followers" && (
        <span class="absolute left-2 top-2 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-ink shadow-sm backdrop-blur">
          👥 {t("badge.followers")}
        </span>
      )
    }
  </a>
  <div class="card-divider"></div>
  <div class="flex items-center justify-between gap-3 p-5">
    <a href={href} title={list.name} class="min-w-0 truncate font-display text-xl font-bold leading-tight hover:text-accent-600">{list.name}</a>
    <span class="shrink-0 text-sm text-ink-soft">{plural(t, lang, "profile.gifts", list.item_count)}</span>
  </div>
</li>
