---
/**
 * Renders a guide, or the guides hub when `guide` is null (see lib/guides.ts).
 * The route files in src/pages/{idei,ideas,ideen}/ resolve the URL first
 * (redirects and 404 only work in pages).
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath } from "@/lib/i18n";
import { guideAlternates, guidePath, hubPath } from "@/lib/guides";
import { guides, guidesHub, type GuideDoc } from "@/i18n/guides";

interface Props {
  guide: GuideDoc | null;
}
const { lang, user } = Astro.locals;

const href = (p: string) => localePath(lang, p);
const hub = guidesHub[lang];
const { guide } = Astro.props;
const ctaHref = user ? href("/dashboard") + "#new" : href("/register");
const others = guides[lang].filter((g) => g.key !== guide?.key);
const TINTS = ["bg-accent-100 text-accent-600", "bg-lav text-lav-ink", "bg-sun text-sun-ink", "bg-mint text-mint-ink"];
const ICONS: Record<string, string> = { christmas: "tree-evergreen", wedding: "heart", birthday: "cake", baby: "balloon" };
const site = "https://wishdrop.site";

const jsonLd = guide
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          headline: guide.h1,
          description: guide.description,
          inLanguage: lang,
          publisher: { "@type": "Organization", name: "WishDrop", url: site },
          mainEntityOfPage: site + localePath(lang, guidePath(lang, guide.key)),
        },
        {
          "@type": "FAQPage",
          mainEntity: guide.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "WishDrop", item: site + localePath(lang, "/") },
            { "@type": "ListItem", position: 2, name: hub.h1, item: site + localePath(lang, hubPath(lang)) },
            { "@type": "ListItem", position: 3, name: guide.h1 },
          ],
        },
      ],
    }
  : undefined;
---

<Layout
  title={guide ? guide.title : hub.title}
  description={guide ? guide.description : hub.description}
  alternates={guideAlternates(guide ? guide.key : null)}
  jsonLd={jsonLd}
  mainClass="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12"
>
  {
    guide ? (
      <article>
        <nav class="text-sm font-semibold text-ink-soft">
          <a href={href(hubPath(lang))} class="hover:text-accent-700">← {hub.h1}</a>
        </nav>
        <header class="mt-4">
          <span class:list={["grid h-14 w-14 place-items-center rounded-2xl", TINTS[guides[lang].findIndex((g) => g.key === guide.key) % 4]]}>
            <Icon name={ICONS[guide.key]} class="h-7 w-7" />
          </span>
          <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">{guide.h1}</h1>
          <p class="mt-4 max-w-2xl text-lg text-ink-soft">{guide.intro}</p>
          <a href={ctaHref} class="btn btn-primary mt-6 !px-6 !py-3.5">
            <Icon name="plus" weight="bold" class="h-4 w-4" />
            {guide.cta}
          </a>
        </header>

        {
          guide.sections.map((sec) => (
            <section class="mt-12">
              <h2 class="text-2xl font-extrabold tracking-tight">{sec.h}</h2>
              {sec.p && <p class="mt-3 max-w-3xl leading-relaxed text-ink">{sec.p}</p>}
              {sec.ideas && (
                <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                  {sec.ideas.map((idea, i) => (
                    <li class="card flex gap-3 p-4">
                      <span class:list={["grid h-10 w-10 shrink-0 place-items-center rounded-xl", TINTS[i % 4]]}>
                        <Icon name="gift" class="h-5 w-5" />
                      </span>
                      <span class="min-w-0">
                        <span class="block font-bold">{idea.name}</span>
                        <span class="mt-0.5 block text-sm leading-snug text-ink-soft">{idea.text}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <section class="mt-12">
          <h2 class="text-2xl font-extrabold tracking-tight">FAQ</h2>
          <div class="card mt-4 divide-y divide-line px-5">
            {
              guide.faq.map((f) => (
                <details class="group py-4">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-bold [&::-webkit-details-marker]:hidden">
                    {f.q}
                    <Icon name="caret-down" weight="bold" class="h-4 w-4 shrink-0 text-ink-soft transition group-open:rotate-180" />
                  </summary>
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <section class="card mt-12 flex flex-col items-center bg-accent-50 p-8 text-center">
          <h2 class="text-2xl font-extrabold tracking-tight">{guide.cta}</h2>
          <a href={ctaHref} class="btn btn-primary mt-5 !px-6 !py-3.5">
            <Icon name="gift" class="h-4 w-4" />
            {guide.cta}
          </a>
        </section>

        <section class="mt-12">
          <h2 class="text-lg font-extrabold">{hub.h1}</h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-3">
            {others.map((g) => (
              <li>
                <a href={href(guidePath(lang, g.key))} class="card flex h-full items-center gap-3 p-4 font-bold transition hover:-translate-y-0.5 hover:shadow-lift">
                  <Icon name={ICONS[g.key]} class="h-5 w-5 shrink-0 text-accent-500" />
                  {g.h1}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>
    ) : (
      <section>
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{hub.h1}</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-soft">{hub.intro}</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {guides[lang].map((g, i) => (
            <li>
              <a href={href(guidePath(lang, g.key))} class="card flex h-full flex-col p-6 transition hover:-translate-y-1 hover:shadow-lift">
                <span class:list={["grid h-12 w-12 place-items-center rounded-2xl", TINTS[i % 4]]}>
                  <Icon name={ICONS[g.key]} class="h-6 w-6" />
                </span>
                <span class="mt-4 text-xl font-extrabold tracking-tight">{g.h1}</span>
                <span class="mt-2 text-sm text-ink-soft">{g.description}</span>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-accent-700">
                  {g.cta} <Icon name="caret-right" weight="bold" class="h-4 w-4" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
