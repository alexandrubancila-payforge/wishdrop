---
/**
 * Renders a guide, or the guides hub when `guide` is null (see lib/guides.ts).
 * The route files in src/pages/{idei,ideas,ideen}/ resolve the URL first
 * (redirects and 404 only work in pages).
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { localePath, makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import home from "@/i18n/home";
import { guideAlternates, guidePath, hubPath } from "@/lib/guides";
import { guides, guidesHub, type GuideDoc } from "@/i18n/guides";
import { giftIcon, giftTint } from "@/lib/gift-icon";

interface Props {
  guide: GuideDoc | null;
}
const { lang, user } = Astro.locals;

const href = (p: string) => localePath(lang, p);
const hub = guidesHub[lang];
const { guide } = Astro.props;
const ctaHref = user ? href("/dashboard") + "#new" : href("/register");
const others = guides[lang].filter((g) => g.key !== guide?.key);
const TINTS = ["bg-accent-100 text-accent-600", "bg-lav text-lav-ink", "bg-sun text-sun-ink", "bg-mint text-mint-ink"];
const ICONS: Record<string, string> = { christmas: "tree-evergreen", wedding: "heart", birthday: "cake", baby: "balloon" };
const site = "https://wishdrop.site";

const jsonLd = guide
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          headline: guide.h1,
          description: guide.description,
          image: `${site}/home/${guide.key}.jpg`,
          inLanguage: lang,
          publisher: { "@type": "Organization", name: "WishDrop", url: site },
          mainEntityOfPage: site + localePath(lang, guidePath(lang, guide.key)),
        },
        {
          "@type": "FAQPage",
          mainEntity: guide.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "WishDrop", item: site + localePath(lang, "/") },
            { "@type": "ListItem", position: 2, name: hub.h1, item: site + localePath(lang, hubPath(lang)) },
            { "@type": "ListItem", position: 3, name: guide.h1 },
          ],
        },
      ],
    }
  : undefined;
const ht = makeT(lang, common, home);
---

<Layout
  title={guide ? guide.title : hub.title}
  description={guide ? guide.description : hub.description}
  alternates={guideAlternates(guide ? guide.key : null)}
  jsonLd={jsonLd}
  ogType={guide ? "article" : "website"}
  mainClass="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12"
>
  {
    guide ? (
      <article>
        <nav class="text-sm font-semibold text-ink-soft">
          <a href={href(hubPath(lang))} class="inline-flex items-center gap-1 hover:text-accent-700">
            <Icon name="arrow-left" weight="bold" class="h-3.5 w-3.5" />
            {hub.h1}
          </a>
        </nav>

        {/* Hero: the words left, the occasion's photo right (on top on phones). */}
        <header class="mt-5 grid items-center gap-8 md:grid-cols-[1.1fr_1fr]">
          <div class="order-2 md:order-1">
            <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{guide.h1}</h1>
            <p class="mt-4 text-lg leading-relaxed text-ink-soft">{guide.intro}</p>
            <a href={ctaHref} class="btn btn-primary mt-6 !px-6 !py-3.5">
              <Icon name="plus" weight="bold" class="h-4 w-4" />
              {guide.cta}
            </a>
          </div>
          <div class="relative order-1 md:order-2">
            <picture>
              <source srcset={`/home/${guide.key}.webp`} type="image/webp" />
              <img src={`/home/${guide.key}.jpg`} alt={guide.h1} width="800" height="600" class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-lift" />
            </picture>
            <span class="absolute -bottom-4 -left-3 grid h-14 w-14 -rotate-6 place-items-center rounded-2xl bg-white text-accent-500 shadow-lift" aria-hidden="true">
              <Icon name="gift" weight="fill" class="h-7 w-7" />
            </span>
          </div>
        </header>

        {
          guide.sections.map((sec) => (
            <section class="mt-14">
              <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{sec.h}</h2>
              {sec.p && <p class="mt-3 max-w-3xl leading-relaxed text-ink">{sec.p}</p>}
              {sec.ideas && (
                <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {sec.ideas.map((idea) => (
                    <li class="card group flex gap-3.5 p-4 transition hover:-translate-y-0.5 hover:shadow-lift">
                      <span class:list={["grid h-12 w-12 shrink-0 place-items-center rounded-2xl transition group-hover:scale-105", giftTint(idea.name)]}>
                        <Icon name={giftIcon(idea.name)} class="h-6 w-6" />
                      </span>
                      <span class="min-w-0">
                        <span class="block font-bold leading-snug">{idea.name}</span>
                        <span class="mt-1 block text-sm leading-snug text-ink-soft">{idea.text}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <section class="mt-14">
          <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">FAQ</h2>
          <div class="card mt-5 divide-y divide-line px-5">
            {
              guide.faq.map((f) => (
                <details class="group py-4">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-bold [&::-webkit-details-marker]:hidden">
                    {f.q}
                    <Icon name="caret-down" weight="bold" class="h-4 w-4 shrink-0 text-ink-soft transition group-open:rotate-180" />
                  </summary>
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        {/* Closing band: the same coral call to action as the home page. */}
        <section class="relative mt-14 overflow-hidden rounded-[2rem] bg-gradient-to-br from-accent-500 to-accent-700 px-6 py-10 text-center text-white shadow-coral sm:py-12">
          <Icon name={ICONS[guide.key]} class="pointer-events-none absolute -left-4 -top-4 h-28 w-28 -rotate-12 text-white/10" />
          <Icon name="heart" class="pointer-events-none absolute -bottom-5 -right-3 h-24 w-24 rotate-12 text-white/10" />
          <h2 class="relative mx-auto max-w-xl text-2xl font-extrabold tracking-tight sm:text-3xl">{ht("home.ctaTitle")}</h2>
          <p class="relative mx-auto mt-2 max-w-md text-white/85">{ht("home.ctaText")}</p>
          <a href={ctaHref} class="btn relative mt-6 bg-white !px-6 !py-3.5 text-accent-700 hover:bg-accent-50">
            <Icon name="gift" class="h-4 w-4" />
            {guide.cta}
          </a>
        </section>

        <section class="mt-14">
          <h2 class="text-lg font-extrabold">{hub.h1}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-3">
            {others.map((g) => (
              <li>
                <a href={href(guidePath(lang, g.key))} class="group relative block aspect-[2/1] overflow-hidden rounded-2xl shadow-soft sm:aspect-[4/3]">
                  <picture>
                    <source srcset={`/home/${g.key}.webp`} type="image/webp" />
                    <img src={`/home/${g.key}.jpg`} alt="" loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                  </picture>
                  <span class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></span>
                  <span class="absolute inset-x-0 bottom-0 flex items-center gap-1.5 p-3 font-extrabold leading-tight text-white">
                    <Icon name={ICONS[g.key]} weight="fill" class="h-4 w-4 shrink-0" />
                    {g.h1}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>
    ) : (
      <section>
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{hub.h1}</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-soft">{hub.intro}</p>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2">
          {guides[lang].map((g, i) => (
            <li>
              <a href={href(guidePath(lang, g.key))} class="card group flex h-full flex-col overflow-hidden !p-0 transition hover:-translate-y-1 hover:shadow-lift">
                <span class="relative block aspect-[16/9] overflow-hidden">
                  <picture>
                    <source srcset={`/home/${g.key}.webp`} type="image/webp" />
                    <img src={`/home/${g.key}.jpg`} alt="" loading={i < 2 ? "eager" : "lazy"} width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                  </picture>
                  <span class:list={["absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-2xl shadow-soft", TINTS[i % 4]]}>
                    <Icon name={ICONS[g.key]} weight="fill" class="h-5 w-5" />
                  </span>
                </span>
                <span class="flex flex-1 flex-col p-5">
                  <span class="text-xl font-extrabold tracking-tight">{g.h1}</span>
                  <span class="mt-2 text-sm text-ink-soft">{g.description}</span>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-accent-700">
                    {g.cta} <Icon name="arrow-right" weight="bold" class="h-4 w-4 transition group-hover:translate-x-0.5" />
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
