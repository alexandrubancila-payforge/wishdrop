---
/**
 * A styled confirm() for destructive actions. In page scripts:
 *   const ok = await window.wdConfirm("Delete this gift?", "Delete");
 * Other questions can set their own title and a text badge instead of the trash icon:
 *   await window.wdConfirm("Are you over 18?", "Yes", { title: "Adult content", badge: "18+" });
 */
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import Icon from "./Icon.astro";

const t = makeT(Astro.locals.lang, common);
---

<div
  id="confirm-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/40 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="confirm-title"
>
  <div class="card w-full max-w-sm p-6 text-center" data-confirm-panel>
    <div id="confirm-icon" class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-accent-100 text-xl font-extrabold text-accent-600">
      <Icon name="trash" class="h-7 w-7" />
    </div>
    <h2 id="confirm-title" class="mt-4 text-xl font-extrabold tracking-tight">{t("confirm.title")}</h2>
    <p id="confirm-message" class="mt-1 text-sm text-ink-soft"></p>
    <div class="mt-6 flex gap-3">
      <button id="confirm-cancel" class="btn btn-ghost flex-1 !py-3 text-sm" type="button">{t("confirm.cancel")}</button>
      <button
        id="confirm-ok"
        class="btn btn-primary flex-1 !py-3 text-sm"
        type="button"
        data-default-label={t("confirm.ok")}
      >
        {t("confirm.ok")}
      </button>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      wdConfirm: (message?: string, okLabel?: string, opts?: { title?: string; badge?: string }) => Promise<boolean>;
    }
  }

  const modal = document.getElementById("confirm-modal");
  const message = document.getElementById("confirm-message");
  const ok = document.getElementById("confirm-ok");
  const cancel = document.getElementById("confirm-cancel");
  const defaultLabel = ok?.dataset.defaultLabel || "OK";
  const titleEl = document.getElementById("confirm-title");
  const iconEl = document.getElementById("confirm-icon");
  const defaultTitle = titleEl?.textContent ?? "";
  const defaultIcon = iconEl?.innerHTML ?? "";
  let resolve: ((v: boolean) => void) | null = null;

  function finish(result: boolean) {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    const r = resolve;
    resolve = null;
    r?.(result);
  }

  window.wdConfirm = (text = "", okLabel, opts = {}) => {
    if (message) message.textContent = text;
    if (titleEl) titleEl.textContent = opts.title || defaultTitle;
    if (iconEl) {
      if (opts.badge) iconEl.textContent = opts.badge;
      else iconEl.innerHTML = defaultIcon;
    }
    if (ok) ok.textContent = okLabel || defaultLabel;
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    ok?.focus();
    return new Promise((r) => (resolve = r));
  };

  ok?.addEventListener("click", () => finish(true));
  cancel?.addEventListener("click", () => finish(false));
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) finish(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) finish(false);
  });
</script>
