---
import Icon from "@/components/Icon.astro";
/**
 * The cookie question for Google Ads measurement. Shown until the visitor
 * picks Accept or Decline (kept in localStorage `wd_consent`); the footer's
 * "Cookies" link ([data-cookie-settings]) shows it again. Accept loads Google
 * Tag Manager through window.wdLoadGtm (defined in Layout's <head>).
 */
import { localePath, makeT, type Lang } from "@/lib/i18n";
import common from "@/i18n/common";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = makeT(lang, common);
---

<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label={t("footer.cookies")}
  class="cookie-banner fixed inset-x-3 z-50 mx-auto hidden max-w-xl rounded-3xl border border-sand bg-white p-4 shadow-xl sm:inset-x-auto sm:right-6 sm:left-6 sm:p-5"
>
  <p class="text-sm leading-relaxed text-ink">
    <Icon name="cookie" class="mr-1 inline h-4 w-4 -translate-y-px text-accent-600" />
    {t("cookie.text")}{" "}
    <a href={localePath(lang, "/privacy")} class="font-semibold text-accent-700 underline">{t("cookie.more")}</a>
  </p>
  <div class="mt-3 flex gap-2">
    <button type="button" data-consent="denied" class="btn btn-soft flex-1 !py-2.5 text-sm">{t("cookie.reject")}</button>
    <button type="button" data-consent="granted" class="btn btn-primary flex-1 !py-2.5 text-sm">{t("cookie.accept")}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;
    var choice = null;
    try {
      choice = localStorage.getItem("wd_consent");
    } catch (e) {}

    function readCookie(name) {
      var m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
      return m ? decodeURIComponent(m[1]) : null;
    }
    // A new account from this browser: tell GTM once (it counts as the Google Ads conversion).
    function reportSignup(consent) {
      var method = readCookie("wd_signup");
      if (!method || consent === null) return;
      if (consent === "granted") window.dataLayer.push({ event: "sign_up", method: method });
      document.cookie = "wd_signup=; path=/; max-age=0; samesite=lax";
    }

    function decide(value) {
      try {
        localStorage.setItem("wd_consent", value);
      } catch (e) {}
      banner.classList.add("hidden");
      if (value === "granted") window.wdLoadGtm();
      else window.wdDenyGtm();
      reportSignup(value);
    }

    banner.querySelectorAll("[data-consent]").forEach(function (b) {
      b.addEventListener("click", function () {
        decide(b.getAttribute("data-consent"));
      });
    });
    document.querySelectorAll("[data-cookie-settings]").forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        banner.classList.remove("hidden");
      });
    });

    if (choice === "granted" || choice === "denied") reportSignup(choice);
    else banner.classList.remove("hidden");
  })();
</script>

<style>
  .cookie-banner {
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
  }
  @media (max-width: 639px) {
    :global(body.has-tabbar) .cookie-banner {
      bottom: calc(5.25rem + env(safe-area-inset-bottom));
    }
  }
</style>
