---
/**
 * Phosphor icons (duotone by default: a soft tinted fill under the outline,
 * which suits the Pastel style). The set is in src/lib/icons.gen.ts; add more
 * names in scripts/build-icons.mjs.
 *
 *   <Icon name="gift" class="h-5 w-5 text-accent-500" />
 *   <Icon name="heart" weight="fill" />
 */
import { ICONS, type IconWeight } from "@/lib/icons.gen";

/** Names used before the redesign, mapped to their Phosphor equivalents. */
const ALIASES: Record<string, string> = {
  globe: "globe-hemisphere-east",
  chevronDown: "caret-down",
  settings: "gear",
  logout: "sign-out",
  login: "sign-in",
  home: "house",
  search: "magnifying-glass",
  list: "list-heart",
};

interface Props {
  name: string;
  class?: string;
  weight?: IconWeight;
  /** Accessible name; without one the icon is decorative (aria-hidden). */
  label?: string;
  /** Kept for the pre-redesign call sites; Phosphor icons have a fixed stroke. */
  strokeWidth?: number;
}

const { name, class: className = "h-5 w-5", weight = "duotone", label } = Astro.props;
const key = ALIASES[name] ?? name;
const icon = ICONS[key];
if (!icon) throw new Error(`Unknown icon "${name}". Add it to scripts/build-icons.mjs and run it.`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  fill="currentColor"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={icon[weight]}
/>
