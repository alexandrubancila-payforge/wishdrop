---
/** "Support WishDrop": a QR code for an instant MIA payment (Moldova). Opened by any [data-donate-open]. */
import { makeT } from "@/lib/i18n";
import common from "@/i18n/common";
import Icon from "./Icon.astro";

const t = makeT(Astro.locals.lang, common);
const MIA_URL = "https://mia-qr.bnm.md/1/m/BNM/AGR0f0d3fcca2514e61a4e3d07748d2513c";
---

<div
  id="donate-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/40 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="donate-title"
  data-mia-url={MIA_URL}
>
  <div class="card w-full max-w-sm p-6 text-center">
    <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-accent-100 text-accent-600" aria-hidden="true">
      <Icon name="heart" weight="fill" class="h-7 w-7" />
    </span>
    <h2 id="donate-title" class="mt-4 text-2xl font-extrabold tracking-tight">{t("donate.title")}</h2>
    <p class="mt-1 text-sm text-ink-soft">{t("donate.text")}</p>
    <div class="mt-5 flex justify-center">
      <div class="rounded-2xl bg-white p-3 shadow-soft ring-1 ring-line">
        <canvas data-qr width="180" height="180" class="block h-[180px] w-[180px]"></canvas>
      </div>
    </div>
    <p class="mt-3 flex items-center justify-center gap-1.5 text-xs text-ink-soft">
      <Icon name="qr-code" class="h-4 w-4" />{t("donate.scan")}
    </p>
    <a href={MIA_URL} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full py-3.5">
      {t("donate.open")}
      <Icon name="arrow-square-out" class="h-4 w-4" />
    </a>
    <button data-copy-link data-label={t("donate.copy")} data-copied={t("donate.copied")} class="btn btn-ghost mt-2 w-full py-3 text-sm">
      {t("donate.copy")}
    </button>
    <p class="mt-4 text-xs text-ink-soft">{t("donate.mia")}</p>
    <button data-donate-close class="mt-3 text-sm font-semibold text-ink-soft transition hover:text-ink">{t("donate.close")}</button>
  </div>
</div>

<script>
  const modal = document.getElementById("donate-modal");
  if (modal) {
    const url = modal.dataset.miaUrl!;
    const canvas = modal.querySelector<HTMLCanvasElement>("[data-qr]");
    let drawn = false;

    // The QR library loads only when someone opens the modal.
    async function drawQr() {
      if (drawn || !canvas) return;
      try {
        const QRCode = (await import("qrcode")).default;
        await QRCode.toCanvas(canvas, url, { width: 180, margin: 1, color: { dark: "#2b2433", light: "#ffffff" } });
        drawn = true;
      } catch {}
    }
    const open = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      drawQr();
    };
    const close = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    };

    document.querySelectorAll("[data-donate-open]").forEach((b) =>
      b.addEventListener("click", (e) => {
        e.preventDefault();
        open();
      }),
    );
    modal.querySelectorAll("[data-donate-close]").forEach((b) => b.addEventListener("click", close));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) close();
    });

    const copy = modal.querySelector<HTMLButtonElement>("[data-copy-link]");
    copy?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {}
      const label = copy.dataset.label || copy.textContent;
      copy.textContent = copy.dataset.copied || "✓";
      setTimeout(() => (copy.textContent = label), 1500);
    });
  }
</script>
