{
  "$schema": "node_modules/wrangler/config-schema.json",
  // WishDrop — Astro (SSR) on a Cloudflare Worker.
  // Bindings are the same Cloudflare resources the old Pages project used, so
  // every user, list, gift and photo stays where it is.
  "name": "wishdrop",
  // src/worker.ts = Astro's handler + the daily cron (photo backup).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // The live domain. Cloudflare creates the DNS record; remove this line to hand the domain back.
  // www gets its own DNS record and certificate from Cloudflare; the middleware sends it to the bare domain (301).
  "routes": [
    { "pattern": "wishdrop.site", "custom_domain": true },
    { "pattern": "www.wishdrop.site", "custom_domain": true }
  ],
  "workers_dev": true,
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://wishdrop.site",
    "CF_ACCOUNT_ID": "302e8d2b3de7b2c06581cf32860e4c53",
    "MAIL_FROM": "WishDrop <noreply@wishdrop.site>",
    "REQUIRE_EMAIL_VERIFICATION": "true",
    // Web Push public key (lib/push.ts); the private one is the VAPID_PRIVATE_JWK secret.
    "VAPID_PUBLIC_KEY": "BEMBwAoECfR3VvS_xpu6ZaWpqAdYJ_9y0I6pljmA0EZvpNIgx94briSNOJc3AdsQOSUhtOaHVVuBCxeB8GtUzxM"
  },
  // Astro sessions (kept from the old project).
  "kv_namespaces": [{ "binding": "SESSION", "id": "6057ce6d44d24ea4bf62e3837a8c986a" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishdrop-db",
      "database_id": "24e88cb9-5dd7-4051-bfd2-d99e46b3ee6d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "wishdrop-images" },
    // Daily copy of the photos (lib/backup.ts).
    { "binding": "BACKUP_BUCKET", "bucket_name": "wishdrop-images-backup" }
  ],
  // Workers AI: the automatic photo check (lib/moderation.ts).
  "ai": { "binding": "AI" },
  // Every day at 07:00 UTC (morning in Europe): reminder emails, photo backup, cleanups (src/worker.ts).
  "triggers": { "crons": ["0 7 * * *"] },
  // Broad per-minute brake on API writes (lib/limits.ts; the strict limits count in D1).
  // namespace_id is any number unique to this account.
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "4104", "simple": { "limit": 120, "period": 60 } }]
  // Secrets (wrangler secret put …): JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CF_EMAIL_TOKEN,
  // OWNER_EMAIL (where the contact form is delivered; also the /admin account), VAPID_PRIVATE_JWK
}
