# Copy to .dev.vars for local development.
JWT_SECRET=change-me-local-only-32-characters-min
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty locally: emails are printed to the console instead of sent.
CF_EMAIL_TOKEN=
# Where the contact form goes (a secret in production).
OWNER_EMAIL=you@example.com
# Web Push keys (node scripts/vapid-keys.mjs). The public key is also a var in wrangler.jsonc.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=

# Unconfirmed accounts are left out of search (wrangler.jsonc sets "true" for the live site).
REQUIRE_EMAIL_VERIFICATION=false
